<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Portal · Infinite Trading</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet" />
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css?v=20260927fixscroll" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#131a22" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Infinite Trading" />
  <link rel="apple-touch-icon" href="/images/app-icon.jpg" />
</head>

<body class="admin-terminal-body">
  <!-- Animated ambient background mesh orbs -->
  <div class="orbs" aria-hidden="true">
    <span class="orb-1"></span>
    <span class="orb-2"></span>
    <span class="orb-3"></span>
  </div>

  <!-- Mobile Drawer Backdrop Overlay -->
  <div class="dash-sidebar-backdrop" id="adminSidebarBackdrop"></div>

  <div class="admin-terminal-layout">
    <!-- 1. FULL-HEIGHT ADMIN LEFT SIDEBAR (Desktop: Sticky / Mobile: Sliding Drawer) -->
    <aside class="admin-sidebar" id="adminSidebar">
      <!-- Mobile Close Button -->
      <button type="button" class="dash-sidebar-close" id="adminSidebarClose" aria-label="Close Sidebar">✕</button>

      <!-- Brand Logo at Top of Sidebar -->
      <div class="admin-sidebar-brand">
        <a href="/admin.html" style="display:inline-flex;align-items:center;text-decoration:none;">
          <img src="/images/site-logo.png" alt="Infinite Trading" class="brand-logo" />
        </a>
        <div class="admin-brand-text">
          <span class="admin-brand-title">ADMIN PANEL</span>
        </div>
      </div>

      <!-- Navigation Tabs Menu Items -->
      <div class="admin-sidebar-menu">
        <button type="button" class="admin-nav-item active" data-nav-target="viewHome">
          <span class="admin-nav-icon">🏠</span>
          <span>Home / KPIs</span>
        </button>

        <button type="button" class="admin-nav-item" data-nav-target="viewMembers">
          <span class="admin-nav-icon">👥</span>
          <span>Member List</span>
          <span class="admin-nav-badge" id="badgeNavMembers" style="display:none;"></span>
        </button>

        <button type="button" class="admin-nav-item" data-nav-target="viewVault">
          <span class="admin-nav-icon">🔒</span>
          <span>Code Vault</span>
          <span class="admin-nav-badge" id="badgeNavCodes" style="display:none;"></span>
        </button>

        <button type="button" class="admin-nav-item" data-nav-target="viewTradein">
          <span class="admin-nav-icon">📈</span>
          <span>Trade-In Deposit</span>
          <span class="admin-nav-badge" id="badgeNavTradein" style="display:none;"></span>
        </button>

        <button type="button" class="admin-nav-item" data-nav-target="viewWithdrawals">
          <span class="admin-nav-icon">💳</span>
          <span>Withdrawals</span>
          <span class="admin-nav-badge" id="badgeNavWd" style="display:none;"></span>
        </button>

        <button type="button" class="admin-nav-item" data-nav-target="viewEarningsHistory">
          <span class="admin-nav-icon">📊</span>
          <span>Earnings Audit</span>
        </button>

        <button type="button" class="admin-nav-item" data-nav-target="viewMop">
          <span class="admin-nav-icon">📲</span>
          <span>Official MOP</span>
          <span class="admin-nav-badge" id="badgeNavMop" style="display:none;"></span>
        </button>

        <button type="button" class="admin-nav-item" data-nav-target="viewLoadWallet">
          <span class="admin-nav-icon">📱</span>
          <span>Load Wallet</span>
          <span class="admin-nav-badge" id="badgeNavLoadWallet" style="display:none;"></span>
        </button>

        <button type="button" class="admin-nav-item" data-nav-target="viewSettings">
          <span class="admin-nav-icon">⚙️</span>
          <span>System Settings</span>
        </button>
      </div>

      <!-- Admin Referral Link Card in Sidebar -->
      <div class="admin-side-ref-box" id="adminSideRefCard">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
          <p class="tiny"
            style="margin:0;font-weight:700;color:var(--jade);letter-spacing:0.04em;text-transform:uppercase;font-size:10px;">
            ADMIN REFERRAL LINK</p>
          <span
            style="font-size:9.5px;background:rgba(46,213,158,0.18);color:var(--jade);border:1px solid rgba(46,213,158,0.4);padding:1px 6px;border-radius:4px;font-weight:700;">ROOT</span>
        </div>
        <div style="display:flex;gap:6px;margin-top:6px;">
          <input id="adminSideRefLink" class="in"
            style="font-size:11px;padding:8px 10px;flex:1;min-width:0;font-weight:600;"
            readonly value="Loading..." />
          <button id="copyAdminSideRef" type="button" class="btn btn-ghost btn-sm"
            style="padding:6px 12px;font-size:11px;white-space:nowrap;">Copy</button>
        </div>
      </div>

      <!-- Sidebar Footer -->
      <div class="admin-sidebar-footer">
        <button type="button" id="logoutSideBtn" class="admin-side-logout-btn" title="Sign Out" aria-label="Sign Out">
          <span>Sign Out</span>
          <svg class="logout-icon-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-left:6px;"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>
        </button>
      </div>
    </aside>

    <!-- 2. MAIN RIGHT ADMIN AREA -->
    <div class="admin-main-area">
      <!-- Top Navigation Header -->
      <header class="admin-top-bar">
        <div class="admin-top-left">
          <!-- Mobile Hamburger Toggle Button -->
          <button type="button" class="dash-burger-btn" id="adminBurgerToggle" aria-label="Open Navigation Menu">
            <span></span>
            <span></span>
            <span></span>
          </button>
          <!-- Mobile Header Brand Logo -->
          <div class="dash-top-brand">
            <a href="/admin.html">
              <img src="/images/site-logo.png" alt="Infinite Trading" class="top-brand-logo" />
            </a>
          </div>
          <!-- Live Breadcrumb Tag -->
          <span class="admin-top-tag" id="currentViewTag">HOME OVERVIEW</span>
        </div>

        <div class="admin-top-right">
          <button class="btn-theme-toggle" type="button" data-theme-toggle aria-label="Toggle Light/Dark Theme" title="Toggle Light/Dark Theme">
            <span class="theme-toggle-icon">☀️</span>
            <span class="theme-toggle-text">Light</span>
          </button>
          <div class="user-badge">
            <span class="user-status-dot" id="systemStatusDot"></span>
            <span style="font-size:11.5px;font-weight:700;color:var(--jade);">System Live</span>
          </div>
          <button id="togglePayoutsTopBtn" class="btn btn-sm btn-ghost"
            style="font-size:11px;padding:6px 12px;">Payouts: Loading...</button>
          <button id="logoutTopBtn" class="dash-logout-btn" title="Sign out" aria-label="Sign out">
            <span>Sign out</span>
            <svg class="logout-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>
          </button>
        </div>
      </header>

      <!-- Scrollable Inner Content -->
      <div class="admin-content-inner">
        <div id="msg" class="banner"></div>

        <!-- =========================================================
             VIEW 1: HOME (5 KPI CARDS IN 2 ROWS + WALLET TOTALS)
             ========================================================= -->
        <section class="admin-view-panel active" id="viewHome">
          <div class="admin-sec-head">
            <div>
              <h2 class="admin-sec-title">HOME</h2>
              <p class="admin-sec-sub">OVERVIEW · 5 CORE METRIC INDICATORS</p>
            </div>
            <div class="tiny muted" id="lastUpdatedText">Synced</div>
          </div>

          <!-- 8 Metric Cards Grid -->
          <div class="admin-kpi-grid">
            <!-- 1. TOTAL TRADE-IN DEPOSIT -->
            <div class="admin-card">
              <div>
                <p class="kpi-label">TOTAL TRADE-IN DEPOSIT</p>
                <p class="kpi-val" id="kpiTradeinDeposit">₱0.00</p>
                <p class="kpi-sub" id="kpiTradeinCount">0 Active accounts</p>
              </div>
              <div class="kpi-icon">💰</div>
            </div>

            <!-- 2. TOTAL TRADE-IN REF -->
            <div class="admin-card gold">
              <div>
                <p class="kpi-label">TOTAL TRADE-IN REF</p>
                <p class="kpi-val" id="kpiTradeinRef">₱0.00</p>
                <p class="kpi-sub">Referral commission pool</p>
              </div>
              <div class="kpi-icon">👥</div>
            </div>

            <!-- 3. TOTAL CODE -->
            <div class="admin-card mint">
              <div>
                <p class="kpi-label">TOTAL CODE</p>
                <p class="kpi-val" id="kpiTotalCode">0</p>
                <p class="kpi-sub" id="kpiAvailableCodes">0 Available in vault</p>
              </div>
              <div class="kpi-icon">🔐</div>
            </div>

            <!-- 4. TOTAL CODE BUY -->
            <div class="admin-card">
              <div>
                <p class="kpi-label">TOTAL CODE BUY</p>
                <p class="kpi-val" id="kpiTotalCodeBuy">0</p>
                <p class="kpi-sub">Assigned &amp; activated codes</p>
              </div>
              <div class="kpi-icon">🏷️</div>
            </div>

            <!-- 5. TOTAL BINARY -->
            <div class="admin-card">
              <div>
                <p class="kpi-label">TOTAL BINARY</p>
                <p class="kpi-val" id="kpiTotalBinary">₱0.00</p>
                <p class="kpi-sub">Network match earnings</p>
              </div>
              <div class="kpi-icon">📈</div>
            </div>

            <!-- 6. TOTAL CASHOUT -->
            <div class="admin-card mint" style="border:1.5px solid var(--jade);cursor:pointer;" id="cardKpiTotalCashout" title="Click to view approved cashouts">
              <div>
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;flex-wrap:wrap;">
                  <p class="kpi-label" style="color:var(--jade);margin:0;">TOTAL CASHOUT (RELEASED)</p>
                  <span class="badge-tag tag-approved" style="font-size:9.5px;padding:1px 6px;">Net Disbursed</span>
                </div>
                <p class="kpi-val" id="kpiTotalCashout" style="color:var(--jade);">₱0.00</p>
                <p class="kpi-sub" id="kpiTotalCashoutSub">0 Completed releases</p>
              </div>
              <div class="kpi-icon" style="font-size:24px;">💸</div>
            </div>

            <!-- 7. PENDING CASHOUT -->
            <div class="admin-card gold" style="border:1.5px solid var(--gold);cursor:pointer;" id="cardKpiPendingCashout" title="Click to review pending cashouts">
              <div>
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;flex-wrap:wrap;">
                  <p class="kpi-label" style="color:var(--gold);margin:0;">PENDING CASHOUT</p>
                  <span class="badge-tag tag-expired" id="badgeKpiPendingWd" style="font-size:9.5px;padding:1px 6px;">0 Pending</span>
                </div>
                <p class="kpi-val" id="kpiPendingCashout" style="color:var(--gold);">₱0.00</p>
                <p class="kpi-sub" id="kpiPendingCashoutSub">0 Pending review</p>
              </div>
              <div class="kpi-icon" style="font-size:24px;">⏳</div>
            </div>

            <!-- 8. PENDING LOAD WALLET -->
            <div class="admin-card" style="border:1.5px solid var(--accent-mint);cursor:pointer;" id="cardKpiPendingLoad" title="Click to review load wallet orders">
              <div>
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;flex-wrap:wrap;">
                  <p class="kpi-label" style="color:var(--accent-mint);margin:0;">BUY LOAD WALLET REQUESTS</p>
                  <span class="badge-tag tag-expired" id="badgeKpiPendingLoad" style="font-size:9.5px;padding:1px 6px;">0 Pending</span>
                </div>
                <p class="kpi-val" id="kpiPendingLoad" style="color:var(--accent-mint);">0</p>
                <p class="kpi-sub" id="kpiPendingLoadSub">Retailer wallet orders</p>
              </div>
              <div class="kpi-icon" style="font-size:24px;">📱</div>
            </div>
          </div>

          <!-- System Wallet Totals Bar -->
          <div class="wallet-totals-bar" style="margin-top:20px;">
            <div class="wt-card">
              <p class="wt-card-label">System · Binary Ref Balance</p>
              <p class="wt-card-val" id="sysBinaryRef">₱0.00</p>
            </div>
            <div class="wt-card">
              <p class="wt-card-label">System · Trade-In Ref Balance</p>
              <p class="wt-card-val" id="sysTradeRef">₱0.00</p>
            </div>
            <div class="wt-card">
              <p class="wt-card-label">System · Trade-In Cycle Balance</p>
              <p class="wt-card-val" id="sysCycle">₱0.00</p>
            </div>
          </div>

          <!-- Admin Home: Quick Pending Approvals Action Center -->
          <div class="admin-card" style="margin-top:20px;grid-column:1/-1;">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:14px;border-bottom:1px solid rgba(15,122,69,0.12);padding-bottom:10px;">
              <div>
                <div style="display:flex;align-items:center;gap:8px;">
                  <span style="font-size:20px;">⚡</span>
                  <h3 style="margin:0;font-size:16px;font-weight:800;letter-spacing:-0.02em;">Pending Approvals Quick Center</h3>
                </div>
                <p class="tiny muted" style="margin:3px 0 0;">Immediate action queue for pending Trade-in deposits &amp; Cashout disbursements (Mobile &amp; Desktop)</p>
              </div>
              <div style="display:flex;gap:8px;align-items:center;">
                <button type="button" class="btn btn-ghost btn-sm" id="btnQuickGoTradein" style="font-size:11.5px;font-weight:700;">Trade-In Tab ➔</button>
                <button type="button" class="btn btn-ghost btn-sm" id="btnQuickGoWd" style="font-size:11.5px;font-weight:700;">Cashout Tab ➔</button>
                <button type="button" class="btn btn-ghost btn-sm" id="btnQuickGoLoadWallet" style="font-size:11.5px;font-weight:700;color:var(--accent-mint);border-color:rgba(46,213,158,0.3);">Load Wallet ➔</button>
              </div>
            </div>
            <div id="homePendingQueue" style="display:flex;flex-direction:column;gap:10px;">
              <div style="padding:20px;text-align:center;" class="muted tiny">Loading pending queue...</div>
            </div>
          </div>
        </section>

        <!-- =========================================================
             VIEW 2: MEMBER LIST
             ========================================================= -->
        <section class="admin-view-panel" id="viewMembers">
          <div class="admin-sec-head">
            <div>
              <h2 class="admin-sec-title">MEMBER DIRECTORY</h2>
              <p class="admin-sec-sub">COMPLETE MEMBER PROFILES · ACTIVATION · PERMISSIONS</p>
            </div>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
              <input id="userSearch" class="ctrl-search" type="search" placeholder="Search by username, ID, or sponsor..." />
              <div class="ctrl-tabs">
                <button class="ctrl-tab active" data-userfilter="all">All (<span id="userCountAll">0</span>)</button>
                <button class="ctrl-tab" data-userfilter="active">Active</button>
                <button class="ctrl-tab" data-userfilter="inactive">Inactive</button>
                <button class="ctrl-tab" data-userfilter="expired">Expired</button>
              </div>
            </div>
          </div>

          <!-- Member Directory Inventory Header with Live Counters & Minimize -->
          <div class="member-inventory-head-bar" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin:18px 0 14px;padding:12px 16px;border-radius:12px;">
            <div style="display:flex;align-items:center;gap:10px;">
              <span style="font-size:18px;">👥</span>
              <div>
                <strong style="font-size:13.5px;color:var(--text);letter-spacing:0.02em;">MEMBER DIRECTORY LIST</strong>
                <span class="tiny muted" id="memberInventorySummaryTag" style="display:block;margin-top:2px;">Loading directory...</span>
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
              <button type="button" id="btnToggleMemberList" class="btn btn-sm btn-ghost" style="padding:6px 14px;font-size:11.5px;font-weight:700;">
                <span id="toggleMemberListIcon">▾</span> <span id="toggleMemberListText">Hide List</span>
              </button>
            </div>
          </div>

          <!-- Collapsible Member List Wrap -->
          <div id="memberInventoryContentWrap">
            <div class="admin-table-panel table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Member Info</th>
                    <th>Status</th>
                    <th>Sponsor &amp; Directs</th>
                    <th>Binary Earned</th>
                    <th>Wallet Balances</th>
                    <th style="text-align:right">Actions</th>
                  </tr>
                </thead>
                <tbody id="userTableBody">
                  <tr>
                    <td colspan="7" style="padding:20px;text-align:center" class="muted">Loading members...</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Mobile Touch-Friendly Card View (Screens <= 768px) -->
            <div class="admin-mobile-cards-list" id="userMobileCards"></div>

            <!-- Member Directory Pagination Bar (Both Desktop & Mobile) -->
            <div id="memberPaginationBar" class="table-pagination-bar" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-top:14px;padding:10px 14px;border-radius:10px;">
              <div style="display:flex;align-items:center;gap:10px;font-size:12px;" class="muted">
                <span id="memberPageRangeText">Showing 1–10 of 0 members</span>
                <div style="display:flex;align-items:center;gap:6px;">
                  <span>Per page:</span>
                  <select id="memberPageSizeSelect" class="in" style="padding:3px 8px;font-size:12px;border-radius:6px;width:auto;">
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="all">All</option>
                  </select>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:6px;" id="memberPageButtons">
                <button type="button" id="btnMemberPrevPage" class="btn btn-sm btn-ghost" style="padding:4px 10px;font-size:11.5px;">◀ Prev</button>
                <div id="memberPageNumbers" style="display:flex;align-items:center;gap:4px;"></div>
                <button type="button" id="btnMemberNextPage" class="btn btn-sm btn-ghost" style="padding:4px 10px;font-size:11.5px;">Next ▶</button>
              </div>
            </div>
          </div>
        </section>

        <!-- =========================================================
             VIEW 3: CODE VAULT
             ========================================================= -->
        <section class="admin-view-panel" id="viewVault">
          <div class="admin-sec-head">
            <div>
              <h2 class="admin-sec-title">CODE VAULT</h2>
              <p class="admin-sec-sub">GENERATE CODE ➔ SEND CODE</p>
            </div>
            <div class="ctrl-tabs">
              <button class="ctrl-tab active" data-codefilter="all">All Codes</button>
              <button class="ctrl-tab" data-codefilter="available">Available</button>
              <button class="ctrl-tab" data-codefilter="assigned">Assigned</button>
              <button class="ctrl-tab" data-codefilter="used">Used</button>
            </div>
          </div>

          <div class="vault-container">
            <!-- GENERATE CODE (Left Box) -->
            <div class="vault-panel">
              <div>
                <h3>➔ GENERATE CODE</h3>
                <p class="tiny muted" style="margin:0 0 10px">Quick batch mint 8-character codes or fill custom slots:
                </p>
                <div style="margin-bottom:12px;">
                  <span class="tiny" style="font-weight:700;color:var(--muted);display:block;margin-bottom:6px;">QUICK
                    BULK MINT:</span>
                  <div style="display:flex;gap:6px;flex-wrap:wrap;">
                    <button type="button" class="btn btn-mint btn-sm" data-mint-count="1">+1 Code</button>
                    <button type="button" class="btn btn-mint btn-sm" data-mint-count="5">+5 Codes</button>
                    <button type="button" class="btn btn-mint btn-sm" data-mint-count="10">+10 Codes</button>
                    <button type="button" class="btn btn-mint btn-sm" data-mint-count="20">+20 Codes</button>
                    <button type="button" class="btn btn-mint btn-sm" data-mint-count="50">+50 Codes</button>
                  </div>
                </div>
                <div class="slot-list">
                  <input id="codeSlot1" class="slot-input" type="text" placeholder="CODE SLOT 1 (8 CHARS)" maxlength="8"
                    style="text-transform:uppercase;font-family:ui-monospace,monospace;font-weight:700;" />
                  <input id="codeSlot2" class="slot-input" type="text" placeholder="CODE SLOT 2 (8 CHARS)" maxlength="8"
                    style="text-transform:uppercase;font-family:ui-monospace,monospace;font-weight:700;" />
                  <input id="codeSlot3" class="slot-input" type="text" placeholder="CODE SLOT 3 (8 CHARS)" maxlength="8"
                    style="text-transform:uppercase;font-family:ui-monospace,monospace;font-weight:700;" />
                </div>
              </div>
              <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button id="btnMintCustom" class="btn btn-sm">Generate Custom Slots</button>
                <button id="btnRandomizeSlots" class="btn btn-ghost btn-sm">Randomize Slots</button>
              </div>
            </div>

            <!-- SEND CODE (Right Box) -->
            <div class="vault-panel">
              <div>
                <h3>➔ SEND CODE</h3>
                <p class="tiny muted" style="margin:0 0 10px">Transfer activation codes directly to a code seller /
                  member account:</p>
                <div class="send-grid">
                  <div class="send-field">
                    <label for="sendTargetMobile">MEMBER USERNAME</label>
                    <input id="sendTargetMobile" type="text" list="memberDatalist"
                      placeholder="Select or enter username..." />
                    <datalist id="memberDatalist"></datalist>
                  </div>
                  <div class="send-field">
                    <label for="sendQty">QTY:</label>
                    <div class="qty-flex">
                      <input id="sendQty" type="number" min="1" max="50" value="1" />
                      <span class="tiny muted" id="freeCodesNotice">(0 available to send)</span>
                    </div>
                  </div>
                </div>
              </div>
              <div>
                <button id="btnSendCodes" class="btn btn-mint btn-sm" style="width:100%">SEND CODE</button>
              </div>
            </div>
          </div>

          <!-- Code Vault Inventory Section Header with Collapse & Counter -->
          <div class="code-inventory-head-bar" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin:24px 0 14px;padding:12px 16px;border-radius:12px;">
            <div style="display:flex;align-items:center;gap:10px;">
              <span style="font-size:18px;">📦</span>
              <div>
                <strong style="font-size:13.5px;color:var(--text);letter-spacing:0.02em;">CODE INVENTORY LIST</strong>
                <span class="tiny muted" id="codeInventorySummaryTag" style="display:block;margin-top:2px;">Loading code inventory...</span>
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
              <button type="button" id="btnToggleCodeList" class="btn btn-sm btn-ghost" style="padding:6px 14px;font-size:11.5px;font-weight:700;">
                <span id="toggleCodeListIcon">▾</span> <span id="toggleCodeListText">Hide List</span>
              </button>
            </div>
          </div>

          <!-- Collapsible Container for Code List -->
          <div id="codeInventoryContentWrap">
            <!-- Code Vault Search & Batch Copy Actions Bar -->
            <div
              style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px;">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                <input id="codeSearch" class="ctrl-search" type="search" placeholder="Search code, seller, or member..."
                  style="min-width:240px;" />
                <span class="tiny muted" id="codeSearchCount"></span>
              </div>
              <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button type="button" id="btnCopyAllAvailableCodes" class="btn btn-sm btn-ghost"
                  style="padding:6px 12px;font-size:11.5px;">
                  <span>📋 Copy All Available Codes</span>
                </button>
                <button type="button" id="btnCopyCodeInviteTemplate" class="btn btn-sm btn-mint"
                  style="padding:6px 12px;font-size:11.5px;">
                  <span>💬 Copy Member Promo Template</span>
                </button>
              </div>
            </div>

            <!-- Code Vault Inventory Table -->
            <div class="admin-table-panel table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Activation Code</th>
                    <th>Status</th>
                    <th>Assigned Seller</th>
                    <th>Used By Member</th>
                    <th>Binary Placement (Upline &amp; Leg)</th>
                    <th>Created Date</th>
                    <th>Used Date</th>
                    <th style="text-align:right">Action</th>
                  </tr>
                </thead>
                <tbody id="codeTableBody">
                  <tr>
                    <td colspan="9" style="padding:20px;text-align:center" class="muted">Loading codes...</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Mobile Touch-Friendly Card View (Screens <= 768px) -->
            <div class="admin-mobile-cards-list" id="codeMobileCards"></div>

            <!-- Code Inventory Pagination Bar (Both Desktop & Mobile) -->
            <div id="codePaginationBar" class="table-pagination-bar" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-top:14px;padding:10px 14px;border-radius:10px;">
              <div style="display:flex;align-items:center;gap:10px;font-size:12px;" class="muted">
                <span id="codePageRangeText">Showing 1–10 of 0 codes</span>
                <div style="display:flex;align-items:center;gap:6px;">
                  <span>Per page:</span>
                  <select id="codePageSizeSelect" class="in" style="padding:3px 8px;font-size:12px;border-radius:6px;width:auto;">
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="all">All</option>
                  </select>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:6px;" id="codePageButtons">
                <button type="button" id="btnCodePrevPage" class="btn btn-sm btn-ghost" style="padding:4px 10px;font-size:11.5px;">◀ Prev</button>
                <div id="codePageNumbers" style="display:flex;align-items:center;gap:4px;"></div>
                <button type="button" id="btnCodeNextPage" class="btn btn-sm btn-ghost" style="padding:4px 10px;font-size:11.5px;">Next ▶</button>
              </div>
            </div>
          </div>
        </section>

