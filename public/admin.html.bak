        <!-- =========================================================
             VIEW 9: SYSTEM SETTINGS
             ========================================================= -->
        <section class="admin-view-panel" id="viewSettings">
          <div class="admin-sec-head">
            <div>
              <h2 class="admin-sec-title">SYSTEM SETTINGS</h2>
              <p class="admin-sec-sub">PLATFORM CONFIGURATION · BINARY CAP &amp; PAYOUT RULES</p>
            </div>
          </div>

          <div class="admin-card" style="margin-top:20px;">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;width:100%;">
              <div>
                <p class="kpi-label" style="font-size:11px;letter-spacing:0.05em;">BINARY MATCHING RULES</p>
                <p style="margin:2px 0 0;font-size:15px;color:var(--text);font-weight:700;">Global Binary Matching Cap Limit</p>
                <p class="tiny muted" style="margin:4px 0 0;max-width:550px;">
                  Set the maximum gross binary pairing earnings limit per activation code. Once reached, account binary matching ceases until code renewal. Direct (₱50) and Indirect (₱5) bonuses are unlimited.
                </p>
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:rgba(15,122,69,0.08);padding:12px 18px;border-radius:12px;border:1px solid rgba(15,122,69,0.25);">
                <div>
                  <span class="tiny muted" style="text-transform:uppercase;font-weight:700;font-size:10.5px;letter-spacing:0.04em;">System Binary Cap</span>
                  <div style="font-size:18px;font-weight:800;color:var(--jade);">₱3,000.00</div>
                </div>
                <span class="badge-tag tag-available" style="font-size:11px;padding:4px 10px;font-weight:700;">Fixed System Rule</span>
              </div>
            </div>

            <div style="margin-top:20px;padding-top:16px;border-top:1px dashed rgba(15,122,69,0.2);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
              <div>
                <p style="margin:0;font-size:13px;font-weight:700;color:var(--jade);">Official Mode of Payment (MOP)</p>
                <p class="tiny muted" style="margin:2px 0 0;" id="homeMopSummary">Loading payment channels...</p>
              </div>
              <button type="button" class="btn btn-ghost btn-sm" id="btnGoOfficialMop" style="font-size:12px;font-weight:700;">
                📲 Manage Official MOP ➔
              </button>
            </div>
          </div>
        </section>
      </div>
    </div>

  <!-- Modal: Add / Edit Official Mode of Payment (MOP) -->
  <div class="plan-modal" id="modalEditMop" hidden>
    <div class="plan-modal-backdrop" id="closeMopBackdrop"></div>
    <div class="plan-modal-sheet" style="max-width:580px;">
      <header class="plan-modal-head">
        <div>
          <p class="kicker">Treasury Channel</p>
          <h2 id="modalMopTitle">Add Mode of Payment</h2>
        </div>
        <button class="plan-close" type="button" id="btnCloseMopModal">×</button>
      </header>
      <div class="plan-modal-body">
        <form id="formMop" style="margin-top:0;">
          <input type="hidden" id="mopIdInput" value="" />

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
            <div>
              <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">PAYMENT PROVIDER / METHOD *</label>
              <select class="in" id="mopMethodSelect" style="width:100%;font-size:13px;font-weight:600;">
                <option value="GCash">GCash</option>
                <option value="Maya">Maya</option>
                <option value="GoTyme">GoTyme Bank</option>
                <option value="MariBank">MariBank</option>
                <option value="UnionBank">UnionBank (UB)</option>
                <option value="BDO">BDO Unibank</option>
                <option value="BPI">BPI</option>
                <option value="SeaBank">SeaBank</option>
                <option value="Other">Other Bank / E-Wallet</option>
              </select>
            </div>
            <div id="mopCustomMethodWrap" style="display:none;">
              <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">CUSTOM METHOD NAME *</label>
              <input class="in" id="mopCustomMethodInput" placeholder="e.g. RCBC / Coins.ph" style="width:100%;font-size:13px;font-weight:600;" />
            </div>
          </div>

          <div style="margin-bottom:12px;">
            <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">ACCOUNT NAME *</label>
            <input class="in" id="mopAccountNameInput" placeholder="e.g. Infinite Trading Treasury / Maria Santos" required style="width:100%;font-size:13.5px;font-weight:700;" />
          </div>

          <div style="margin-bottom:12px;">
            <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">ACCOUNT / MOBILE NUMBER *</label>
            <input class="in" id="mopAccountNumberInput" placeholder="e.g. 0917 123 4567 or 1092 8472 9182" required style="width:100%;font-size:14px;font-weight:700;letter-spacing:0.04em;" />
          </div>

          <!-- QR Code Upload Dropzone -->
          <div style="margin-bottom:12px;">
            <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">OFFICIAL QR CODE IMAGE (CLICK OR DRAG TO UPLOAD)</label>
            <input type="file" id="mopQrInput" accept="image/*" style="display:none;" />
            <div class="receipt-dropzone" id="mopQrDropzone" style="margin:4px 0 8px;cursor:pointer;">
              <span class="receipt-drop-icon">📲</span>
              <p class="receipt-drop-title">Tap here to choose QR Code screenshot</p>
              <p class="receipt-drop-hint">PNG, JPG, JPEG, WEBP (Auto-compressed)</p>
            </div>
            <!-- Preview Box -->
            <div id="mopQrPreviewBox" class="receipt-preview-box" style="display:none;">
              <img src="" id="mopQrPreviewImg" class="receipt-preview-img" alt="QR Preview" style="width:68px;height:68px;object-fit:contain;background:#fff;border-radius:8px;border:1px solid #ddd;cursor:pointer;" title="Click to zoom in lightbox" />
              <div style="flex:1;min-width:0;">
                <p id="mopQrFileName" style="font-size:12px;font-weight:700;margin:0;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">QR_Code.png</p>
                <p id="mopQrFileSize" class="tiny muted" style="margin:2px 0 0;">Attached</p>
              </div>
              <button type="button" class="btn btn-ghost btn-sm" id="btnRemoveMopQr" style="color:#ef4444;font-size:11px;">✕ Remove</button>
            </div>
          </div>

          <div style="margin-bottom:14px;">
            <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">PAYMENT INSTRUCTIONS / NOTES</label>
            <textarea class="in" id="mopInstructionsInput" rows="2" placeholder="e.g. Scan the QR code or send payment to this number. Make sure the reference number is clear in your screenshot." style="width:100%;font-size:12.5px;resize:vertical;"></textarea>
          </div>

          <div style="display:flex;gap:16px;margin-bottom:16px;padding:10px 14px;background:var(--bg2);border-radius:10px;border:1px solid var(--line);">
            <label style="display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:700;cursor:pointer;">
              <input type="checkbox" id="mopIsActiveCheck" checked style="width:16px;height:16px;accent-color:var(--jade);" />
              <span>Active Channel (Visible to Members)</span>
            </label>
            <label style="display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:700;cursor:pointer;">
              <input type="checkbox" id="mopIsPrimaryCheck" style="width:16px;height:16px;accent-color:var(--jade);" />
              <span>Default / Primary Channel</span>
            </label>
          </div>

          <div style="display:flex;justify-content:flex-end;gap:8px;">
            <button type="button" class="btn btn-secondary btn-sm" id="btnCancelMop">Cancel</button>
            <button type="submit" class="btn btn-mint btn-sm" id="btnSaveMop">Save Mode of Payment ➔</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: Admin Member Genealogy Visualizer -->
  <div class="plan-modal" id="modalAdminGenealogy" hidden>
    <div class="plan-modal-backdrop" id="closeAdminGenealogyBackdrop"></div>
    <div class="plan-modal-sheet" style="max-width:920px;">
      <header class="plan-modal-head">
        <div>
          <p class="kicker">Admin Inspector</p>
          <h2 id="adminGenealogyTitle">Member Genealogy Tree</h2>
        </div>
        <button class="plan-close" type="button" id="closeAdminGenealogyBtn">×</button>
      </header>
      <div class="plan-modal-body">
        <div class="genealogy-toolbar">
          <div class="genealogy-breadcrumbs" id="adminGenealogyBreadcrumbs"></div>
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <div class="tree-depth-controls" id="adminTreeDepthControls">
              <button type="button" class="depth-btn active" data-depth="3">3L</button>
              <button type="button" class="depth-btn" data-depth="4">4L</button>
              <button type="button" class="depth-btn" data-depth="5">5L</button>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" id="btnAdminGenealogyUp" style="padding:5px 10px;font-size:11.5px;font-weight:700;">
              ⬆ Up 1 Level
            </button>
            <button type="button" class="btn btn-secondary btn-sm" id="btnAdminGenealogyRoot" style="padding:5px 10px;font-size:11.5px;font-weight:700;">
              🏠 Target Root
            </button>
          </div>
        </div>
        <div class="genealogy-canvas-wrap" id="adminGenealogyContainer" style="min-height:300px;"></div>
        <div style="margin-top:12px;padding:8px 12px;background:var(--bg2);border:1px solid var(--line);border-radius:10px;font-size:11px;color:var(--muted);">
          💡 <strong>Tip:</strong> Click any member node to drill down and explore their subtree &amp; spilled accounts. Click <strong>+ Encode Slot</strong> on any open slot to place a member.
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Admin Member Activation & Binary Placement -->
  <div class="plan-modal" id="modalAdminActivateUser" hidden>
    <div class="plan-modal-backdrop" id="closeAdminActivateBackdrop"></div>
    <div class="plan-modal-sheet" style="max-width:560px;">
      <header class="plan-modal-head">
        <div>
          <p class="kicker">Binary Network Placement</p>
          <h2 id="modalAdminActivateTitle">⚡ Activate Member Account</h2>
        </div>
        <button class="plan-close" type="button" id="btnCloseAdminActivateModal">×</button>
      </header>
      <div class="plan-modal-body">
        <form id="formAdminActivateUser" style="margin-top:0;">
          <input type="hidden" id="admActUserIdInput" value="" />

          <!-- Target Member Info Banner -->
          <div style="background:rgba(46,213,158,0.1);border:1.5px solid rgba(46,213,158,0.25);border-radius:12px;padding:12px 14px;margin-bottom:14px;">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
              <div>
                <span class="tiny muted" style="font-weight:700;display:block;">MEMBER TO ACTIVATE</span>
                <div style="display:flex;align-items:center;gap:6px;margin-top:2px;">
                  <strong id="admActUserMobileText" style="font-size:16px;color:var(--text);letter-spacing:0.02em;">—</strong>
                  <span id="admActUserRoleTag" class="badge-tag" style="background:rgba(14,165,233,0.18);color:#38bdf8;border:1px solid rgba(14,165,233,0.3);font-weight:800;font-size:9.5px;">Inactive Member</span>
                </div>
              </div>
              <div style="text-align:right;">
                <span class="tiny muted" style="font-weight:700;display:block;">DIRECT SPONSOR</span>
                <span id="admActUserSponsorText" style="font-size:13px;font-weight:800;color:var(--text);">—</span>
              </div>
            </div>

            <!-- Inactive User Selector (Visible when launched from Tree or when multiple exist) -->
            <div id="admActMemberSelectWrap" style="display:none;margin-top:10px;padding-top:10px;border-top:1px dashed rgba(15,122,69,0.2);">
              <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">CHOOSE INACTIVE MEMBER TO PLACE *</label>
              <select id="admActMemberDropdown" class="in" style="width:100%;font-size:13px;font-weight:700;">
                <option value="">-- Choose member --</option>
              </select>
            </div>
          </div>

          <!-- Placement Settings -->
          <div style="margin-bottom:16px;">
            <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:6px;letter-spacing:0.02em;">
              BINARY TREE PLACEMENT MODE *
            </label>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;">
              <label class="placement-mode-card active" id="cardPlaceAuto" style="cursor:pointer;border:2px solid var(--jade);background:rgba(15,122,69,0.08);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px;">
                <input type="radio" name="admPlacementMode" value="auto" checked style="accent-color:var(--jade);" />
                <div>
                  <strong style="font-size:12.5px;display:block;color:var(--text);">⚡ Auto-Placement</strong>
                  <span class="tiny muted" style="font-size:10px;display:block;">Next available open slot</span>
                </div>
              </label>

              <label class="placement-mode-card" id="cardPlaceManual" style="cursor:pointer;border:2px solid var(--line);background:var(--bg2);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px;">
                <input type="radio" name="admPlacementMode" value="manual" style="accent-color:var(--jade);" />
                <div>
                  <strong style="font-size:12.5px;display:block;color:var(--text);">🎯 Specific Slot</strong>
                  <span class="tiny muted" style="font-size:10px;display:block;">Choose Parent &amp; Leg</span>
                </div>
              </label>
            </div>

            <!-- Manual Parent & Leg Fields (Toggled) -->
            <div id="admManualPlacementFields" style="display:none;background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:12px;margin-top:8px;">
              <div style="display:grid;grid-template-columns:2fr 1fr;gap:10px;">
                <div>
                  <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">PLACEMENT PARENT (UPLINE) *</label>
                  <input type="text" id="admActParentMobileInput" class="in" placeholder="Username or Mobile" style="width:100%;font-size:13px;font-weight:700;" />
                </div>
                <div>
                  <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">LEG POSITION *</label>
                  <select id="admActPositionSelect" class="in" style="width:100%;font-size:13px;font-weight:700;">
                    <option value="L">LEFT (L)</option>
                    <option value="R">RIGHT (R)</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Activation Code Options -->
          <div style="margin-bottom:18px;">
            <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:6px;letter-spacing:0.02em;">
              ACTIVATION CODE (₱100 RETAILER ENTRY) *
            </label>
            <div style="background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:12px;">
              <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px;">
                <input type="checkbox" id="admActAutoCodeCheck" checked style="accent-color:var(--jade);transform:scale(1.2);" />
                <div>
                  <strong style="font-size:13px;color:var(--text);">✨ Auto-generate &amp; apply new Admin Code</strong>
                  <span class="tiny muted" style="display:block;font-size:11px;">System will automatically mint and consume an authentic 8-character activation code.</span>
                </div>
              </label>

              <div id="admActCustomCodeWrap" style="display:none;margin-top:8px;padding-top:8px;border-top:1px dashed var(--line);">
                <label class="tiny muted" style="display:block;font-weight:700;margin-bottom:4px;">ENTER CODE FROM VAULT</label>
                <input type="text" id="admActCustomCodeInput" class="in" placeholder="8-CHAR CODE" maxlength="12" style="width:100%;text-transform:uppercase;font-family:ui-monospace,monospace;font-weight:800;letter-spacing:0.06em;" />
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-mint" id="btnSubmitAdminActivate"
            style="width:100%;font-size:14.5px;font-weight:800;padding:13px;border-radius:10px;box-shadow:0 4px 16px rgba(15,122,69,0.35);">
            ⚡ Activate Account &amp; Place in Tree ➔
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Reusable Glassmorphic Confirmation Popup Modal -->
  <div class="modal-confirm-overlay" id="modalConfirmAction" style="display:none;">
    <div class="modal-confirm-card" role="dialog" aria-modal="true">
      <div class="confirm-head">
        <div class="confirm-icon-circle" id="confirmModalIcon">⚠️</div>
        <div>
          <h3 class="confirm-title" id="confirmModalTitle">Confirm Action</h3>
          <p class="confirm-sub" id="confirmModalSubtitle">Please review the details below before proceeding.</p>
        </div>
      </div>
      <div class="confirm-body">
        <div id="confirmModalSummary" style="font-size:13px;color:var(--text);margin-bottom:12px;line-height:1.5;"></div>
        <table class="confirm-details-table" id="confirmModalTable" style="display:none;">
          <tbody id="confirmModalTableBody"></tbody>
        </table>
      </div>
      <div class="confirm-actions">
        <button type="button" class="btn btn-secondary btn-sm" id="btnConfirmCancel">Cancel</button>
        <button type="button" class="btn btn-mint btn-sm" id="btnConfirmOk">Confirm &amp; Proceed</button>
      </div>
    </div>
  </div>

  <!-- Reusable Receipt Lightbox Modal -->
  <div class="receipt-lightbox-overlay" id="modalReceiptLightbox" style="display:none;">
    <div class="receipt-lightbox-card">
      <div class="receipt-lightbox-head">
        <div style="display:flex;align-items:center;gap:8px;min-width:0;flex:1;">
          <span style="font-size:18px;">🧾</span>
          <strong id="receiptLightboxTitle" style="font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Receipt Inspection</strong>
        </div>
        <div style="display:flex;align-items:center;gap:6px;">
          <button type="button" class="btn btn-ghost btn-sm" id="btnZoomToggleReceipt" style="padding:4px 8px;font-size:11px;color:#a7f3d0;border:1px solid rgba(167,243,208,0.3);">🔍 Zoom</button>
          <button type="button" class="btn btn-ghost btn-sm" id="btnFullSizeReceipt" style="padding:4px 8px;font-size:11px;color:#a7f3d0;border:1px solid rgba(167,243,208,0.3);">↗ Full Screen</button>
          <button type="button" class="plan-close" id="btnCloseReceiptLightbox" style="background:none;border:none;color:#fff;font-size:22px;cursor:pointer;line-height:1;" aria-label="Close">×</button>
        </div>
      </div>
      <div class="receipt-lightbox-body" id="receiptLightboxBody">
        <img src="" id="receiptLightboxImg" class="receipt-lightbox-img" alt="Payment Receipt" />
      </div>
      <div class="receipt-lightbox-footer" id="receiptLightboxQuickActions" style="display:none;"></div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('it_token');
    if (!token) location.href = '/login.html';
    const headers = { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' };

    const peso = (n) => '₱' + Number(n || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const esc = (s) => String(s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const fmtDate = (iso) => {
      if (!iso) return '—';
      try {
        const d = new Date(iso);
        return d.toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) + ' ' + d.toLocaleTimeString('en-PH', { hour: '2-digit', minute: '2-digit' });
      } catch { return iso; }
    };

    let payoutsEnabled = false;
    let globalUsers = [];
    let globalCodes = [];
    let globalTradein = [];
    let globalWithdrawals = [];
    let userFilterMode = 'all';
    let codeFilterMode = 'all';
    let tradeinFilterMode = 'all';
    let wdFilterMode = 'all';
    let codeCurrentPage = 1;
    let codePageSize = 10;
    let isCodeListMinimized = false;
    let memberCurrentPage = 1;
    let memberPageSize = 10;
    let isMemberListMinimized = false;

    function flash(text, ok) {
      const el = document.getElementById('msg');
      el.textContent = text;
      el.className = 'banner show' + (ok ? ' ok' : '');
      setTimeout(() => {
        if (el.className.includes('show')) el.className = 'banner';
      }, 5000);
    }

    async function api(url, opts = {}) {
      const res = await fetch(url, { headers, ...opts });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401 || res.status === 403) {
        if (data.error && data.error.includes('Admin')) {
          flash(data.error);
        } else {
          location.href = '/login.html';
        }
        throw new Error(data.error || 'Access denied');
      }
      if (!res.ok) throw new Error(data.error || 'Request failed');
      return data;
    }

    // =========================================================
    // REUSABLE CONFIRMATION MODAL & RECEIPT LIGHTBOX HELPERS
    // =========================================================
    let onAdminConfirmCb = null;
    function showAdminConfirm({ title, subtitle, icon, summary, details = [], confirmText = 'Confirm & Proceed', cancelText = 'Cancel', confirmClass = 'btn-mint', onConfirm }) {
      const modal = document.getElementById('modalConfirmAction');
      if (!modal) {
        if (confirm(summary || title)) { if (typeof onConfirm === 'function') onConfirm(); }
        return;
      }
      document.getElementById('confirmModalIcon').textContent = icon || '⚠️';
      document.getElementById('confirmModalTitle').textContent = title || 'Confirm Action';
      document.getElementById('confirmModalSubtitle').textContent = subtitle || 'Please review before executing command.';

      const summaryEl = document.getElementById('confirmModalSummary');
      if (summary) {
        summaryEl.innerHTML = summary;
        summaryEl.style.display = 'block';
      } else {
        summaryEl.style.display = 'none';
      }

      const table = document.getElementById('confirmModalTable');
      const tbody = document.getElementById('confirmModalTableBody');
      if (details && details.length > 0) {
        tbody.innerHTML = details.map(d => `
          <tr>
            <td class="table-label">${esc(d.label)}</td>
            <td class="table-val ${d.highlight ? 'highlight' : ''}">${d.html || esc(d.val)}</td>
          </tr>
        `).join('');
        table.style.display = 'table';
      } else {
        table.style.display = 'none';
      }

      const btnOk = document.getElementById('btnConfirmOk');
      const btnCancel = document.getElementById('btnConfirmCancel');
      btnOk.textContent = confirmText;
      btnOk.className = `btn ${confirmClass} btn-sm`;
      btnCancel.textContent = cancelText;

      onAdminConfirmCb = onConfirm;
      modal.style.display = 'flex';
    }

    function closeAdminConfirm() {
      const modal = document.getElementById('modalConfirmAction');
      if (modal) modal.style.display = 'none';
      onAdminConfirmCb = null;
    }

    document.getElementById('btnConfirmCancel')?.addEventListener('click', closeAdminConfirm);
    document.getElementById('btnConfirmOk')?.addEventListener('click', () => {
      const cb = onAdminConfirmCb;
      closeAdminConfirm();
      if (typeof cb === 'function') cb();
    });
    window.showAdminConfirm = showAdminConfirm;
    window.showConfirmPopup = showAdminConfirm;

    let currentLightboxPkg = null;
    function openReceiptLightbox(imgSrc, title = 'Receipt Inspection', pkg = null) {
      const overlay = document.getElementById('modalReceiptLightbox');
      const img = document.getElementById('receiptLightboxImg');
      const titleEl = document.getElementById('receiptLightboxTitle');
      const footerEl = document.getElementById('receiptLightboxQuickActions');
      if (!overlay || !img) return;

      currentLightboxPkg = pkg;
      img.classList.remove('zoomed');
      img.src = imgSrc;
      if (titleEl) titleEl.textContent = title;

      if (footerEl) {
        if (pkg && pkg.cycle_status === 'pending') {
          footerEl.innerHTML = `
            <div style="display:flex;align-items:center;justify-content:space-between;width:100%;gap:12px;flex-wrap:wrap;">
              <div style="font-size:12px;color:rgba(255,255,255,0.75);">
                Pending: <strong>#${pkg.id}</strong> · Member: <strong>${esc(pkg.mobile_number)}</strong> · Capital: <strong style="color:#34d399;">${peso(pkg.capital)}</strong>
              </div>
              <div style="display:flex;gap:8px;">
                <button type="button" class="btn btn-mint btn-sm" id="btnQuickApproveReceipt" style="padding:5px 12px;font-size:11.5px;font-weight:700;">✓ Approve</button>
                <button type="button" class="btn btn-secondary btn-sm" id="btnQuickRejectReceipt" style="padding:5px 10px;font-size:11.5px;background:rgba(239,68,68,0.15);color:#fca5a5;border-color:rgba(239,68,68,0.3);">✕ Reject</button>
              </div>
            </div>
          `;
          footerEl.style.display = 'block';

          document.getElementById('btnQuickApproveReceipt')?.addEventListener('click', () => {
            closeReceiptLightbox();
            const btnApprove = document.querySelector(`button[data-tradein-approve="${pkg.id}"]`);
            if (btnApprove) btnApprove.click();
          });

          document.getElementById('btnQuickRejectReceipt')?.addEventListener('click', () => {
            closeReceiptLightbox();
            const btnReject = document.querySelector(`button[data-tradein-reject="${pkg.id}"]`);
            if (btnReject) btnReject.click();
          });
        } else {
          footerEl.style.display = 'none';
          footerEl.innerHTML = '';
        }
      }

      overlay.style.display = 'flex';
      document.body.classList.add('modal-open');
    }

    function closeReceiptLightbox() {
      const overlay = document.getElementById('modalReceiptLightbox');
      if (overlay) overlay.style.display = 'none';
      const img = document.getElementById('receiptLightboxImg');
      if (img) {
        img.src = '';
        img.classList.remove('zoomed');
      }
      currentLightboxPkg = null;
      document.body.classList.remove('modal-open');
    }

    document.getElementById('btnCloseReceiptLightbox')?.addEventListener('click', closeReceiptLightbox);
    document.getElementById('modalReceiptLightbox')?.addEventListener('click', (e) => {
      if (e.target.id === 'modalReceiptLightbox' || e.target.id === 'receiptLightboxBody') closeReceiptLightbox();
    });

    document.getElementById('btnZoomToggleReceipt')?.addEventListener('click', () => {
      const img = document.getElementById('receiptLightboxImg');
      if (img) img.classList.toggle('zoomed');
    });

    document.getElementById('receiptLightboxImg')?.addEventListener('click', () => {
      const img = document.getElementById('receiptLightboxImg');
      if (img) img.classList.toggle('zoomed');
    });

    document.getElementById('btnFullSizeReceipt')?.addEventListener('click', () => {
      const img = document.getElementById('receiptLightboxImg');
      if (img && img.src) {
        const w = window.open();
        if (w) {
          w.document.write(`<title>Receipt Inspection</title><body style="margin:0;background:#050505;display:flex;align-items:center;justify-content:center;min-height:100vh;"><img src="${img.src}" style="max-width:100%;max-height:100vh;object-fit:contain;" /></body>`);
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const overlay = document.getElementById('modalReceiptLightbox');
        if (overlay && overlay.style.display !== 'none') {
          closeReceiptLightbox();
        }
      }
    });

    // =========================================================
    // ADMIN MEMBER GENEALOGY SUBTREE VISUALIZER
    // =========================================================
    let currentAdminTreeDepth = 3;
    let currentAdminTreeFocusId = null;
    let currentAdminTreeRootId = null;
    let adminTreeAncestors = [];

    async function fetchAndRenderAdminTree(targetUserId = null, depth = currentAdminTreeDepth) {
      const modal = document.getElementById('modalAdminGenealogy');
      const container = document.getElementById('adminGenealogyContainer');
      const breadcrumbsEl = document.getElementById('adminGenealogyBreadcrumbs');
      if (!modal || !container) return;

      modal.hidden = false;
      document.body.classList.add('modal-open');

      container.innerHTML = `
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 20px;color:var(--muted);gap:12px;">
          <div class="spinner" style="width:30px;height:30px;border:3px solid rgba(15,122,69,0.2);border-top-color:var(--jade);border-radius:50%;animation:spin 0.8s linear infinite;"></div>
          <span style="font-size:12px;font-weight:600;color:var(--jade);">Loading Member Tree Subtree...</span>
        </div>
      `;

      try {
        const url = (targetUserId ? `/api/tree?userId=${encodeURIComponent(targetUserId)}&` : '/api/tree?') + `depth=${depth}`;
        const data = await api(url);
        currentAdminTreeFocusId = data.tree ? data.tree.id : null;
        if (!currentAdminTreeRootId) currentAdminTreeRootId = currentAdminTreeFocusId;
        adminTreeAncestors = data.ancestors || [];

        document.getElementById('adminGenealogyTitle').textContent = `Genealogy Tree: ${data.tree.mobile} (#${data.tree.id})`;

        if (breadcrumbsEl) {
          if (adminTreeAncestors.length <= 1) {
            breadcrumbsEl.innerHTML = `<span class="crumb active">👤 Root (${esc(data.tree.mobile)})</span>`;
          } else {
            breadcrumbsEl.innerHTML = adminTreeAncestors.map((anc, idx) => {
              const isLast = idx === adminTreeAncestors.length - 1;
              if (isLast) return `<span class="crumb active">👤 ${esc(anc.mobile)}</span>`;
              return `<button type="button" class="crumb-btn" data-adm-tree="${anc.id}">${idx === 0 ? '🏠 ' : ''}${esc(anc.mobile)}</button><span class="crumb-sep">›</span>`;
            }).join('');
          }
        }

        const root = data.tree;

        const renderL4 = (node) => {
          if (node) {
            return `
              <div class="tree-l4-node ${node.status === 'active' ? 'active-slot' : 'inactive-slot'} clickable-adm-drill" data-adm-tree="${node.id}" style="cursor:pointer;" title="Click to view subtree">
                <span style="font-weight:700;color:var(--text);display:block;">${esc(node.mobile)}</span>
                <span style="color:var(--muted);font-size:7px;">${node.left_count}L·${node.right_count}R</span>
              </div>
            `;
          }
          return `
            <div class="tree-l4-node empty-slot">
              <span>Empty</span>
            </div>
          `;
        };

        const renderMini = (node, pos = 'L') => {
          if (node) {
            const hasL4 = depth >= 4;
            const l4Row = hasL4 ? `
              <div class="tree-l4-row">
                ${renderL4(node.left)}
                ${renderL4(node.right)}
              </div>
            ` : '';

            return `
              <div class="tree-grandchild-branch">
                <div class="tree-grandchild-connector"></div>
                <div class="tree-grandchild-node ${node.status === 'active' ? 'active-slot' : 'inactive-slot'} clickable-adm-drill" data-adm-tree="${node.id}" style="cursor:pointer;" title="Click to explore subtree of ${esc(node.mobile)}">
                  <span class="pill ${pos === 'L' ? 'open' : ''}" style="font-size:7.5px;padding:1px 5px;margin-bottom:2px;">${pos === 'L' ? 'LEFT ◀' : 'RIGHT ▶'}</span>
                  <p class="grandchild-mob">👤 ${esc(node.mobile)}</p>
                  <span class="pill ${node.status === 'active' ? 'open' : 'closed'}" style="font-size:8px;padding:1px 5px;">${esc(node.status)}</span>
                  <div class="grandchild-stats">
                    <span>L: <strong>${node.left_count}</strong></span>
                    <span>R: <strong>${node.right_count}</strong></span>
                  </div>
                  <button type="button" class="btn-drilldown-node clickable-adm-drill" data-adm-tree="${node.id}" title="Explore ${esc(node.mobile)} subtree" style="font-size:8.5px;padding:2px 8px;margin-top:4px;">
                    <span>Explore</span> ➔
                  </button>
                  ${l4Row}
                </div>
              </div>
            `;
          }
          return `
            <div class="tree-grandchild-branch">
              <div class="tree-grandchild-connector"></div>
              <div class="tree-grandchild-node empty-slot clickable-adm-encode" data-parent-id="${child.id}" data-parent-mobile="${esc(child.mobile)}" data-pos="${pos}" style="cursor:pointer;" title="Click to encode and place a member here">
                <span class="pill" style="font-size:8px;padding:1px 5px;margin-bottom:2px;background:var(--bg2);border:1px solid var(--line);color:var(--muted);">${pos === 'L' ? 'LEFT ◀' : 'RIGHT ▶'}</span>
                <span style="font-size:10px;color:var(--jade);font-weight:700;margin-top:2px;">+ Encode</span>
              </div>
            </div>
          `;
        };

        const renderChild = (child, posLabel, posKey) => {
          if (child) {
            return `
              <div class="tree-subbranch">
                <div class="tree-branch-top-connector"></div>
                <div class="tree-node child-node ${child.status === 'active' ? 'active-member' : 'inactive-member'}">
                  <span class="pill ${posKey === 'L' ? 'open' : ''}" style="font-size:8.5px;padding:1px 6px;margin-bottom:3px;">${posLabel}</span>
                  <p class="tree-node-name clickable-adm-drill" data-adm-tree="${child.id}" style="cursor:pointer;" title="Click to explore subtree">👤 ${esc(child.mobile)}</p>
                  <span class="pill ${child.status === 'active' ? 'open' : 'closed'}" style="font-size:8.5px;padding:1px 6px;">${esc(child.status)}</span>
                  <div class="tree-node-counts">
                    <span>L: <strong>${child.left_count}</strong></span>
                    <span>R: <strong>${child.right_count}</strong></span>
                  </div>
                  <button type="button" class="btn-drilldown-node clickable-adm-drill" data-adm-tree="${child.id}" title="Drill down">
                    <span>Explore Subtree</span> ➔
                  </button>
                </div>
                <div class="tree-subbranch-down-connector"></div>
                <div class="tree-grandchild-row">
                  ${renderMini(child.left, 'L')}
                  ${renderMini(child.right, 'R')}
                </div>
              </div>
            `;
          }
          return `
            <div class="tree-subbranch">
              <div class="tree-branch-top-connector"></div>
              <div class="tree-node empty-slot clickable-adm-encode" data-parent-id="${root.id}" data-parent-mobile="${esc(root.mobile)}" data-pos="${posKey}" style="cursor:pointer;" title="Click to encode and place a member here">
                <span class="pill" style="font-size:9px;margin-bottom:4px;background:var(--bg2);border:1px solid var(--line);color:var(--muted);">${posLabel}</span>
                <p style="margin:2px 0 0;font-size:12px;color:var(--jade);font-weight:700;">+ Encode Slot</p>
              </div>
            </div>
          `;
        };

        container.innerHTML = `
          <div class="tree-root-wrapper">
            <div class="tree-node root-node" style="border-color:var(--gold);background:var(--card-bg);box-shadow:0 6px 20px rgba(180,130,20,0.15);">
              <span class="pill" style="font-size:9px;background:rgba(245,166,35,0.18);color:#fbbf24;border:1px solid rgba(245,166,35,0.35);margin-bottom:2px;font-weight:700;">★ FOCUS NODE</span>
              <p class="tree-node-name" style="font-size:14px;">👤 ${esc(root.mobile)}</p>
              <span class="pill ${root.status === 'active' ? 'open' : 'closed'}">${esc(root.status)}</span>
              <div class="tree-node-counts">
                <span>Left: <strong>${root.left_count}</strong></span>
                <span>Right: <strong>${root.right_count}</strong></span>
              </div>
            </div>
            <div class="tree-connector-main"></div>
          </div>
          <div class="tree-children-row">
            ${renderChild(root.left, 'LEFT LEG', 'L')}
            ${renderChild(root.right, 'RIGHT LEG', 'R')}
          </div>
        `;

        container.querySelectorAll('.clickable-adm-drill').forEach(el => {
          el.onclick = (e) => {
            e.stopPropagation();
            const tid = el.dataset.admTree;
            if (tid) fetchAndRenderAdminTree(tid, currentAdminTreeDepth);
          };
        });

        container.querySelectorAll('.clickable-adm-encode').forEach(el => {
          el.onclick = (e) => {
            e.stopPropagation();
            openAdminActivateModal({
              parentId: el.dataset.parentId,
              parentMobile: el.dataset.parentMobile,
              pos: el.dataset.pos
            });
          };
        });

        if (breadcrumbsEl) {
          breadcrumbsEl.querySelectorAll('.crumb-btn').forEach(btn => {
            btn.onclick = () => {
              const tid = btn.dataset.admTree;
              if (tid) fetchAndRenderAdminTree(tid, currentAdminTreeDepth);
            };
          });
        }
      } catch (err) {
        container.innerHTML = `<div style="padding:24px;text-align:center;color:#ef4444;font-size:13px;">Error: ${esc(err.message)}</div>`;
      }
    }

    const closeAdminGenealogy = () => {
      const modal = document.getElementById('modalAdminGenealogy');
      if (modal) modal.hidden = true;
      document.body.classList.remove('modal-open');
      currentAdminTreeRootId = null;
    };
    document.getElementById('closeAdminGenealogyBtn')?.addEventListener('click', closeAdminGenealogy);
    document.getElementById('closeAdminGenealogyBackdrop')?.addEventListener('click', closeAdminGenealogy);

    document.getElementById('btnAdminGenealogyUp')?.addEventListener('click', () => {
      if (adminTreeAncestors && adminTreeAncestors.length > 1) {
        const parentAnc = adminTreeAncestors[adminTreeAncestors.length - 2];
        fetchAndRenderAdminTree(parentAnc.id, currentAdminTreeDepth);
      } else {
        fetchAndRenderAdminTree(currentAdminTreeRootId, currentAdminTreeDepth);
      }
    });

    document.getElementById('btnAdminGenealogyRoot')?.addEventListener('click', () => {
      fetchAndRenderAdminTree(currentAdminTreeRootId, currentAdminTreeDepth);
    });

    document.querySelectorAll('#adminTreeDepthControls .depth-btn').forEach(btn => {
      btn.onclick = () => {
        document.querySelectorAll('#adminTreeDepthControls .depth-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentAdminTreeDepth = parseInt(btn.dataset.depth, 10) || 3;
        fetchAndRenderAdminTree(currentAdminTreeFocusId, currentAdminTreeDepth);
      };
    });

    // =========================================================
    // SIDEBAR TAB SWITCHING & MOBILE DRAWER LOGIC
    // =========================================================
    const viewTitles = {
      viewHome: 'HOME OVERVIEW',
      viewMembers: 'MEMBER LIST',
      viewVault: 'CODE VAULT',
      viewTradein: 'TRADE-IN DEPOSIT',
      viewWithdrawals: 'WITHDRAWALS',
      viewEarningsHistory: 'EARNINGS AUDIT',
      viewMop: 'OFFICIAL MOP CHANNELS',
      viewLoadWallet: 'BUY LOAD WALLET REQUESTS',
      viewSettings: 'SYSTEM SETTINGS',
    };

    const sidebarEl = document.getElementById('adminSidebar');
    const backdropEl = document.getElementById('adminSidebarBackdrop');
    const burgerToggle = document.getElementById('adminBurgerToggle');
    const sidebarClose = document.getElementById('adminSidebarClose');

    function openMobileDrawer() {
      if (sidebarEl) sidebarEl.classList.add('open');
      if (backdropEl) backdropEl.classList.add('show');
      document.body.classList.add('sidebar-drawer-open');
    }

    function closeMobileDrawer() {
      if (sidebarEl) sidebarEl.classList.remove('open');
      if (backdropEl) backdropEl.classList.remove('show');
      document.body.classList.remove('sidebar-drawer-open');
    }

    if (burgerToggle) burgerToggle.onclick = openMobileDrawer;
    if (sidebarClose) sidebarClose.onclick = closeMobileDrawer;
    if (backdropEl) backdropEl.onclick = closeMobileDrawer;

    function switchAdminView(targetId, updateHistory = true) {
      if (!targetId || !document.getElementById(targetId)) targetId = 'viewHome';

      document.querySelectorAll('.admin-nav-item').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.navTarget === targetId);
      });

      document.querySelectorAll('.admin-view-panel').forEach(panel => {
        panel.classList.toggle('active', panel.id === targetId);
      });

      const tag = document.getElementById('currentViewTag');
      if (tag && viewTitles[targetId]) {
        tag.textContent = viewTitles[targetId];
      }

      // Persist active view across browser refreshes / F5
      try {
        localStorage.setItem('admin_active_tab', targetId);
        if (updateHistory && window.location.hash !== '#' + targetId) {
          window.history.replaceState(null, '', '#' + targetId);
        }
      } catch (e) {}

      if (targetId === 'viewEarningsHistory') {
        loadAdminEarningsHistory('all');
      }

      if (targetId === 'viewMop') {
        fetchAndRenderAdminMops();
      }

      if (targetId === 'viewLoadWallet') {
        fetchAndRenderAdminLoadWallet();
      }

      if (window.innerWidth <= 900) {
        closeMobileDrawer();
      }
    }

    function restoreInitialAdminView() {
      const hashView = window.location.hash ? window.location.hash.substring(1) : '';
      const savedView = localStorage.getItem('admin_active_tab') || '';
      const targetView = (hashView && document.getElementById(hashView))
        ? hashView
        : (savedView && document.getElementById(savedView))
          ? savedView
          : 'viewHome';

      switchAdminView(targetView, false);
    }

    window.addEventListener('hashchange', () => {
      const h = window.location.hash ? window.location.hash.substring(1) : '';
      if (h && document.getElementById(h)) {
        switchAdminView(h, false);
      }
    });

    document.querySelectorAll('.admin-nav-item[data-nav-target]').forEach(btn => {
      btn.addEventListener('click', () => {
        switchAdminView(btn.dataset.navTarget);
      });
    });

    document.getElementById('btnGoOfficialMop')?.addEventListener('click', () => {
      switchAdminView('viewMop');
    });

    document.getElementById('cardKpiTotalCashout')?.addEventListener('click', () => {
      switchAdminView('viewWithdrawals');
      document.querySelector('[data-wdfilter="approved"]')?.click();
    });

    document.getElementById('cardKpiPendingCashout')?.addEventListener('click', () => {
      switchAdminView('viewWithdrawals');
      document.querySelector('[data-wdfilter="pending"]')?.click();
    });

    document.getElementById('cardKpiPendingLoad')?.addEventListener('click', () => {
      switchAdminView('viewLoadWallet');
      document.querySelector('[data-loadfilter="pending"]')?.click();
    });

    document.getElementById('btnQuickGoTradein')?.addEventListener('click', () => {
      switchAdminView('viewTradein');
      document.querySelector('[data-tradeinfilter="pending"]')?.click();
    });

    document.getElementById('btnQuickGoLoadWallet')?.addEventListener('click', () => {
      switchAdminView('viewLoadWallet');
      document.querySelector('[data-loadfilter="pending"]')?.click();
    });

    document.getElementById('btnQuickGoWd')?.addEventListener('click', () => {
      switchAdminView('viewWithdrawals');
      document.querySelector('[data-wdfilter="pending"]')?.click();
    });

    function generateRandomCode() {
      const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
      let result = '';
      for (let i = 0; i < 8; i++) result += chars[Math.floor(Math.random() * chars.length)];
      return result;
    }

    function randomizeSlots() {
      document.getElementById('codeSlot1').value = generateRandomCode();
      document.getElementById('codeSlot2').value = generateRandomCode();
      document.getElementById('codeSlot3').value = generateRandomCode();
    }

    function setSidebarBadge(id, count, isAlert = false) {
      const el = document.getElementById(id);
      if (!el) return;
      const n = Number(count) || 0;
      if (n > 0) {
        el.textContent = n;
        el.style.display = 'inline-flex';
        if (isAlert) {
          el.style.background = 'rgba(239, 68, 68, 0.2)';
          el.style.color = '#ef4444';
          el.style.border = '1px solid rgba(239, 68, 68, 0.4)';
        } else {
          el.style.background = '';
          el.style.color = '';
          el.style.border = '';
        }
      } else {
        el.textContent = '';
        el.style.display = 'none';
      }
    }

    function renderHomeKPIs(overview) {
      payoutsEnabled = overview.weekly_payout_enabled;

      // Top bar button
      const topBtn = document.getElementById('togglePayoutsTopBtn');
      if (topBtn) {
        topBtn.textContent = payoutsEnabled ? 'Payouts: OPEN' : 'Payouts: CLOSED';
        topBtn.className = 'btn btn-sm ' + (payoutsEnabled ? 'btn-mint' : 'btn-ghost');
      }

      const kpis = overview.kpis || {};
      document.getElementById('kpiTradeinDeposit').textContent = peso(kpis.tradein_deposit);
      document.getElementById('kpiTradeinRef').textContent = peso(kpis.tradein_ref);
      document.getElementById('kpiTotalCode').textContent = Number(kpis.total_code || 0).toLocaleString();
      document.getElementById('kpiAvailableCodes').textContent = Number(overview.available_codes || 0) + ' Available in vault';
      document.getElementById('freeCodesNotice').textContent = '(' + Number(overview.available_codes || 0) + ' available)';
      document.getElementById('kpiTotalCodeBuy').textContent = Number(kpis.total_code_buy || 0).toLocaleString();
      document.getElementById('kpiTotalBinary').textContent = peso(kpis.total_binary);
      document.getElementById('lastUpdatedText').textContent = 'Synced ' + new Date().toLocaleTimeString();

      // Total Cashout & Pending Cashout monitoring KPIs
      const elTotalCashout = document.getElementById('kpiTotalCashout');
      if (elTotalCashout) elTotalCashout.textContent = peso(overview.total_cashout || 0);
      const elTotalCashoutSub = document.getElementById('kpiTotalCashoutSub');
      if (elTotalCashoutSub) elTotalCashoutSub.textContent = `${overview.total_cashout_count || 0} Releases (Gross: ${peso(overview.total_cashout_gross || 0)})`;

      const elPendingCashout = document.getElementById('kpiPendingCashout');
      if (elPendingCashout) elPendingCashout.textContent = peso(overview.pending_cashout || 0);
      const elPendingCashoutSub = document.getElementById('kpiPendingCashoutSub');
      if (elPendingCashoutSub) elPendingCashoutSub.textContent = `${overview.pending_cashout_count || overview.pending_withdrawals || 0} Pending (Gross: ${peso(overview.pending_cashout_gross || 0)})`;
      const badgeKpiPendingWd = document.getElementById('badgeKpiPendingWd');
      if (badgeKpiPendingWd) {
        const count = overview.pending_cashout_count || overview.pending_withdrawals || 0;
        badgeKpiPendingWd.textContent = count > 0 ? `${count} Action Needed` : '0 Pending';
        badgeKpiPendingWd.className = count > 0 ? 'badge-tag tag-expired' : 'badge-tag tag-available';
      }

      // Sidebar & Mobile Badges for Codes & Cashout (Hidden if 0)
      setSidebarBadge('badgeNavCodes', overview.available_codes);
      setSidebarBadge('badgeNavWd', overview.pending_withdrawals, true);

      // Sidebar & Mobile Badges for Trade-In (Hidden if 0)
      const pTradeinCount = overview.pending_tradeins || 0;
      setSidebarBadge('badgeNavTradein', pTradeinCount, true);

      // Pending Load Wallet KPI & Badges (Hidden if 0)
      const pLoadCount = overview.pending_load_wallets || 0;
      const elPendingLoad = document.getElementById('kpiPendingLoad');
      if (elPendingLoad) elPendingLoad.textContent = pLoadCount;
      const elPendingLoadSub = document.getElementById('kpiPendingLoadSub');
      if (elPendingLoadSub) elPendingLoadSub.textContent = `${pLoadCount} Pending orders`;
      const badgeKpiPendingLoad = document.getElementById('badgeKpiPendingLoad');
      if (badgeKpiPendingLoad) {
        badgeKpiPendingLoad.textContent = pLoadCount > 0 ? `${pLoadCount} Action Needed` : '0 Pending';
        badgeKpiPendingLoad.className = pLoadCount > 0 ? 'badge-tag tag-expired' : 'badge-tag tag-available';
      }
      setSidebarBadge('badgeNavLoadWallet', pLoadCount, true);

      // Binary Cap in Admin Settings
      if (overview.binary_cap && document.getElementById('inputAdminBinaryCap')) {
        if (document.activeElement !== document.getElementById('inputAdminBinaryCap')) {
          document.getElementById('inputAdminBinaryCap').value = overview.binary_cap;
        }
      }

      // Wallet totals bar
      const w = overview.wallets || {};
      document.getElementById('sysBinaryRef').textContent = peso(w.binary_ref || 0);
      document.getElementById('sysTradeRef').textContent = peso(w.tradein_ref || 0);
      document.getElementById('sysCycle').textContent = peso(w.tradein_cycle || 0);

      // Render Home Pending Action Center Queue
      renderHomePendingQueue();
    }

    // Save Binary Cap Setting
    document.getElementById('btnSaveBinaryCap')?.addEventListener('click', () => {
      const capInp = document.getElementById('inputAdminBinaryCap');
      const val = Number(capInp.value) || 0;
      if (val < 1000) {
        toast('Minimum binary cap is ₱1,000.');
        return;
      }

      showAdminConfirm({
        title: 'Update Binary Matching Cap',
        subtitle: 'Configure the maximum binary pairing earnings before accounts expire.',
        icon: '⚖',
        details: [
          { label: 'New Binary Cap', val: peso(val), highlight: true },
          { label: 'Affected Earnings', val: 'Matching / Pairing Bonuses only' },
          { label: 'Direct / Indirect', val: 'Unrestricted / Unlimited' }
        ],
        confirmText: 'Save Binary Cap ➔',
        confirmClass: 'btn-mint',
        onConfirm: async () => {
          try {
            const res = await fetch('/api/admin/settings/binary-cap', {
              method: 'POST',
              headers,
              body: JSON.stringify({ cap: val })
            });
            const data = await res.json();
            if (!res.ok) { toast(data.error || 'Failed to update cap.'); return; }
            toast(`✓ Binary matching cap updated to ${peso(data.binary_cap)}!`, true);
            refreshAll();
          } catch (err) {
            toast(err.message || 'Error updating binary cap.');
          }
        }
      });
    });

    // =========================================================
    // ADMIN EARNINGS AUDIT
    // =========================================================
    let currentAdminEarningsCat = 'all';

    async function loadAdminEarningsHistory(category = currentAdminEarningsCat) {
      currentAdminEarningsCat = category;
      const tbody = document.getElementById('adminEarningsTbody');
      const mobCards = document.getElementById('adminEarningsMobileCards');
      if (!tbody) return;
      tbody.innerHTML = '<tr><td colspan="6" style="padding:24px;text-align:center;" class="muted"><div class="spinner" style="width:20px;height:20px;margin:0 auto 8px;border:2px solid rgba(15,122,69,0.2);border-top-color:var(--jade);border-radius:50%;animation:spin 0.8s linear infinite;"></div>Loading audit logs...</td></tr>';
      if (mobCards) mobCards.innerHTML = '<div style="padding:24px;text-align:center;" class="muted">Loading audit logs...</div>';

      try {
        const res = await fetch(`/api/admin/earnings-history?category=${encodeURIComponent(category)}`, { headers });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          tbody.innerHTML = `<tr><td colspan="6" style="padding:20px;text-align:center;color:#ef4444;">${esc(err.error || 'Failed to load earnings audit.')}</td></tr>`;
          if (mobCards) mobCards.innerHTML = `<div style="padding:20px;text-align:center;color:#ef4444;">${esc(err.error || 'Failed to load earnings audit.')}</div>`;
          return;
        }
        const data = await res.json();
        const totalPaidEl = document.getElementById('adminTotalEarningsPaid');
        if (totalPaidEl) totalPaidEl.textContent = 'Total Paid: ' + peso(data.total_paid_out || 0);

        if (!data.records || !data.records.length) {
          tbody.innerHTML = '<tr><td colspan="6" style="padding:24px;text-align:center;" class="muted">No earnings records found for this category.</td></tr>';
          if (mobCards) mobCards.innerHTML = '<div style="padding:24px;text-align:center;" class="muted">No earnings records found for this category.</div>';
          return;
        }

        const catBadges = {
          referral: { label: 'Direct Ref (₱50)', class: 'badge-referral', icon: '🎯' },
          indirect: { label: 'Indirect Ref (₱5)', class: 'badge-indirect', icon: '👥' },
          matching: { label: 'Matching Pair (₱50)', class: 'badge-matching', icon: '⚖' },
          safety_net: { label: 'Safety Net (₱0)', class: 'badge-indirect', icon: '🛡' },
          tradein_referral: { label: 'Trade-In Ref', class: 'badge-tradein-ref', icon: '🔄' },
          tradein_earnings: { label: 'Trade-In Yield', class: 'badge-tradein-yield', icon: '📈' },
        };

        tbody.innerHTML = data.records.map(r => {
          const b = catBadges[r.category] || { label: r.category, class: 'badge-referral', icon: '💰' };
          return `
            <tr>
              <td><code>#${r.id}</code></td>
              <td><strong>${esc(r.recipient_mobile || ('User #' + r.user_id))}</strong></td>
              <td><span class="earning-badge ${b.class}">${b.icon} ${esc(b.label)}</span></td>
              <td style="font-weight:700;color:var(--jade);">+${peso(r.amount)}</td>
              <td>${esc(r.description || 'Bonus credited')}</td>
              <td class="tiny muted">${new Date(r.created_at).toLocaleString()}</td>
            </tr>
          `;
        }).join('');

        if (mobCards) {
          mobCards.innerHTML = data.records.map(r => {
            const b = catBadges[r.category] || { label: r.category, class: 'badge-referral', icon: '💰' };
            return `
              <div class="admin-mob-card">
                <div class="admin-mob-card-head">
                  <div style="display:flex;align-items:center;gap:6px;">
                    <strong style="font-size:13px;color:var(--jade);">#${r.id}</strong>
                    <span class="earning-badge ${b.class}" style="font-size:10.5px;">${b.icon} ${esc(b.label)}</span>
                  </div>
                  <span class="tiny muted">${new Date(r.created_at).toLocaleDateString()}</span>
                </div>
                <div class="admin-mob-card-grid">
                  <div class="admin-mob-card-field">
                    <span class="admin-mob-card-label">Recipient Member</span>
                    <span class="admin-mob-card-val"><strong>${esc(r.recipient_mobile || ('User #' + r.user_id))}</strong></span>
                  </div>
                  <div class="admin-mob-card-field">
                    <span class="admin-mob-card-label">Bonus Credited</span>
                    <span class="admin-mob-card-val" style="font-weight:800;color:var(--jade);font-size:14px;">+${peso(r.amount)}</span>
                  </div>
                  <div class="admin-mob-card-field full">
                    <span class="admin-mob-card-label">Audit Description</span>
                    <span class="admin-mob-card-val" style="font-size:12px;color:var(--muted);">${esc(r.description || 'Bonus credited')}</span>
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }

      } catch (err) {
        tbody.innerHTML = `<tr><td colspan="6" style="padding:20px;text-align:center;color:#ef4444;">Error: ${esc(err.message)}</td></tr>`;
        if (mobCards) mobCards.innerHTML = `<div style="padding:20px;text-align:center;color:#ef4444;">Error: ${esc(err.message)}</div>`;
      }
    }

    // =========================================================
    // OFFICIAL MODE OF PAYMENT (MOP) MANAGEMENT
    // =========================================================
    let globalMops = [];
    let mopFilterMode = 'all';
    let currentMopQrData = null;
    let mopQrRemoved = false;

    function compressMopImage(file, maxDim = 1200, quality = 0.85) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onerror = () => resolve('');
        reader.onload = (e) => {
          const img = new Image();
          img.onerror = () => resolve(e.target.result);
          img.onload = () => {
            try {
              let { width, height } = img;
              if (width > maxDim || height > maxDim) {
                if (width > height) {
                  height = Math.round((height * maxDim) / width);
                  width = maxDim;
                } else {
                  width = Math.round((width * maxDim) / height);
                  height = maxDim;
                }
              }
              const canvas = document.createElement('canvas');
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, width, height);
              resolve(canvas.toDataURL('image/jpeg', quality));
            } catch (err) {
              resolve(e.target.result);
            }
          };
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    async function fetchAndRenderAdminMops() {
      try {
        const res = await api('/api/admin/mop');
        globalMops = res.mop || [];
        renderAdminMops();
        updateMopBadgesAndHomeSummary();
      } catch (err) {
        const grid = document.getElementById('mopCardsGrid');
        if (grid) grid.innerHTML = `<div style="padding:20px;text-align:center;color:#ef4444;grid-column:1/-1;">Error: ${esc(err.message)}</div>`;
      }
    }

    function updateMopBadgesAndHomeSummary() {
      const activeCount = globalMops.filter(m => m.is_active !== false).length;
      setSidebarBadge('badgeNavMop', activeCount);

      const summaryText = document.getElementById('mopSummaryCount');
      if (summaryText) summaryText.textContent = `${activeCount} Active / ${globalMops.length} Total Channels`;

      const homeSummary = document.getElementById('homeMopSummary');
      if (homeSummary) {
        if (!globalMops.length) {
          homeSummary.innerHTML = '<span style="color:#ef4444;">No payment channels configured yet. Click button to add one.</span>';
        } else {
          const primary = globalMops.find(m => m.is_primary) || globalMops[0];
          homeSummary.innerHTML = `<strong>${activeCount} Active Channels</strong> · Primary: <span class="badge-tag tag-available" style="font-size:10px;padding:2px 6px;">${esc(primary ? primary.method : '—')}</span> (${esc(primary ? primary.account_name : '—')})`;
        }
      }
    }

    function renderAdminMops() {
      const grid = document.getElementById('mopCardsGrid');
      if (!grid) return;

      const totalCount = globalMops.length;
      const activeCount = globalMops.filter(m => m.is_active !== false).length;
      const inactiveCount = totalCount - activeCount;

      const cAll = document.getElementById('countMopAll');
      const cAct = document.getElementById('countMopActive');
      const cIna = document.getElementById('countMopInactive');
      if (cAll) cAll.textContent = totalCount;
      if (cAct) cAct.textContent = activeCount;
      if (cIna) cIna.textContent = inactiveCount;

      let list = globalMops;
      if (mopFilterMode === 'active') list = list.filter(m => m.is_active !== false);
      else if (mopFilterMode === 'inactive') list = list.filter(m => m.is_active === false);

      if (!list.length) {
        grid.innerHTML = `
          <div style="grid-column:1/-1;background:var(--card-bg);border:2px dashed var(--line);border-radius:14px;padding:36px 20px;text-align:center;">
            <span style="font-size:36px;display:block;margin-bottom:8px;">📲</span>
            <h4 style="margin:0 0 6px;color:var(--text);font-size:16px;">No Mode of Payment channels found</h4>
            <p class="tiny muted" style="margin:0 0 14px;">Add your Official GCash, Maya, or Bank QR codes so members can send deposit payments directly.</p>
            <button type="button" class="btn btn-mint btn-sm" id="btnMopEmptyAdd">＋ Add Official Payment Method</button>
          </div>
        `;
        document.getElementById('btnMopEmptyAdd')?.addEventListener('click', openAddMopModal);
        return;
      }

      grid.innerHTML = list.map(m => {
        const isActive = m.is_active !== false;
        const isPrimary = Boolean(m.is_primary);
        const hasQr = Boolean(m.qr_image);

        return `
          <div class="admin-card" style="display:flex;flex-direction:column;justify-content:space-between;border:${isPrimary ? '2px solid var(--jade)' : '1px solid var(--line)'};background:var(--card-bg);opacity:${isActive ? '1' : '0.8'};position:relative;border-radius:14px;padding:16px;box-shadow:${isPrimary ? '0 4px 16px rgba(46,213,158,0.18)' : '0 4px 16px rgba(0,0,0,0.2)'};">
            <div>
              <!-- Card Top Header -->
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:12px;">
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                  <span class="badge-tag" style="font-size:11px;padding:3px 8px;font-weight:800;background:rgba(46,213,158,0.18);color:var(--jade);border:1px solid rgba(46,213,158,0.35);">
                    ${esc(m.method)}
                  </span>
                  ${isPrimary ? '<span class="badge-tag tag-approved" style="font-size:9.5px;padding:2px 6px;background:rgba(46,213,158,0.18);color:#2ed59e;border:1px solid rgba(46,213,158,0.35);font-weight:700;">★ PRIMARY</span>' : ''}
                </div>
                <span class="pill ${isActive ? 'open' : 'closed'}" style="font-size:10px;">● ${isActive ? 'ACTIVE' : 'DISABLED'}</span>
              </div>

              <!-- Main Content: QR & Details -->
              <div style="display:flex;gap:14px;align-items:flex-start;margin-bottom:14px;">
                <div style="text-align:center;flex-shrink:0;">
                  ${hasQr ? `
                    <div style="position:relative;">
                      <img src="${m.qr_image}" class="mop-qr-thumb" data-zoom-mop="${m.id}" alt="${esc(m.method)} QR" style="width:84px;height:84px;object-fit:contain;background:#ffffff;border-radius:10px;border:1.5px solid var(--line);padding:3px;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,0.2);" />
                      <button type="button" class="btn btn-ghost btn-sm" data-zoom-mop="${m.id}" style="display:block;width:100%;font-size:9.5px;padding:2px 4px;margin-top:4px;white-space:nowrap;">🔍 Zoom QR</button>
                    </div>
                  ` : `
                    <div style="width:84px;height:84px;border-radius:10px;background:var(--bg2);border:1.5px dashed var(--line);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);font-size:10px;padding:6px;text-align:center;">
                      <span style="font-size:22px;margin-bottom:2px;">📷</span>
                      <span>No QR Code</span>
                    </div>
                  `}
                </div>

                <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:6px;">
                  <div>
                    <span class="tiny muted" style="font-size:9.5px;text-transform:uppercase;font-weight:700;letter-spacing:0.04em;">Account Name:</span>
                    <div style="display:flex;align-items:center;gap:6px;">
                      <strong style="font-size:13.5px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${esc(m.account_name)}</strong>
                      <button type="button" data-copy-txt="${esc(m.account_name)}" class="btn btn-ghost btn-sm" style="padding:1px 6px;font-size:10px;" title="Copy Account Name">Copy</button>
                    </div>
                  </div>

                  <div>
                    <span class="tiny muted" style="font-size:9.5px;text-transform:uppercase;font-weight:700;letter-spacing:0.04em;">Account / Mobile No:</span>
                    <div style="display:flex;align-items:center;gap:6px;">
                      <code style="font-size:13px;font-weight:800;color:var(--text);">${esc(m.account_number)}</code>
                      <button type="button" data-copy-txt="${esc(m.account_number)}" class="btn btn-ghost btn-sm" style="padding:1px 6px;font-size:10px;" title="Copy Account Number">Copy</button>
                    </div>
                  </div>

                  ${m.instructions ? `
                    <p class="tiny muted" style="margin:2px 0 0;font-size:11px;line-height:1.4;background:var(--bg2);padding:6px 8px;border-radius:6px;border:1px solid var(--line);">
                      ℹ ${esc(m.instructions)}
                    </p>
                  ` : ''}
                </div>
              </div>
            </div>

            <!-- Card Actions -->
            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;padding-top:10px;border-top:1px dashed rgba(15,122,69,0.2);">
              <div style="display:flex;gap:6px;">
                ${!isPrimary ? `
                  <button type="button" class="btn btn-ghost btn-sm" data-mop-primary="${m.id}" style="font-size:11px;padding:4px 8px;">★ Make Primary</button>
                ` : '<span class="tiny" style="color:var(--jade);font-weight:700;">✓ Primary Channel</span>'}
                <button type="button" class="btn btn-ghost btn-sm" data-mop-toggle="${m.id}" style="font-size:11px;padding:4px 8px;">
                  ${isActive ? 'Disable' : 'Enable'}
                </button>
              </div>
              <div style="display:flex;gap:6px;">
                <button type="button" class="btn btn-ghost btn-sm" data-mop-edit="${m.id}" style="font-size:11px;padding:4px 10px;font-weight:700;">✎ Edit</button>
                <button type="button" class="btn btn-secondary btn-sm" data-mop-del="${m.id}" style="font-size:11px;padding:4px 8px;background:rgba(239,68,68,0.08);color:#ef4444;border-color:rgba(239,68,68,0.2);">🗑 Delete</button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Wire up card action buttons
      grid.querySelectorAll('[data-zoom-mop]').forEach(el => {
        el.onclick = () => {
          const id = el.dataset.zoomMop;
          const mop = globalMops.find(x => x.id === id);
          if (mop && mop.qr_image) {
            openReceiptLightbox(mop.qr_image, `Official QR Code · ${mop.method} (${mop.account_name})`);
          }
        };
      });

      grid.querySelectorAll('[data-copy-txt]').forEach(btn => {
        btn.onclick = async () => {
          const txt = btn.dataset.copyTxt;
          try {
            await navigator.clipboard.writeText(txt);
            flash(`Copied "${txt}" to clipboard!`, true);
          } catch {
            flash('Failed to copy.');
          }
        };
      });

      grid.querySelectorAll('[data-mop-primary]').forEach(btn => {
        btn.onclick = async () => {
          const id = btn.dataset.mopPrimary;
          const mop = globalMops.find(x => x.id === id);
          if (!mop) return;
          try {
            btn.disabled = true;
            await api('/api/admin/mop', {
              method: 'POST',
              body: JSON.stringify({ ...mop, is_primary: true }),
            });
            flash(`✓ ${mop.method} set as primary Official Mode of Payment!`, true);
            await fetchAndRenderAdminMops();
          } catch (err) {
            flash(err.message);
          } finally {
            btn.disabled = false;
          }
        };
      });

      grid.querySelectorAll('[data-mop-toggle]').forEach(btn => {
        btn.onclick = async () => {
          const id = btn.dataset.mopToggle;
          try {
            btn.disabled = true;
            await api(`/api/admin/mop/${encodeURIComponent(id)}/toggle`, { method: 'POST' });
            flash('✓ Channel status updated successfully!', true);
            await fetchAndRenderAdminMops();
          } catch (err) {
            flash(err.message);
          } finally {
            btn.disabled = false;
          }
        };
      });

      grid.querySelectorAll('[data-mop-edit]').forEach(btn => {
        btn.onclick = () => {
          const id = btn.dataset.mopEdit;
          const mop = globalMops.find(x => x.id === id);
          if (mop) openEditMopModal(mop);
        };
      });

      grid.querySelectorAll('[data-mop-del]').forEach(btn => {
        btn.onclick = () => {
          const id = btn.dataset.mopDel;
          const mop = globalMops.find(x => x.id === id);
          if (!mop) return;
          showAdminConfirm({
            title: `Delete ${mop.method} Channel?`,
            subtitle: `Are you sure you want to delete this Official Mode of Payment?`,
            icon: '🗑️',
            summary: `This will remove the <strong>${esc(mop.method)}</strong> channel (${esc(mop.account_name)} - ${esc(mop.account_number)}) from official deposit options.`,
            confirmText: 'Yes, Delete Channel',
            confirmClass: 'btn-secondary',
            onConfirm: async () => {
              try {
                await api(`/api/admin/mop/${encodeURIComponent(id)}`, { method: 'DELETE' });
                flash(`✓ Deleted ${mop.method} channel.`, true);
                await fetchAndRenderAdminMops();
              } catch (err) {
                flash(err.message);
              }
            }
          });
        };
      });
    }

    // Modal controls for Add/Edit MOP
    function openAddMopModal() {
      document.getElementById('modalMopTitle').textContent = 'Add Official Mode of Payment';
      document.getElementById('mopIdInput').value = '';
      document.getElementById('mopMethodSelect').value = 'GCash';
      document.getElementById('mopCustomMethodWrap').style.display = 'none';
      document.getElementById('mopCustomMethodInput').value = '';
      document.getElementById('mopAccountNameInput').value = '';
      document.getElementById('mopAccountNumberInput').value = '';
      document.getElementById('mopInstructionsInput').value = 'Send payment to the official account, then attach the screenshot below.';
      document.getElementById('mopIsActiveCheck').checked = true;
      document.getElementById('mopIsPrimaryCheck').checked = globalMops.length === 0;

      currentMopQrData = null;
      mopQrRemoved = false;
      document.getElementById('mopQrPreviewBox').style.display = 'none';
      document.getElementById('mopQrDropzone').style.display = 'block';
      document.getElementById('mopQrInput').value = '';

      document.getElementById('modalEditMop').hidden = false;
      document.body.classList.add('modal-open');
    }

    function openEditMopModal(mop) {
      document.getElementById('modalMopTitle').textContent = `Edit Mode of Payment · ${mop.method}`;
      document.getElementById('mopIdInput').value = mop.id;

      const methodSelect = document.getElementById('mopMethodSelect');
      const standardMethods = ['GCash', 'Maya', 'GoTyme', 'MariBank', 'UnionBank', 'BDO', 'BPI', 'SeaBank'];
      if (standardMethods.includes(mop.method)) {
        methodSelect.value = mop.method;
        document.getElementById('mopCustomMethodWrap').style.display = 'none';
        document.getElementById('mopCustomMethodInput').value = '';
      } else {
        methodSelect.value = 'Other';
        document.getElementById('mopCustomMethodWrap').style.display = 'block';
        document.getElementById('mopCustomMethodInput').value = mop.method;
      }

      document.getElementById('mopAccountNameInput').value = mop.account_name || '';
      document.getElementById('mopAccountNumberInput').value = mop.account_number || '';
      document.getElementById('mopInstructionsInput').value = mop.instructions || '';
      document.getElementById('mopIsActiveCheck').checked = mop.is_active !== false;
      document.getElementById('mopIsPrimaryCheck').checked = Boolean(mop.is_primary);

      currentMopQrData = mop.qr_image || null;
      mopQrRemoved = false;
      if (mop.qr_image) {
        document.getElementById('mopQrPreviewImg').src = mop.qr_image;
        document.getElementById('mopQrFileName').textContent = `${mop.method}_QR.jpg`;
        document.getElementById('mopQrFileSize').textContent = 'Attached QR code';
        document.getElementById('mopQrPreviewBox').style.display = 'flex';
        document.getElementById('mopQrDropzone').style.display = 'none';
      } else {
        document.getElementById('mopQrPreviewBox').style.display = 'none';
        document.getElementById('mopQrDropzone').style.display = 'block';
      }
      document.getElementById('mopQrInput').value = '';

      document.getElementById('modalEditMop').hidden = false;
      document.body.classList.add('modal-open');
    }

    function closeMopModal() {
      const modal = document.getElementById('modalEditMop');
      if (modal) modal.hidden = true;
      document.body.classList.remove('modal-open');
    }

    document.getElementById('btnOpenAddMopModal')?.addEventListener('click', openAddMopModal);
    document.getElementById('btnCloseMopModal')?.addEventListener('click', closeMopModal);
    document.getElementById('btnCancelMop')?.addEventListener('click', closeMopModal);
    document.getElementById('closeMopBackdrop')?.addEventListener('click', closeMopModal);

    document.getElementById('mopMethodSelect')?.addEventListener('change', (e) => {
      const isOther = e.target.value === 'Other';
      const customWrap = document.getElementById('mopCustomMethodWrap');
      if (customWrap) {
        customWrap.style.display = isOther ? 'block' : 'none';
        if (isOther) document.getElementById('mopCustomMethodInput')?.focus();
      }
    });

    // MOP Filter Tabs
    document.querySelectorAll('#mopFilterTabs .ctrl-tab').forEach(tab => {
      tab.onclick = () => {
        document.querySelectorAll('#mopFilterTabs .ctrl-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        mopFilterMode = tab.dataset.mopfilter || 'all';
        renderAdminMops();
      };
    });

    // QR Image Dropzone & File Input Handling
    const mopDropzone = document.getElementById('mopQrDropzone');
    const mopFileInput = document.getElementById('mopQrInput');
    const mopPreviewBox = document.getElementById('mopQrPreviewBox');
    const mopPreviewImg = document.getElementById('mopQrPreviewImg');
    const mopFileName = document.getElementById('mopQrFileName');
    const mopFileSize = document.getElementById('mopQrFileSize');
    const btnRemoveMopQr = document.getElementById('btnRemoveMopQr');

    if (mopDropzone && mopFileInput) {
      mopDropzone.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        mopFileInput.click();
      });
      mopFileInput.addEventListener('click', (e) => {
        e.stopPropagation();
      });
      mopDropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        mopDropzone.classList.add('dragover');
      });
      mopDropzone.addEventListener('dragleave', () => mopDropzone.classList.remove('dragover'));
      mopDropzone.addEventListener('drop', async (e) => {
        e.preventDefault();
        mopDropzone.classList.remove('dragover');
        const file = e.dataTransfer.files[0];
        if (file) handleMopQrFile(file);
      });
      mopFileInput.addEventListener('change', () => {
        const file = mopFileInput.files[0];
        if (file) handleMopQrFile(file);
      });
    }

    async function handleMopQrFile(file) {
      if (!file.type.startsWith('image/')) {
        flash('Please select a valid image file (PNG, JPG, WEBP).');
        return;
      }
      try {
        const compressed = await compressMopImage(file);
        currentMopQrData = compressed;
        mopQrRemoved = false;
        if (mopPreviewImg) mopPreviewImg.src = compressed;
        if (mopFileName) mopFileName.textContent = file.name;
        if (mopFileSize) mopFileSize.textContent = (file.size / 1024).toFixed(1) + ' KB (Compressed)';
        if (mopDropzone) mopDropzone.style.display = 'none';
        if (mopPreviewBox) mopPreviewBox.style.display = 'flex';
      } catch (err) {
        flash('Error processing QR image: ' + err.message);
      }
    }

    if (btnRemoveMopQr) {
      btnRemoveMopQr.addEventListener('click', () => {
        currentMopQrData = null;
        mopQrRemoved = true;
        if (mopFileInput) mopFileInput.value = '';
        if (mopPreviewBox) mopPreviewBox.style.display = 'none';
        if (mopDropzone) mopDropzone.style.display = 'block';
      });
    }

    if (mopPreviewImg) {
      mopPreviewImg.addEventListener('click', () => {
        if (currentMopQrData) {
          openReceiptLightbox(currentMopQrData, 'Official QR Code Preview');
        }
      });
    }

    // Save MOP Form Handler
    document.getElementById('formMop')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('mopIdInput').value.trim();
      const methodSelect = document.getElementById('mopMethodSelect').value;
      const customMethod = document.getElementById('mopCustomMethodInput').value.trim();
      const method = methodSelect === 'Other' ? (customMethod || 'Other') : methodSelect;
      const account_name = document.getElementById('mopAccountNameInput').value.trim();
      const account_number = document.getElementById('mopAccountNumberInput').value.trim();
      const instructions = document.getElementById('mopInstructionsInput').value.trim();
      const is_active = document.getElementById('mopIsActiveCheck').checked;
      const is_primary = document.getElementById('mopIsPrimaryCheck').checked;

      if (!account_name) {
        flash('Please enter account name.');
        return;
      }
      if (!account_number) {
        flash('Please enter account/mobile number.');
        return;
      }

      const btnSave = document.getElementById('btnSaveMop');
      btnSave.disabled = true;
      btnSave.textContent = 'Saving...';

      try {
        await api('/api/admin/mop', {
          method: 'POST',
          body: JSON.stringify({
            id: id || undefined,
            method,
            account_name,
            account_number,
            qr_image: currentMopQrData || '',
            remove_qr: mopQrRemoved,
            instructions,
            is_active,
            is_primary,
          }),
        });
        flash(`✓ Official ${method} Mode of Payment saved successfully!`, true);
        closeMopModal();
        await fetchAndRenderAdminMops();
      } catch (err) {
        flash(err.message);
      } finally {
        btnSave.disabled = false;
        btnSave.textContent = 'Save Mode of Payment ➔';
      }
    });

    // =========================================================
    // BUY LOAD WALLET REQUESTS (ADMIN DESK)
    // =========================================================
    let globalLoadWallets = [];
    let currentLoadWalletFilter = 'all';
    let currentLoadWalletSearch = '';

    async function fetchAndRenderAdminLoadWallet() {
      try {
        const res = await api('/api/admin/load-wallet');
        globalLoadWallets = res.requests || [];
        renderAdminLoadWallet();
        updateLoadWalletBadges();
      } catch (err) {
        console.error('Failed to load wallet requests:', err);
      }
    }

    function updateLoadWalletBadges() {
      const pendingCount = globalLoadWallets.filter(r => r.status === 'pending').length;
      setSidebarBadge('badgeNavLoadWallet', pendingCount, true);

      const kpiPendingLoad = document.getElementById('kpiPendingLoad');
      if (kpiPendingLoad) kpiPendingLoad.textContent = pendingCount;

      const kpiPendingLoadSub = document.getElementById('kpiPendingLoadSub');
      if (kpiPendingLoadSub) kpiPendingLoadSub.textContent = `${pendingCount} Pending orders`;

      const badgeKpiPendingLoad = document.getElementById('badgeKpiPendingLoad');
      if (badgeKpiPendingLoad) {
        badgeKpiPendingLoad.textContent = pendingCount > 0 ? `${pendingCount} Action Needed` : '0 Pending';
        badgeKpiPendingLoad.className = pendingCount > 0 ? 'badge-tag tag-expired' : 'badge-tag tag-available';
      }
    }

    function renderAdminLoadWallet() {
      const tbody = document.getElementById('loadWalletTableBody');
      const mobCards = document.getElementById('loadWalletMobileCards');
      if (!tbody) return;

      const q = currentLoadWalletSearch.toLowerCase();
      let list = globalLoadWallets;

      const countAll = list.length;
      const countPending = list.filter(r => r.status === 'pending').length;
      const countApproved = list.filter(r => r.status === 'approved').length;
      const countRejected = list.filter(r => r.status === 'rejected').length;

      const elCountAll = document.getElementById('countLoadAll');
      if (elCountAll) elCountAll.textContent = countAll;
      const elCountPending = document.getElementById('countLoadPending');
      if (elCountPending) elCountPending.textContent = countPending;
      const elCountApproved = document.getElementById('countLoadApproved');
      if (elCountApproved) elCountApproved.textContent = countApproved;
      const elCountRejected = document.getElementById('countLoadRejected');
      if (elCountRejected) elCountRejected.textContent = countRejected;
      const elSummary = document.getElementById('loadWalletSummaryCount');
      if (elSummary) elSummary.textContent = `${countAll} Requests (${countPending} Pending)`;

      if (currentLoadWalletFilter === 'pending') list = list.filter(r => r.status === 'pending');
      else if (currentLoadWalletFilter === 'approved') list = list.filter(r => r.status === 'approved');
      else if (currentLoadWalletFilter === 'rejected') list = list.filter(r => r.status === 'rejected');

      if (q) {
        list = list.filter(r => 
          String(r.id).includes(q) ||
          (r.phone_number && r.phone_number.toLowerCase().includes(q)) ||
          (r.username && r.username.toLowerCase().includes(q)) ||
          (r.user_mobile && r.user_mobile.toLowerCase().includes(q)) ||
          (r.reference_number && r.reference_number.toLowerCase().includes(q)) ||
          (r.payment_method && r.payment_method.toLowerCase().includes(q))
        );
      }

      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" style="padding:32px;text-align:center;color:var(--muted);">
              No load wallet requests found.
            </td>
          </tr>
        `;
        if (mobCards) {
          mobCards.innerHTML = '<div style="padding:24px;text-align:center;" class="muted">No load wallet requests found.</div>';
        }
        return;
      }

      tbody.innerHTML = list.map(r => {
        const isPending = r.status === 'pending';
        const isApproved = r.status === 'approved';
        const isRejected = r.status === 'rejected';

        const statusBadge = isPending
          ? '<span class="badge-tag tag-expired" style="font-size:11px;font-weight:700;">⏳ Pending</span>'
          : isApproved
            ? '<span class="badge-tag tag-approved" style="font-size:11px;font-weight:700;">✓ Approved</span>'
            : '<span class="badge-tag tag-rejected" style="font-size:11px;font-weight:700;">✕ Rejected</span>';

        const receiptThumb = r.receipt_image
          ? `<img src="${r.receipt_image}" class="receipt-thumb-img" alt="Receipt" style="width:48px;height:48px;object-fit:cover;border-radius:6px;border:1px solid var(--border);cursor:pointer;" data-zoom-receipt="${r.id}" title="Tap to inspect receipt in full view" />`
          : '<span class="tiny muted">No receipt</span>';

        const actionButtons = isPending
          ? `
            <div style="display:flex;gap:6px;justify-content:flex-end;">
              <button type="button" class="btn btn-mint btn-sm" data-approve-load="${r.id}" style="padding:4px 10px;font-size:11px;font-weight:700;">✓ Approve</button>
              <button type="button" class="btn btn-secondary btn-sm" data-reject-load="${r.id}" style="padding:4px 8px;font-size:11px;color:#fca5a5;border-color:rgba(239,68,68,0.3);">✕ Reject</button>
            </div>
          `
          : `
            <div style="font-size:11px;color:var(--muted);text-align:right;">
              ${r.processed_at ? fmtDate(r.processed_at) : 'Processed'}
              ${r.admin_notes ? `<div class="tiny" style="color:var(--text);font-style:italic;margin-top:2px;">"${esc(r.admin_notes)}"</div>` : ''}
            </div>
          `;

        return `
          <tr>
            <td>
              <strong style="color:var(--text);">#LW${r.id}</strong>
              <div class="tiny muted" style="margin-top:2px;">${fmtDate(r.created_at)}</div>
            </td>
            <td>
              <strong style="color:var(--text);">${esc(r.username || ('User #' + r.user_id))}</strong>
              <div class="tiny muted" style="margin-top:2px;">${esc(r.user_mobile || '')}</div>
            </td>
            <td>
              <strong style="color:var(--jade);font-size:14px;font-weight:800;">${peso(r.amount)}</strong>
            </td>
            <td>
              <div style="display:flex;align-items:center;gap:6px;">
                <code style="font-size:12.5px;font-weight:800;color:var(--text);">${esc(r.phone_number)}</code>
                <button type="button" class="btn btn-ghost btn-sm" style="padding:2px 6px;font-size:10px;" onclick="navigator.clipboard.writeText('${esc(r.phone_number)}');flash('Copied phone number!', true);" title="Copy Phone Number">📋</button>
              </div>
            </td>
            <td>
              ${r.is_welcome_claim ? `
                <span class="badge-tag tag-welcome">🎁 WELCOME CLAIM</span>
                <div class="tiny" style="font-weight:800;color:var(--jade);margin-top:3px;">Network: ${esc(r.network || 'SIM')}</div>
                <div class="tiny muted" style="font-size:9.5px;margin-top:1px;">${r.claim_type === 'activate_and_claim' ? '⚡ Activate SIM & Claim' : '🔁 Multiple Acct / Active SIM'}</div>
              ` : `
                <span class="badge-tag tag-available" style="font-size:10px;">${esc(r.payment_method || 'GCash')}</span>
                ${r.reference_number ? `<div class="tiny muted" style="margin-top:2px;">Ref: <code>${esc(r.reference_number)}</code></div>` : ''}
              `}
            </td>
            <td>
              ${receiptThumb}
            </td>
            <td>
              ${statusBadge}
            </td>
            <td style="text-align:right;">
              ${actionButtons}
            </td>
          </tr>
        `;
      }).join('');

      if (mobCards) {
        mobCards.innerHTML = list.map(r => {
          const isPending = r.status === 'pending';
          const isApproved = r.status === 'approved';
          const statusBadge = isPending
            ? '<span class="badge-tag tag-expired" style="font-size:10.5px;font-weight:700;">⏳ Pending</span>'
            : isApproved
              ? '<span class="badge-tag tag-approved" style="font-size:10.5px;font-weight:700;">✓ Approved</span>'
              : '<span class="badge-tag tag-rejected" style="font-size:10.5px;font-weight:700;">✕ Rejected</span>';

          const receiptThumb = r.receipt_image
            ? `<img src="${r.receipt_image}" class="receipt-thumb-img" alt="Receipt" style="width:44px;height:44px;object-fit:cover;border-radius:6px;border:1px solid var(--border);cursor:pointer;" data-zoom-receipt="${r.id}" title="Tap to inspect receipt in full view" />`
            : '<span class="tiny muted">No receipt</span>';

          return `
            <div class="admin-mob-card ${isPending ? 'pending' : ''}">
              <div class="admin-mob-card-head">
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                  <strong style="color:var(--jade);font-size:13.5px;">#LW${r.id}</strong>
                  <strong style="font-size:13.5px;">${esc(r.username || ('User #' + r.user_id))}</strong>
                  ${statusBadge}
                </div>
                <span class="tiny muted">${fmtDate(r.created_at)}</span>
              </div>
              <div class="admin-mob-card-grid">
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Amount</span>
                  <span class="admin-mob-card-val" style="color:var(--jade);font-weight:800;">${peso(r.amount)}</span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Target SIM / Phone</span>
                  <span class="admin-mob-card-val"><code style="font-size:12px;font-weight:800;">${esc(r.phone_number)}</code></span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Method / Type</span>
                  <span class="admin-mob-card-val">
                    ${r.is_welcome_claim
                      ? `<span class="badge-tag tag-welcome" style="font-size:9.5px;">🎁 WELCOME CLAIM</span>`
                      : `<span class="badge-tag tag-available" style="font-size:9.5px;">${esc(r.payment_method || 'GCash')}</span>`
                    }
                  </span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Receipt Proof</span>
                  <span class="admin-mob-card-val">${receiptThumb}</span>
                </div>
              </div>
              ${r.admin_notes ? `<div class="tiny" style="color:var(--muted);font-style:italic;">Notes: "${esc(r.admin_notes)}"</div>` : ''}
              ${isPending ? `
                <div class="admin-mob-card-actions">
                  <button type="button" class="btn btn-mint btn-sm" data-approve-load="${r.id}" style="flex:1;padding:6px 10px;font-size:11px;font-weight:800;">✓ Approve</button>
                  <button type="button" class="btn btn-secondary btn-sm" data-reject-load="${r.id}" style="flex:1;padding:6px 10px;font-size:11px;color:#fca5a5;border-color:rgba(239,68,68,0.3);">✕ Reject</button>
                </div>
              ` : ''}
            </div>
          `;
        }).join('');
      }

      // Wire zoom receipt buttons
      document.querySelectorAll('[data-zoom-receipt]').forEach(img => {
        img.onclick = () => {
          const id = Number(img.dataset.zoomReceipt);
          const req = globalLoadWallets.find(r => r.id === id);
          if (req && req.receipt_image) {
            openReceiptLightbox(req.receipt_image, `Load Wallet Receipt · Order #LW${req.id} · ${req.phone_number} (${peso(req.amount)})`);
          }
        };
      });

      // Wire Approve
      document.querySelectorAll('[data-approve-load]').forEach(btn => {
        btn.onclick = () => {
          const id = Number(btn.dataset.approveLoad);
          const req = globalLoadWallets.find(r => r.id === id);
          if (!req) return;
          showAdminConfirm({
            title: `Approve Load Wallet Order #LW${req.id}`,
            subtitle: `Confirm credit dispatch to Retailer SIM: ${req.phone_number}`,
            icon: '📱',
            details: [
              { label: 'Amount', val: peso(req.amount), highlight: true },
              { label: 'Target Number', val: req.phone_number },
              { label: 'Member', val: `${req.username || 'User #' + req.user_id} (${req.user_mobile || ''})` },
              { label: 'Payment Method', val: req.payment_method || 'GCash' },
              { label: 'Ref #', val: req.reference_number || 'N/A' },
            ],
            confirmText: 'Approve & Confirm Sent ➔',
            confirmClass: 'btn-mint',
            onConfirm: async () => {
              try {
                await api(`/api/admin/load-wallet/${id}/approve`, {
                  method: 'POST',
                  body: JSON.stringify({ notes: 'Dispatched by treasury' })
                });
                flash(`✓ Order #LW${id} approved successfully!`, true);
                fetchAndRenderAdminLoadWallet();
              } catch (err) {
                flash('Error approving order: ' + err.message);
              }
            }
          });
        };
      });

      // Wire Reject
      document.querySelectorAll('[data-reject-load]').forEach(btn => {
        btn.onclick = () => {
          const id = Number(btn.dataset.rejectLoad);
          const req = globalLoadWallets.find(r => r.id === id);
          if (!req) return;
          const reason = prompt('Please enter rejection reason/notes for member:', 'Invalid payment receipt / amount mismatch');
          if (reason === null) return;
          api(`/api/admin/load-wallet/${id}/reject`, {
            method: 'POST',
            body: JSON.stringify({ notes: reason || 'Order rejected by administration' })
          }).then(() => {
            flash(`Order #LW${id} rejected.`, true);
            fetchAndRenderAdminLoadWallet();
          }).catch(err => {
            flash('Error rejecting order: ' + err.message);
          });
        };
      });
    }

    // Filter tabs for Load Wallet
    document.querySelectorAll('#loadWalletFilterTabs .ctrl-tab').forEach(tab => {
      tab.onclick = () => {
        document.querySelectorAll('#loadWalletFilterTabs .ctrl-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentLoadWalletFilter = tab.dataset.loadfilter || 'all';
        renderAdminLoadWallet();
      };
    });

    // Search input for Load Wallet
    document.getElementById('searchLoadWalletInput')?.addEventListener('input', (e) => {
      currentLoadWalletSearch = e.target.value.trim();
      renderAdminLoadWallet();
    });

    // Refresh button for Load Wallet
    const btnRefreshLW = document.getElementById('btnRefreshLoadWallet');
    if (btnRefreshLW) {
      btnRefreshLW.onclick = async () => {
        btnRefreshLW.disabled = true;
        const origHtml = btnRefreshLW.innerHTML;
        btnRefreshLW.innerHTML = '<span>⏳ Refreshing...</span>';
        try {
          await fetchAndRenderAdminLoadWallet();
          flash('✓ Load wallet orders refreshed!', true);
        } catch (e) {
          flash('Error refreshing orders: ' + e.message);
        } finally {
          setTimeout(() => {
            btnRefreshLW.disabled = false;
            btnRefreshLW.innerHTML = origHtml;
          }, 350);
        }
      };
    }

    function renderUsers() {
      const query = document.getElementById('userSearch').value.trim().toLowerCase();
      let list = globalUsers;
      if (userFilterMode === 'active') list = list.filter((u) => u.status === 'active');
      else if (userFilterMode === 'inactive') list = list.filter((u) => u.status === 'inactive');
      else if (userFilterMode === 'expired') list = list.filter((u) => u.status === 'expired');

      if (query) {
        list = list.filter((u) => String(u.id).includes(query) || (u.mobile_number && u.mobile_number.toLowerCase().includes(query)) || (u.sponsor_mobile && u.sponsor_mobile.toLowerCase().includes(query)));
      }

      document.getElementById('userCountAll').textContent = globalUsers.length;
      document.getElementById('kpiTradeinCount').textContent = globalUsers.filter(u => u.status === 'active').length + ' Active accounts';

      setSidebarBadge('badgeNavMembers', globalUsers.length);

      const dl = document.getElementById('memberDatalist');
      dl.innerHTML = globalUsers.map(u => '<option value="' + esc(u.mobile_number) + '">ID #' + u.id + ' (' + esc(u.status) + ')</option>').join('');

      // Live directory summary update
      const totalUsers = globalUsers.length;
      const activeUsers = globalUsers.filter(u => u.status === 'active').length;
      const inactiveUsers = globalUsers.filter(u => u.status === 'inactive').length;
      const bannedUsers = globalUsers.filter(u => u.status === 'banned').length;
      const memSummary = document.getElementById('memberInventorySummaryTag');
      if (memSummary) {
        memSummary.textContent = `${activeUsers} Active · ${inactiveUsers} Inactive · ${bannedUsers} Banned (${totalUsers} Total)`;
      }

      // Member Directory Pagination
      const totalItems = list.length;
      const effectiveSize = memberPageSize === 'all' ? (totalItems || 1) : (Number(memberPageSize) || 10);
      const totalPages = Math.max(1, Math.ceil(totalItems / effectiveSize));
      if (memberCurrentPage > totalPages) memberCurrentPage = totalPages;
      if (memberCurrentPage < 1) memberCurrentPage = 1;

      const startIdx = (memberCurrentPage - 1) * effectiveSize;
      const endIdx = memberPageSize === 'all' ? totalItems : Math.min(startIdx + effectiveSize, totalItems);
      const pagedList = list.slice(startIdx, endIdx);

      // Update Member Pagination Bar
      const rangeText = document.getElementById('memberPageRangeText');
      if (rangeText) {
        rangeText.textContent = totalItems === 0
          ? '0 members found'
          : `Showing ${startIdx + 1}–${endIdx} of ${totalItems} members (Page ${memberCurrentPage} of ${totalPages})`;
      }

      const btnPrev = document.getElementById('btnMemberPrevPage');
      const btnNext = document.getElementById('btnMemberNextPage');
      if (btnPrev) btnPrev.disabled = memberCurrentPage <= 1;
      if (btnNext) btnNext.disabled = memberCurrentPage >= totalPages;

      const pageNums = document.getElementById('memberPageNumbers');
      if (pageNums) {
        let pBtns = '';
        let startPage = Math.max(1, memberCurrentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

        for (let p = startPage; p <= endPage; p++) {
          const isCur = p === memberCurrentPage;
          pBtns += `<button type="button" class="btn btn-sm ${isCur ? 'btn-mint' : 'btn-ghost'}" data-memberpage="${p}" style="padding:2px 8px;font-size:11px;min-width:26px;font-weight:${isCur ? '800' : '600'};">${p}</button>`;
        }
        pageNums.innerHTML = pBtns;
        pageNums.querySelectorAll('[data-memberpage]').forEach((b) => {
          b.onclick = () => {
            memberCurrentPage = Number(b.dataset.memberpage);
            renderUsers();
          };
        });
      }

      const tbody = document.getElementById('userTableBody');
      const mobCards = document.getElementById('userMobileCards');

      if (!list.length) {
        tbody.innerHTML = '<tr><td colspan="7" style="padding:20px;text-align:center" class="muted">No members found matching filter.</td></tr>';
        if (mobCards) mobCards.innerHTML = '<div style="padding:20px;text-align:center" class="muted">No members found matching filter.</div>';
        return;
      }

      tbody.innerHTML = pagedList.map((u) => {
        const statusBadge = u.status === 'active'
          ? '<span class="badge-tag tag-active">Active</span>'
          : u.status === 'inactive'
            ? '<span class="badge-tag tag-pending">Inactive</span>'
            : u.status === 'expired'
              ? '<span class="badge-tag tag-expired">Expired</span>'
              : '<span class="badge-tag tag-rejected">' + esc(u.status) + '</span>';

        const isInactive = u.status === 'inactive';
        const isAdminDirect = !u.sponsor_mobile || u.sponsor_mobile === 'Toshi' || u.sponsor_id === 1;
        const activateBtn = isInactive
          ? '<button type="button" data-act-id="' + u.id + '" data-act-mobile="' + esc(u.mobile_number) + '" data-act-sponsor="' + esc(u.sponsor_mobile || 'Admin') + '" class="btn btn-mint btn-sm" style="padding:3px 8px;font-size:11px;font-weight:800;border-radius:6px;" title="Activate & Place in Binary Tree">⚡ Activate</button>'
          : '';
        const adminDirectTag = (isInactive && isAdminDirect)
          ? ' <span class="badge-tag" style="background:rgba(56,189,248,0.18);color:#38bdf8;border:1px solid rgba(56,189,248,0.35);font-size:9.5px;padding:1px 6px;font-weight:800;">⭐ Admin Direct</span>'
          : '';

        const roleBadge = u.role === 'admin' ? ' <span class="badge-tag" style="background:rgba(46,213,158,0.18);color:var(--jade);border:1px solid rgba(46,213,158,0.35);font-size:9.5px;padding:1px 5px;">Admin</span>' : '';
        const sponsorText = u.sponsor_mobile ? esc(u.sponsor_mobile) : '<span class="muted">—</span>';
        const treeBtn = '<button type="button" data-tree-user-id="' + u.id + '" class="btn btn-ghost btn-sm" style="padding:3px 8px;font-size:11px;" title="View Genealogy Tree">🌳 Tree</button>';
        const deleteBtn = u.role === 'admin'
          ? '<span class="tiny muted" style="padding:4px 6px;font-weight:700;">Protected</span>'
          : '<button data-del-id="' + u.id + '" data-del-mobile="' + esc(u.mobile_number) + '" class="btn-admin-del" style="padding:3px 8px;font-size:11px;">Delete</button>' +
          (u.status === 'banned'
            ? '<button data-ban-id="' + u.id + '" data-ban-mobile="' + esc(u.mobile_number) + '" data-ban-current="banned" class="btn-admin-unban" style="padding:3px 8px;font-size:11px;">Unban</button>'
            : '<button data-ban-id="' + u.id + '" data-ban-mobile="' + esc(u.mobile_number) + '" data-ban-current="active" class="btn-admin-ban" style="padding:3px 8px;font-size:11px;">Ban</button>'
          );

        return '<tr>' +
          '<td><strong style="color:var(--jade);font-size:13px;">#' + u.id + '</strong></td>' +
          '<td>' +
            '<div style="font-weight:700;font-size:13px;display:flex;align-items:center;gap:6px;">' + esc(u.mobile_number) + roleBadge + '</div>' +
            '<div class="tiny muted" style="margin-top:2px;">Joined ' + fmtDate(u.created_at) + '</div>' +
          '</td>' +
          '<td><div style="display:flex;align-items:center;gap:4px;flex-wrap:wrap;">' + statusBadge + adminDirectTag + '</div></td>' +
          '<td>' +
            '<div style="font-weight:600;font-size:12.5px;">' + sponsorText + '</div>' +
            '<div class="tiny muted" style="margin-top:2px;">Directs: <strong>' + (u.directs || 0) + '</strong></div>' +
          '</td>' +
          '<td><span style="color:var(--jade);font-weight:800;font-size:13.5px;">' + peso(u.total_binary_earnings) + '</span></td>' +
          '<td>' +
            '<div class="tiny" style="display:flex;flex-direction:column;gap:2px;font-family:ui-monospace,monospace;">' +
              '<span class="muted">Bin Ref: <strong style="color:var(--text);">' + peso(u.binary_ref_balance) + '</strong></span>' +
              '<span class="muted">Trade Ref: <strong style="color:var(--text);">' + peso(u.tradein_ref_balance) + '</strong></span>' +
              '<span class="muted">Cycle: <strong style="color:var(--text);">' + peso(u.tradein_cycle_balance) + '</strong></span>' +
            '</div>' +
          '</td>' +
          '<td style="text-align:right;">' +
            '<div style="display:inline-flex;align-items:center;gap:5px;justify-content:flex-end;flex-wrap:nowrap;">' +
              activateBtn + treeBtn + deleteBtn +
            '</div>' +
          '</td>' +
          '</tr>';
      }).join('');

      if (mobCards) {
        mobCards.innerHTML = pagedList.map((u) => {
          const isInactive = u.status === 'active' ? false : u.status === 'inactive';
          const isAdminDirect = !u.sponsor_mobile || u.sponsor_mobile === 'Toshi' || u.sponsor_id === 1;
          const statusBadge = u.status === 'active'
            ? '<span class="badge-tag tag-active">Active</span>'
            : u.status === 'inactive'
              ? '<span class="badge-tag tag-pending">Inactive</span>'
              : u.status === 'expired'
                ? '<span class="badge-tag tag-expired">Expired</span>'
                : '<span class="badge-tag tag-rejected">' + esc(u.status) + '</span>';

          const roleBadge = u.role === 'admin' ? ' <span class="badge-tag" style="background:rgba(46,213,158,0.18);color:var(--jade);border:1px solid rgba(46,213,158,0.35);font-size:9.5px;padding:1px 5px;">Admin</span>' : '';
          const adminDirectTag = (isInactive && isAdminDirect)
            ? ' <span class="badge-tag" style="background:rgba(56,189,248,0.18);color:#38bdf8;border:1px solid rgba(56,189,248,0.35);font-size:9.5px;padding:1px 5px;font-weight:800;">⭐ Admin Direct</span>'
            : '';
          const sponsorText = u.sponsor_mobile ? esc(u.sponsor_mobile) : '—';
          const mobActivateBtn = isInactive
            ? `<button type="button" data-act-id="${u.id}" data-act-mobile="${esc(u.mobile_number)}" data-act-sponsor="${esc(u.sponsor_mobile || 'Admin')}" class="btn btn-mint btn-sm" style="flex:1;padding:6px 10px;font-size:11px;font-weight:800;">⚡ Activate</button>`
            : '';
          const treeBtn = '<button type="button" data-tree-user-id="' + u.id + '" class="btn btn-ghost btn-sm" style="flex:1;padding:6px 10px;font-size:11px;">🌳 Tree</button>';
          const deleteBtn = u.role === 'admin'
            ? '<span class="tiny muted" style="padding:6px;">Protected</span>'
            : '<button data-del-id="' + u.id + '" data-del-mobile="' + esc(u.mobile_number) + '" class="btn-admin-del" style="flex:1;padding:6px 10px;font-size:11px;">Delete</button>' +
            (u.status === 'banned'
              ? '<button data-ban-id="' + u.id + '" data-ban-mobile="' + esc(u.mobile_number) + '" data-ban-current="banned" class="btn-admin-unban" style="flex:1;padding:6px 10px;font-size:11px;">Unban</button>'
              : '<button data-ban-id="' + u.id + '" data-ban-mobile="' + esc(u.mobile_number) + '" data-ban-current="active" class="btn-admin-ban" style="flex:1;padding:6px 10px;font-size:11px;">Ban</button>'
            );

          return `
            <div class="admin-mob-card">
              <div class="admin-mob-card-head">
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                  <strong style="font-size:13.5px;color:var(--jade);">#${u.id}</strong>
                  <strong style="font-size:13.5px;">${esc(u.mobile_number)}</strong>
                  ${roleBadge}
                  ${statusBadge}
                  ${adminDirectTag}
                </div>
                <span class="tiny muted">${fmtDate(u.created_at)}</span>
              </div>
              <div class="admin-mob-card-grid">
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Sponsor</span>
                  <span class="admin-mob-card-val">${sponsorText}</span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Direct Referrals</span>
                  <span class="admin-mob-card-val"><strong>${u.directs || 0}</strong></span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Binary Earned</span>
                  <span class="admin-mob-card-val" style="color:var(--jade);font-weight:700;">${peso(u.total_binary_earnings)}</span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Binary Ref Bal</span>
                  <span class="admin-mob-card-val">${peso(u.binary_ref_balance)}</span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Trade-In Ref Bal</span>
                  <span class="admin-mob-card-val">${peso(u.tradein_ref_balance)}</span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Cycle Yield Bal</span>
                  <span class="admin-mob-card-val">${peso(u.tradein_cycle_balance)}</span>
                </div>
              </div>
              <div class="admin-mob-card-actions">
                ${mobActivateBtn}
                ${treeBtn}
                ${deleteBtn}
              </div>
            </div>
          `;
        }).join('');
      }

      document.querySelectorAll('button[data-act-id]').forEach((btn) => {
        btn.onclick = () => {
          openAdminActivateModal({
            id: btn.dataset.actId,
            mobile: btn.dataset.actMobile,
            sponsor: btn.dataset.actSponsor
          });
        };
      });

      document.querySelectorAll('button[data-tree-user-id]').forEach((btn) => {
        btn.onclick = () => {
          currentAdminTreeRootId = btn.dataset.treeUserId;
          fetchAndRenderAdminTree(btn.dataset.treeUserId);
        };
      });

      document.querySelectorAll('button[data-del-id]').forEach((btn) => {
        btn.onclick = () => {
          const id = btn.dataset.delId;
          const mobile = btn.dataset.delMobile;
          showAdminConfirm({
            title: 'Delete Member Account',
            subtitle: 'Permanently remove member from the database.',
            icon: '🗑️',
            summary: `<span style="color:#ef4444;font-weight:700;">WARNING:</span> Deleting member <strong>${esc(mobile)} (#${id})</strong> will reparent downlines and remove their records.`,
            details: [
              { label: 'Member ID', val: '#' + id },
              { label: 'Mobile Number', val: mobile, highlight: true }
            ],
            confirmText: 'Delete Member ➔',
            confirmClass: 'btn-danger',
            onConfirm: async () => {
              try {
                await api('/api/admin/users/' + id, { method: 'DELETE' });
                flash('Member ' + mobile + ' deleted.', true);
                refreshAll();
              } catch (e) { flash(e.message); }
            }
          });
        };
      });

      document.querySelectorAll('button[data-ban-id]').forEach((btn) => {
        btn.onclick = () => {
          const id = btn.dataset.banId;
          const mobile = btn.dataset.banMobile;
          const current = btn.dataset.banCurrent;
          const action = current === 'banned' ? 'unban' : 'ban';
          showAdminConfirm({
            title: (action === 'ban' ? 'Ban Member' : 'Unban Member'),
            subtitle: action === 'ban' ? 'Restrict account from logging in.' : 'Restore account access.',
            icon: action === 'ban' ? '🚫' : '✓',
            details: [
              { label: 'Member ID', val: '#' + id },
              { label: 'Mobile Number', val: mobile, highlight: true },
              { label: 'Target Action', val: action.toUpperCase() }
            ],
            confirmText: action === 'ban' ? 'Confirm Ban' : 'Confirm Unban',
            confirmClass: action === 'ban' ? 'btn-danger' : 'btn-mint',
            onConfirm: async () => {
              try {
                const d = await api('/api/admin/users/' + id + '/ban', { method: 'POST', body: '{}' });
                flash('Member ' + mobile + ' is now ' + d.status + '.', true);
                refreshAll();
              } catch (e) { flash(e.message); }
            }
          });
        };
      });
    }

    // =========================================================
    // ADMIN MEMBER ACTIVATION & BINARY PLACEMENT LOGIC
    // =========================================================
    function openAdminActivateModal(opts = {}) {
      const modal = document.getElementById('modalAdminActivateUser');
      if (!modal) return;

      const idInput = document.getElementById('admActUserIdInput');
      const mobileText = document.getElementById('admActUserMobileText');
      const sponsorText = document.getElementById('admActUserSponsorText');
      const dropdownWrap = document.getElementById('admActMemberSelectWrap');
      const dropdown = document.getElementById('admActMemberDropdown');
      const parentInput = document.getElementById('admActParentMobileInput');
      const posSelect = document.getElementById('admActPositionSelect');
      const cardAuto = document.getElementById('cardPlaceAuto');
      const cardManual = document.getElementById('cardPlaceManual');
      const autoCodeCheck = document.getElementById('admActAutoCodeCheck');
      const customCodeWrap = document.getElementById('admActCustomCodeWrap');
      const customCodeInput = document.getElementById('admActCustomCodeInput');

      if (autoCodeCheck) autoCodeCheck.checked = true;
      if (customCodeWrap) customCodeWrap.style.display = 'none';
      if (customCodeInput) customCodeInput.value = '';

      // Populate inactive members dropdown
      const inactiveList = globalUsers.filter(u => u.status === 'inactive');
      if (dropdown) {
        dropdown.innerHTML = '<option value="">-- Choose Inactive Member --</option>' +
          inactiveList.map(u => {
            const isDir = !u.sponsor_mobile || u.sponsor_mobile === 'Toshi' || u.sponsor_id === 1;
            return `<option value="${u.id}" data-mobile="${esc(u.mobile_number)}" data-sponsor="${esc(u.sponsor_mobile || 'Admin')}">${esc(u.mobile_number)} (ID #${u.id}) ${isDir ? '★ Admin Direct' : '· Sponsor: ' + esc(u.sponsor_mobile)}</option>`;
          }).join('');
      }

      if (opts.id) {
        // Opened for specific member from Users table
        idInput.value = opts.id;
        mobileText.textContent = opts.mobile || '—';
        sponsorText.textContent = opts.sponsor || 'Admin';
        if (dropdownWrap) dropdownWrap.style.display = 'none';
        if (cardAuto) cardAuto.click();
      } else if (opts.parentId) {
        // Opened by clicking an empty slot in Genealogy Tree
        if (dropdownWrap) dropdownWrap.style.display = 'block';
        mobileText.textContent = 'Select from dropdown';
        sponsorText.textContent = 'Admin / Assigned';
        idInput.value = '';

        if (dropdown && dropdown.options.length > 1) {
          dropdown.selectedIndex = 1;
          const selectedOpt = dropdown.options[1];
          idInput.value = selectedOpt.value;
          mobileText.textContent = selectedOpt.dataset.mobile;
          sponsorText.textContent = selectedOpt.dataset.sponsor;
        }

        // Set manual placement with clicked slot pre-selected
        if (cardManual) cardManual.click();
        if (parentInput) parentInput.value = opts.parentMobile || opts.parentId;
        if (posSelect && opts.pos) posSelect.value = opts.pos;
      } else {
        idInput.value = '';
        if (dropdownWrap) dropdownWrap.style.display = 'block';
        mobileText.textContent = 'Select member';
        sponsorText.textContent = '—';
        if (cardAuto) cardAuto.click();
      }

      if (dropdown) {
        dropdown.onchange = () => {
          const sel = dropdown.options[dropdown.selectedIndex];
          if (sel && sel.value) {
            idInput.value = sel.value;
            mobileText.textContent = sel.dataset.mobile;
            sponsorText.textContent = sel.dataset.sponsor;
          } else {
            idInput.value = '';
            mobileText.textContent = 'Select member';
            sponsorText.textContent = '—';
          }
        };
      }

      modal.hidden = false;
      document.body.classList.add('modal-open');
    }

    function closeAdminActivateModal() {
      const modal = document.getElementById('modalAdminActivateUser');
      if (modal) modal.hidden = true;
      document.body.classList.remove('modal-open');
    }

    document.getElementById('btnCloseAdminActivateModal')?.addEventListener('click', closeAdminActivateModal);
    document.getElementById('closeAdminActivateBackdrop')?.addEventListener('click', closeAdminActivateModal);

    // Toggle Placement Mode Radio Cards
    document.querySelectorAll('input[name="admPlacementMode"]').forEach(radio => {
      radio.addEventListener('change', () => {
        const isAuto = radio.value === 'auto';
        document.getElementById('cardPlaceAuto')?.classList.toggle('active', isAuto);
        document.getElementById('cardPlaceManual')?.classList.toggle('active', !isAuto);
        const manualFields = document.getElementById('admManualPlacementFields');
        if (manualFields) manualFields.style.display = isAuto ? 'none' : 'block';
      });
    });
    document.getElementById('cardPlaceAuto')?.addEventListener('click', () => {
      const r = document.querySelector('input[name="admPlacementMode"][value="auto"]');
      if (r) { r.checked = true; r.dispatchEvent(new Event('change')); }
    });
    document.getElementById('cardPlaceManual')?.addEventListener('click', () => {
      const r = document.querySelector('input[name="admPlacementMode"][value="manual"]');
      if (r) { r.checked = true; r.dispatchEvent(new Event('change')); }
    });

    // Toggle Auto Code Checkbox
    document.getElementById('admActAutoCodeCheck')?.addEventListener('change', (e) => {
      const customWrap = document.getElementById('admActCustomCodeWrap');
      if (customWrap) customWrap.style.display = e.target.checked ? 'none' : 'block';
    });

    // Submit Admin Activation Form
    document.getElementById('formAdminActivateUser')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const userId = document.getElementById('admActUserIdInput').value;
      if (!userId) {
        flash('Please select an inactive member to activate.');
        return;
      }

      const mode = document.querySelector('input[name="admPlacementMode"]:checked')?.value || 'auto';
      const autoCode = document.getElementById('admActAutoCodeCheck')?.checked;
      const customCode = document.getElementById('admActCustomCodeInput')?.value.trim();
      const parentMobile = document.getElementById('admActParentMobileInput')?.value.trim();
      const position = document.getElementById('admActPositionSelect')?.value;

      const body = {
        auto_generate_code: autoCode,
        code: autoCode ? null : customCode,
      };

      if (mode === 'manual') {
        if (!parentMobile) {
          flash('Please enter a placement parent username or mobile number.');
          return;
        }
        body.placement_mobile = parentMobile;
        body.position = position;
      }

      const btn = document.getElementById('btnSubmitAdminActivate');
      btn.disabled = true;
      btn.textContent = 'Activating & Placing Member...';

      try {
        const res = await api(`/api/admin/users/${userId}/activate`, {
          method: 'POST',
          body: JSON.stringify(body)
        });

        closeAdminActivateModal();
        flash(`🎉 ${res.message || 'Member activated successfully!'}`, true);
        refreshAll();

        // If genealogy tree is open, refresh it too
        if (currentAdminTreeRootId) {
          fetchAndRenderAdminTree(currentAdminTreeRootId);
        }
      } catch (err) {
        flash(err.message || 'Failed to activate member.');
      } finally {
        btn.disabled = false;
        btn.textContent = '⚡ Activate Account & Place in Tree ➔';
      }
    });

    function renderCodes() {
      let list = globalCodes;
      if (codeFilterMode === 'available') list = list.filter((c) => c.status === 'available');
      else if (codeFilterMode === 'assigned') list = list.filter((c) => c.status === 'assigned');
      else if (codeFilterMode === 'used') list = list.filter((c) => c.status === 'used');

      const q = document.getElementById('codeSearch') ? document.getElementById('codeSearch').value.trim().toLowerCase() : '';
      if (q) {
        list = list.filter((c) =>
          String(c.id).includes(q) ||
          String(c.code).toLowerCase().includes(q) ||
          String(c.assigned_mobile || '').toLowerCase().includes(q) ||
          String(c.used_mobile || '').toLowerCase().includes(q) ||
          String(c.placement_parent_mobile || '').toLowerCase().includes(q) ||
          String(c.position || '').toLowerCase().includes(q)
        );
      }

      const countEl = document.getElementById('codeSearchCount');
      if (countEl) {
        countEl.textContent = list.length + ' of ' + globalCodes.length + ' codes';
      }

      // Live summary update on section header
      const availCount = globalCodes.filter((c) => c.status === 'available').length;
      const assignedCount = globalCodes.filter((c) => c.status === 'assigned').length;
      const usedCount = globalCodes.filter((c) => c.status === 'used').length;
      const summaryTag = document.getElementById('codeInventorySummaryTag');
      if (summaryTag) {
        summaryTag.textContent = `${availCount} Available · ${assignedCount} Assigned · ${usedCount} Used (${globalCodes.length} Total)`;
      }
      setSidebarBadge('badgeNavCodes', availCount);

      // Pagination calculation
      const totalItems = list.length;
      const effectiveSize = codePageSize === 'all' ? (totalItems || 1) : (Number(codePageSize) || 10);
      const totalPages = Math.max(1, Math.ceil(totalItems / effectiveSize));
      if (codeCurrentPage > totalPages) codeCurrentPage = totalPages;
      if (codeCurrentPage < 1) codeCurrentPage = 1;

      const startIdx = (codeCurrentPage - 1) * effectiveSize;
      const endIdx = codePageSize === 'all' ? totalItems : Math.min(startIdx + effectiveSize, totalItems);
      const pagedList = list.slice(startIdx, endIdx);

      // Update Pagination Bar UI
      const rangeText = document.getElementById('codePageRangeText');
      if (rangeText) {
        rangeText.textContent = totalItems === 0
          ? '0 codes found'
          : `Showing ${startIdx + 1}–${endIdx} of ${totalItems} codes (Page ${codeCurrentPage} of ${totalPages})`;
      }

      const btnPrev = document.getElementById('btnCodePrevPage');
      const btnNext = document.getElementById('btnCodeNextPage');
      if (btnPrev) btnPrev.disabled = codeCurrentPage <= 1;
      if (btnNext) btnNext.disabled = codeCurrentPage >= totalPages;

      const pageNums = document.getElementById('codePageNumbers');
      if (pageNums) {
        let pBtns = '';
        let startPage = Math.max(1, codeCurrentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

        for (let p = startPage; p <= endPage; p++) {
          const isCur = p === codeCurrentPage;
          pBtns += `<button type="button" class="btn btn-sm ${isCur ? 'btn-mint' : 'btn-ghost'}" data-codepage="${p}" style="padding:2px 8px;font-size:11px;min-width:26px;font-weight:${isCur ? '800' : '600'};">${p}</button>`;
        }
        pageNums.innerHTML = pBtns;
        pageNums.querySelectorAll('[data-codepage]').forEach((b) => {
          b.onclick = () => {
            codeCurrentPage = Number(b.dataset.codepage);
            renderCodes();
          };
        });
      }

      const tbody = document.getElementById('codeTableBody');
      const mobCards = document.getElementById('codeMobileCards');

      if (!list.length) {
        tbody.innerHTML = '<tr><td colspan="9" style="padding:24px;text-align:center" class="muted">No activation codes found matching this filter.</td></tr>';
        if (mobCards) mobCards.innerHTML = '<div style="padding:24px;text-align:center" class="muted">No activation codes found matching this filter.</div>';
        return;
      }

      tbody.innerHTML = pagedList.map((c) => {
        const badge = c.status === 'available'
          ? '<span class="badge-tag tag-available">Available</span>'
          : c.status === 'assigned'
            ? '<span class="badge-tag tag-assigned">Assigned to Seller</span>'
            : '<span class="badge-tag tag-used">Used / Active</span>';

        const assignedMobile = c.assigned_mobile ? '<strong style="color:var(--text);">' + esc(c.assigned_mobile) + '</strong>' : '<span class="muted">—</span>';
        const usedMobile = c.used_mobile ? '<strong style="color:var(--jade);">' + esc(c.used_mobile) + '</strong>' : '<span class="muted">—</span>';

        // Placement column
        let placementHtml = '<span class="muted">—</span>';
        if (c.status === 'used') {
          if (c.placement_parent_mobile) {
            const legBadge = c.position === 'L'
              ? '<span class="badge-tag tag-available" style="font-size:9.5px;padding:2px 6px;">◀ LEFT Leg</span>'
              : '<span class="badge-tag tag-assigned" style="font-size:9.5px;padding:2px 6px;">RIGHT Leg ▶</span>';
            placementHtml = '<div style="display:flex;flex-direction:column;gap:3px;">' +
              '<span class="tiny" style="font-weight:600;">Under ' + esc(c.placement_parent_mobile) + '</span>' +
              '<div>' + legBadge + '</div>' +
              '</div>';
          } else if (c.position) {
            placementHtml = c.position === 'L'
              ? '<span class="badge-tag tag-available" style="font-size:10px;">LEFT Leg</span>'
              : '<span class="badge-tag tag-assigned" style="font-size:10px;">RIGHT Leg</span>';
          }
        }

        const copyBtn = '<button type="button" class="btn-admin-copy" data-copy-code="' + esc(c.code) + '" title="Copy code to clipboard">📋 Copy</button>';

        const actionHtml = c.status !== 'used'
          ? '<button type="button" class="btn-admin-action btn-admin-reject" data-revoke-code="' + c.id + '" data-code-str="' + esc(c.code) + '" style="font-size:10.5px;padding:3px 8px;">Revoke</button>'
          : '<span class="tiny" style="color:var(--jade);font-weight:700;">✓ Encoded</span>';

        return '<tr>' +
          '<td><strong>#' + c.id + '</strong></td>' +
          '<td><div style="display:flex;align-items:center;gap:6px;"><code style="font-weight:700;font-size:13px;color:var(--jade);letter-spacing:0.04em;">' + esc(c.code) + '</code>' + copyBtn + '</div></td>' +
          '<td>' + badge + '</td>' +
          '<td>' + assignedMobile + '</td>' +
          '<td>' + usedMobile + '</td>' +
          '<td>' + placementHtml + '</td>' +
          '<td class="tiny muted">' + fmtDate(c.created_at) + '</td>' +
          '<td class="tiny muted">' + (c.used_at ? fmtDate(c.used_at) : '—') + '</td>' +
          '<td style="text-align:right">' + actionHtml + '</td>' +
          '</tr>';
      }).join('');

      if (mobCards) {
        mobCards.innerHTML = pagedList.map((c) => {
          const badge = c.status === 'available'
            ? '<span class="badge-tag tag-available">Available</span>'
            : c.status === 'assigned'
              ? '<span class="badge-tag tag-assigned">Assigned to Seller</span>'
              : '<span class="badge-tag tag-used">Used / Active</span>';

          const assignedMobile = c.assigned_mobile ? '<strong style="color:var(--text);">' + esc(c.assigned_mobile) + '</strong>' : '<span class="muted">—</span>';
          const usedMobile = c.used_mobile ? '<strong style="color:var(--jade);">' + esc(c.used_mobile) + '</strong>' : '<span class="muted">—</span>';

          let placementHtml = '<span class="muted">—</span>';
          if (c.status === 'used') {
            if (c.placement_parent_mobile) {
              const legBadge = c.position === 'L'
                ? '<span class="badge-tag tag-available" style="font-size:9px;padding:1px 5px;">◀ LEFT</span>'
                : '<span class="badge-tag tag-assigned" style="font-size:9px;padding:1px 5px;">RIGHT ▶</span>';
              placementHtml = `<div style="display:flex;align-items:center;gap:4px;"><span>Under <strong>${esc(c.placement_parent_mobile)}</strong></span>${legBadge}</div>`;
            } else if (c.position) {
              placementHtml = c.position === 'L' ? '<span class="badge-tag tag-available" style="font-size:9.5px;">LEFT Leg</span>' : '<span class="badge-tag tag-assigned" style="font-size:9.5px;">RIGHT Leg</span>';
            }
          }

          const copyBtn = '<button type="button" class="btn-admin-copy" data-copy-code="' + esc(c.code) + '" style="padding:4px 10px;font-size:11px;">📋 Copy</button>';
          const actionHtml = c.status !== 'used'
            ? '<button type="button" class="btn-admin-action btn-admin-reject" data-revoke-code="' + c.id + '" data-code-str="' + esc(c.code) + '" style="padding:6px 12px;font-size:11px;">Revoke Code</button>'
            : '<span class="tiny" style="color:var(--jade);font-weight:700;">✓ Encoded in Tree</span>';

          return `
            <div class="admin-mob-card">
              <div class="admin-mob-card-head">
                <div style="display:flex;align-items:center;gap:6px;">
                  <strong style="font-size:13px;color:var(--jade);">#${c.id}</strong>
                  ${badge}
                </div>
                <span class="tiny muted">${fmtDate(c.created_at)}</span>
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;background:rgba(46,213,158,0.08);border:1px solid rgba(46,213,158,0.25);border-radius:10px;padding:8px 12px;">
                <code style="font-weight:800;font-size:15px;color:var(--jade);letter-spacing:0.06em;">${esc(c.code)}</code>
                ${copyBtn}
              </div>
              <div class="admin-mob-card-grid">
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Assigned Seller</span>
                  <span class="admin-mob-card-val">${assignedMobile}</span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Used By Member</span>
                  <span class="admin-mob-card-val">${usedMobile}</span>
                </div>
                <div class="admin-mob-card-field full">
                  <span class="admin-mob-card-label">Genealogy Placement</span>
                  <span class="admin-mob-card-val">${placementHtml}</span>
                </div>
              </div>
              ${c.status !== 'used' ? `
                <div class="admin-mob-card-actions">
                  ${actionHtml}
                </div>
              ` : ''}
            </div>
          `;
        }).join('');
      }

      // Wire copy buttons
      document.querySelectorAll('button[data-copy-code]').forEach((btn) => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const txt = btn.dataset.copyCode;
          navigator.clipboard.writeText(txt).then(() => {
            const orig = btn.innerHTML;
            btn.innerHTML = '✓ Copied!';
            btn.style.color = 'var(--jade)';
            btn.style.borderColor = 'var(--jade)';
            setTimeout(() => {
              btn.innerHTML = orig;
              btn.style.color = '';
              btn.style.borderColor = '';
            }, 2000);
          }).catch(() => {
            prompt('Copy Code:', txt);
          });
        };
      });

      // Wire revoke buttons
      document.querySelectorAll('button[data-revoke-code]').forEach((btn) => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const id = btn.dataset.revokeCode;
          const codeStr = btn.dataset.codeStr;
          showAdminConfirm({
            title: 'Revoke Activation Code',
            subtitle: 'Delete this code permanently from inventory.',
            icon: '⚠️',
            summary: `Are you sure you want to revoke code <strong style="color:var(--jade);font-family:ui-monospace,monospace;">${esc(codeStr)}</strong> (#${id})?`,
            details: [
              { label: 'Code ID', val: '#' + id },
              { label: 'Activation Code', val: codeStr, highlight: true }
            ],
            confirmText: 'Revoke & Delete Code',
            confirmClass: 'btn-danger',
            onConfirm: async () => {
              try {
                await api('/api/admin/codes/' + id, { method: 'DELETE' });
                flash('Code ' + codeStr + ' revoked and deleted.', true);
                refreshAll();
              } catch (err) {
                flash(err.message);
              }
            }
          });
        };
      });
    }

    function renderTradein() {
      const tbody = document.getElementById('tradeinTableBody');
      const mobCards = document.getElementById('tradeinMobileCards');
      const activeCount = globalTradein.filter(p => p.cycle_status === 'active').length;
      const pendingCount = globalTradein.filter(p => p.cycle_status === 'pending').length;

      document.getElementById('tradeinSummaryText').textContent = `${globalTradein.length} Total Packages (${pendingCount} Pending · ${activeCount} Active)`;

      const bTradein = document.getElementById('badgeNavTradein');
      setSidebarBadge('badgeNavTradein', pendingCount, true);

      const badgePendingEl = document.getElementById('badgePendingTradein');
      if (badgePendingEl) badgePendingEl.textContent = pendingCount;

      let list = globalTradein;
      if (tradeinFilterMode === 'pending') list = list.filter(p => p.cycle_status === 'pending');
      else if (tradeinFilterMode === 'active') list = list.filter(p => p.cycle_status === 'active');
      else if (tradeinFilterMode === 'completed') list = list.filter(p => p.cycle_status === 'completed');
      else if (tradeinFilterMode === 'rejected') list = list.filter(p => p.cycle_status === 'rejected');

      const q = document.getElementById('tradeinSearch') ? document.getElementById('tradeinSearch').value.trim().toLowerCase() : '';
      if (q) {
        list = list.filter(p =>
          String(p.id).includes(q) ||
          String(p.mobile_number || '').toLowerCase().includes(q) ||
          String(p.payment_method || '').toLowerCase().includes(q) ||
          String(p.ref_number || '').toLowerCase().includes(q)
        );
      }

      if (!list.length) {
        tbody.innerHTML = '<tr><td colspan="10" style="padding:24px;text-align:center" class="muted">No trade-in packages found matching this filter.</td></tr>';
        if (mobCards) mobCards.innerHTML = '<div style="padding:24px;text-align:center;" class="muted">No trade-in packages found matching this filter.</div>';
        return;
      }

      tbody.innerHTML = list.map((p) => {
        const isPending = p.cycle_status === 'pending';
        const isActive = p.cycle_status === 'active';
        const isCompleted = p.cycle_status === 'completed';
        const isRejected = p.cycle_status === 'rejected';

        const badge = isPending
          ? '<span class="badge-tag tag-expired">Pending Verification</span>'
          : isActive
            ? '<span class="badge-tag tag-active">Active Cycle</span>'
            : isCompleted
              ? '<span class="badge-tag tag-approved">Completed</span>'
              : '<span class="badge-tag tag-rejected">Rejected</span>';

        const payouts = (p.payouts_completed || 0) + ' / 4 payouts';

        const methodBadge = p.payment_method ? `<span class="badge-tag tag-available" style="font-size:9.5px;padding:2px 6px;">${esc(p.payment_method)}</span>` : '<span class="muted">—</span>';
        const refTag = p.ref_number ? `<code style="font-size:11px;font-weight:700;color:var(--jade);display:block;margin-top:2px;">${esc(p.ref_number)}</code>` : '';
        const methodCol = `<div>${methodBadge}${refTag}</div>`;

        const hasReceipt = Boolean(p.receipt_image || p.receipt_url);
        const receiptBtn = hasReceipt
          ? `<button type="button" class="receipt-view-btn" data-tradein-pkg-id="${p.id}" title="Click to view uploaded receipt screenshot">🧾 View Receipt</button>`
          : '<span class="muted tiny">No receipt</span>';

        const actions = isPending
          ? `<button type="button" class="btn-admin-action btn-admin-approve" data-tradein-approve="${p.id}" data-pkg-user="${esc(p.mobile_number)}" data-pkg-cap="${p.capital}" style="margin-right:6px;">✓ Approve</button>` +
            `<button type="button" class="btn-admin-action btn-admin-reject" data-tradein-reject="${p.id}" data-pkg-user="${esc(p.mobile_number)}">✕ Reject</button>`
          : `<span class="tiny muted">${esc(p.cycle_status)}</span>`;

        return `<tr>
          <td><strong>#${p.id}</strong></td>
          <td><strong>${esc(p.mobile_number)}</strong></td>
          <td style="font-weight:600;">${peso(p.capital)}</td>
          <td style="color:var(--jade);font-weight:700;">${peso(p.total_return)}</td>
          <td>${methodCol}</td>
          <td>${receiptBtn}</td>
          <td>${payouts}</td>
          <td>${badge}</td>
          <td class="tiny muted">${fmtDate(p.created_at || p.start_date)}</td>
          <td style="text-align:right;">${actions}</td>
        </tr>`;
      }).join('');

      // Mobile Touch-Friendly Cards View (<= 768px)
      if (mobCards) {
        mobCards.innerHTML = list.map((p) => {
          const isPending = p.cycle_status === 'pending';
          const isActive = p.cycle_status === 'active';
          const isCompleted = p.cycle_status === 'completed';

          const badge = isPending
            ? '<span class="badge-tag tag-expired">Pending Verification</span>'
            : isActive
              ? '<span class="badge-tag tag-active">Active</span>'
              : isCompleted
                ? '<span class="badge-tag tag-approved">Completed</span>'
                : '<span class="badge-tag tag-rejected">Rejected</span>';

          const payouts = (p.payouts_completed || 0) + ' / 4 payouts';

          const methodBadge = p.payment_method ? `<span class="badge-tag tag-available" style="font-size:9.5px;padding:2px 6px;">${esc(p.payment_method)}</span>` : '<span class="muted">—</span>';
          const refTag = p.ref_number ? `<code style="font-size:11px;font-weight:700;color:var(--jade);display:inline-block;margin-left:4px;">${esc(p.ref_number)}</code>` : '';
          const methodCol = `<span>${methodBadge}${refTag}</span>`;

          const hasReceipt = Boolean(p.receipt_image || p.receipt_url);
          const receiptBtn = hasReceipt
            ? `<button type="button" class="receipt-view-btn" data-tradein-pkg-id="${p.id}" style="padding:4px 10px;font-size:11.5px;font-weight:700;">🧾 View Receipt</button>`
            : '<span class="muted tiny">No receipt</span>';

          return `
            <div class="admin-mob-card ${isPending ? 'pending' : ''}">
              <div class="admin-mob-card-head">
                <div style="display:flex;align-items:center;gap:6px;">
                  <strong style="font-size:13.5px;color:var(--jade);">#${p.id}</strong>
                  ${badge}
                </div>
                <span class="tiny muted">${fmtDate(p.created_at || p.start_date)}</span>
              </div>
              <div class="admin-mob-card-grid">
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Member</span>
                  <span class="admin-mob-card-val"><strong>${esc(p.mobile_number)}</strong></span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Capital</span>
                  <span class="admin-mob-card-val" style="font-weight:700;color:var(--text);">${peso(p.capital)}</span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Total Return</span>
                  <span class="admin-mob-card-val" style="color:var(--jade);font-weight:700;">${peso(p.total_return)}</span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Progress</span>
                  <span class="admin-mob-card-val">${payouts}</span>
                </div>
                <div class="admin-mob-card-field full">
                  <span class="admin-mob-card-label">Payment Channel</span>
                  <span class="admin-mob-card-val" style="display:flex;align-items:center;gap:6px;">${methodCol}</span>
                </div>
                <div class="admin-mob-card-field full">
                  <span class="admin-mob-card-label">Proof of Deposit</span>
                  <span class="admin-mob-card-val">${receiptBtn}</span>
                </div>
              </div>
              ${isPending ? `
                <div class="admin-mob-card-actions">
                  <button type="button" class="btn-admin-action btn-admin-approve" data-tradein-approve="${p.id}" data-pkg-user="${esc(p.mobile_number)}" data-pkg-cap="${p.capital}">✓ Approve Deposit</button>
                  <button type="button" class="btn-admin-action btn-admin-reject" data-tradein-reject="${p.id}" data-pkg-user="${esc(p.mobile_number)}">✕ Reject</button>
                </div>
              ` : ''}
            </div>
          `;
        }).join('');
      }

      // Wire receipt inspection via in-memory lookup + endpoint fallback
      document.querySelectorAll('button[data-tradein-pkg-id]').forEach(btn => {
        btn.onclick = async (e) => {
          e.stopPropagation();
          const pkgId = Number(btn.dataset.tradeinPkgId);
          const pkg = globalTradein.find(x => x.id === pkgId);
          if (!pkg) return;

          let src = pkg.receipt_image || pkg.receipt_url;
          if (!src) {
            try {
              btn.textContent = 'Loading...';
              const res = await api(`/api/admin/tradein/${pkgId}/receipt`);
              if (res && (res.receipt_image || res.receipt_url)) {
                src = res.receipt_image || res.receipt_url;
                pkg.receipt_image = src;
                pkg.receipt_url = src;
              }
            } catch (err) {
              console.error(err);
            } finally {
              btn.textContent = '🧾 View Receipt';
            }
          }

          if (!src) {
            flash(`No uploaded receipt screenshot found for package #${pkgId}.`);
            return;
          }

          openReceiptLightbox(src, `Trade-In Payment Receipt · #${pkg.id} · ${esc(pkg.mobile_number)} (${peso(pkg.capital)})`, pkg);
        };
      });

      // Wire Approve with Confirmation
      document.querySelectorAll('button[data-tradein-approve]').forEach(btn => {
        btn.onclick = () => {
          const id = Number(btn.dataset.tradeinApprove);
          const userMob = btn.dataset.pkgUser;
          const capital = Number(btn.dataset.pkgCap);
          const pkg = globalTradein.find(x => x.id === id);
          const hasRec = pkg && (pkg.receipt_image || pkg.receipt_url);

          const receiptHtml = hasRec
            ? `<button type="button" class="receipt-view-btn" id="btnViewReceiptInConfirm" style="padding:3px 10px;font-size:11.5px;font-weight:700;">🧾 Inspect Receipt Proof</button>`
            : '<span class="muted tiny">No receipt uploaded</span>';

          showAdminConfirm({
            title: 'Approve Trade-In Deposit',
            subtitle: 'Activate the 12-day investment cycle and disburse referral bonuses.',
            icon: '✅',
            details: [
              { label: 'Package ID', val: '#' + id },
              { label: 'Member Username', val: userMob, highlight: true },
              { label: 'Capital Deposited', val: peso(capital), highlight: true },
              { label: 'Total Return (120%)', val: peso(capital * 1.2) },
              { label: 'Sponsor Bonus (5%)', val: peso(capital * 0.05) },
              { label: 'Receipt Proof', html: receiptHtml }
            ],
            confirmText: 'Approve & Activate Cycle ➔',
            confirmClass: 'btn-mint',
            onConfirm: async () => {
              try {
                await api(`/api/admin/tradein/${id}/approve`, { method: 'POST', body: '{}' });
                flash(`✓ Trade-In package #${id} for ${userMob} approved and activated!`, true);
                refreshAll();
              } catch (err) {
                flash(err.message);
              }
            }
          });

          // Wire inspect button inside confirm popup
          const btnInspectInModal = document.getElementById('btnViewReceiptInConfirm');
          if (btnInspectInModal && hasRec) {
            btnInspectInModal.onclick = (e) => {
              e.stopPropagation();
              openReceiptLightbox(pkg.receipt_image || pkg.receipt_url, `Trade-In Payment Receipt · #${pkg.id} · ${esc(userMob)} (${peso(capital)})`, pkg);
            };
          }
        };
      });

      // Wire Reject with Confirmation
      document.querySelectorAll('button[data-tradein-reject]').forEach(btn => {
        btn.onclick = () => {
          const id = btn.dataset.tradeinReject;
          const userMob = btn.dataset.pkgUser;

          showAdminConfirm({
            title: 'Reject Trade-In Deposit',
            subtitle: 'Mark this trade-in deposit as rejected.',
            icon: '✕',
            summary: `Reject deposit request <strong>#${id}</strong> for member <strong>${esc(userMob)}</strong>?`,
            details: [
              { label: 'Package ID', val: '#' + id },
              { label: 'Member Mobile', val: userMob }
            ],
            confirmText: 'Reject Deposit',
            confirmClass: 'btn-danger',
            onConfirm: async () => {
              try {
                await api(`/api/admin/tradein/${id}/reject`, {
                  method: 'POST',
                  body: JSON.stringify({ reason: 'Invalid proof of payment or rejected by admin.' }),
                });
                flash(`Trade-In package #${id} marked as rejected.`, true);
                refreshAll();
              } catch (err) {
                flash(err.message);
              }
            }
          });
        };
      });
    }

    function renderHomePendingQueue() {
      const container = document.getElementById('homePendingQueue');
      if (!container) return;

      const pendingTradein = globalTradein.filter(p => p.cycle_status === 'pending');
      const pendingWd = globalWithdrawals.filter(w => w.status === 'pending');
      const pendingLoad = globalLoadWallets.filter(lw => lw.status === 'pending');
      const totalPending = pendingTradein.length + pendingWd.length + pendingLoad.length;

      if (totalPending === 0) {
        container.innerHTML = `
          <div style="padding:22px;text-align:center;background:var(--bg2, #162029);border:1px dashed var(--line, rgba(255,255,255,0.12));border-radius:12px;">
            <span style="font-size:24px;display:block;margin-bottom:6px;">🎉</span>
            <strong style="color:var(--jade, #2ed59e);font-size:13.5px;">All Caught Up!</strong>
            <p class="tiny muted" style="margin:4px 0 0;">No pending trade-in deposits, cashout releases, or load wallet orders requiring verification.</p>
          </div>
        `;
        return;
      }

      let html = '';

      // 1. Pending Trade-In Deposits
      pendingTradein.forEach(p => {
        const hasReceipt = Boolean(p.receipt_image || p.receipt_url);
        const receiptBtn = hasReceipt
          ? `<button type="button" class="receipt-view-btn" data-tradein-pkg-id="${p.id}" style="padding:4px 10px;font-size:11.5px;font-weight:700;">🧾 View Receipt</button>`
          : '<span class="muted tiny">No receipt</span>';

        html += `
          <div class="home-pending-card">
            <div style="display:flex;align-items:flex-start;gap:10px;flex:1;">
              <span style="font-size:22px;line-height:1;margin-top:2px;">📥</span>
              <div style="flex:1;">
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:3px;">
                  <span class="badge-tag tag-expired" style="font-size:10px;font-weight:700;">Trade-In Deposit</span>
                  <strong style="font-size:13px;color:var(--jade);">#${p.id} · ${esc(p.mobile_number)}</strong>
                  <span class="tiny muted">• ${fmtDate(p.created_at || p.start_date)}</span>
                </div>
                <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;font-size:12px;margin-top:4px;">
                  <span>Capital: <strong style="color:var(--text);">${peso(p.capital)}</strong></span>
                  <span>120% Return: <strong style="color:var(--jade);">${peso(p.total_return)}</strong></span>
                  <span>Method: <code style="font-weight:700;color:var(--jade);">${esc(p.payment_method || '—')}</code></span>
                  <span>Proof: ${receiptBtn}</span>
                </div>
              </div>
            </div>
            <div style="display:flex;gap:6px;align-items:center;margin-top:8px;justify-content:flex-end;">
              <button type="button" class="btn-admin-action btn-admin-approve" data-tradein-approve="${p.id}" data-pkg-user="${esc(p.mobile_number)}" data-pkg-cap="${p.capital}" style="padding:6px 14px;font-size:12px;">✓ Approve</button>
              <button type="button" class="btn-admin-action btn-admin-reject" data-tradein-reject="${p.id}" data-pkg-user="${esc(p.mobile_number)}" style="padding:6px 12px;font-size:12px;">✕ Reject</button>
            </div>
          </div>
        `;
      });

      // 2. Pending Cashout Releases
      pendingWd.forEach(w => {
        const iconImg = getPayoutImg(w.payout_method, 22);
        const accNum = w.account_number && w.account_number !== '—' ? esc(w.account_number) : '';
        const copyBtn = accNum
          ? `<button type="button" class="btn-admin-copy" data-copy-acc="${accNum}" style="padding:2px 8px;font-size:11px;">📋 Copy</button>`
          : '';

        const walletBadge = w.wallet_type === 'binary_ref'
          ? '<span class="badge-tag tag-cat-binary" style="font-size:9.5px;">Binary</span>'
          : w.wallet_type === 'tradein_ref'
            ? '<span class="badge-tag tag-cat-traderef" style="font-size:9.5px;">Trade-In Ref</span>'
            : '<span class="badge-tag tag-cat-cycle" style="font-size:9.5px;">Cycle</span>';

        html += `
          <div class="home-pending-card">
            <div style="display:flex;align-items:flex-start;gap:10px;flex:1;">
              <span style="font-size:22px;line-height:1;margin-top:2px;">💸</span>
              <div style="flex:1;">
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:3px;">
                  <span class="badge-tag tag-pending" style="font-size:10px;font-weight:700;">Cashout Release</span>
                  ${walletBadge}
                  <strong style="font-size:13px;color:var(--jade);">#${w.id} · ${esc(w.mobile_number)}</strong>
                  <span class="tiny muted">• ${fmtDate(w.created_at)}</span>
                </div>
                <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-size:12px;margin-top:4px;">
                  <div style="display:inline-flex;align-items:center;gap:4px;">
                    ${iconImg}
                    <strong style="color:var(--text);">${esc(w.account_name || '—')}</strong>
                    ${accNum ? `<code style="font-weight:700;color:var(--jade);background:rgba(46,213,158,0.12);padding:2px 6px;border-radius:4px;">${accNum}</code>${copyBtn}` : ''}
                  </div>
                  <div class="amount-release-box" style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;margin:0;">
                    <span style="font-size:11px;color:var(--jade);font-weight:700;">RELEASE:</span>
                    <span class="amount-release-val" style="font-size:15px;">${peso(w.net_amount)}</span>
                    <span class="amount-release-less" style="margin:0;font-size:10.5px;">(Gross ${peso(w.amount)} - ${peso(w.fee)} tax)</span>
                  </div>
                </div>
              </div>
            </div>
            <div style="display:flex;gap:6px;align-items:center;margin-top:8px;justify-content:flex-end;">
              <button type="button" data-wd-id="${w.id}" data-wd-act="approve" class="btn-admin-action btn-admin-approve" style="padding:6px 14px;font-size:12px;">✓ Approve</button>
              <button type="button" data-wd-id="${w.id}" data-wd-act="reject" class="btn-admin-action btn-admin-reject" style="padding:6px 12px;font-size:12px;">✕ Reject</button>
            </div>
          </div>
        `;
      });

      // 3. Pending Load Wallet Orders
      pendingLoad.forEach(lw => {
        const receiptBtn = lw.receipt_image
          ? `<button type="button" class="receipt-view-btn" data-lw-receipt-id="${lw.id}" style="padding:4px 10px;font-size:11.5px;font-weight:700;">🧾 View Receipt</button>`
          : '<span class="muted tiny">No receipt</span>';

        html += `
          <div class="home-pending-card">
            <div style="display:flex;align-items:flex-start;gap:10px;flex:1;">
              <span style="font-size:22px;line-height:1;margin-top:2px;">📱</span>
              <div style="flex:1;">
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:3px;">
                  <span class="badge-tag tag-available" style="font-size:10px;font-weight:700;background:var(--accent-mint);color:#08281d;">Load Wallet Order</span>
                  <strong style="font-size:13px;color:var(--text);">#LW${lw.id} · ${esc(lw.username || lw.user_mobile)}</strong>
                  <span class="tiny muted">• ${fmtDate(lw.created_at)}</span>
                </div>
                <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;font-size:12px;margin-top:4px;">
                  <span>Amount: <strong style="color:var(--accent-mint);">${peso(lw.amount)}</strong></span>
                  <span>Target SIM: <code style="font-weight:800;color:var(--text);">${esc(lw.phone_number)}</code></span>
                  <span>Method: <code style="font-weight:700;">${esc(lw.payment_method || '—')}</code></span>
                  <span>Proof: ${receiptBtn}</span>
                </div>
              </div>
            </div>
            <div style="display:flex;gap:6px;align-items:center;margin-top:8px;justify-content:flex-end;">
              <button type="button" class="btn-admin-action btn-admin-approve" data-quick-approve-lw="${lw.id}" style="padding:6px 14px;font-size:12px;">✓ Approve</button>
              <button type="button" class="btn-admin-action btn-admin-reject" data-quick-reject-lw="${lw.id}" style="padding:6px 12px;font-size:12px;">✕ Reject</button>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;

      // Re-attach listeners for buttons inside homePendingQueue
      container.querySelectorAll('button[data-tradein-pkg-id]').forEach(btn => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const pkgId = Number(btn.dataset.tradeinPkgId);
          const pkg = globalTradein.find(x => x.id === pkgId);
          if (pkg && (pkg.receipt_image || pkg.receipt_url)) {
            openReceiptLightbox(pkg.receipt_image || pkg.receipt_url, `Trade-In Payment Receipt · #${pkg.id} · ${esc(pkg.mobile_number)} (${peso(pkg.capital)})`, pkg);
          }
        };
      });

      container.querySelectorAll('button[data-tradein-approve]').forEach(btn => {
        btn.onclick = () => {
          const id = Number(btn.dataset.tradeinApprove);
          const userMob = btn.dataset.pkgUser;
          const capital = Number(btn.dataset.pkgCap);
          const pkg = globalTradein.find(x => x.id === id);
          const hasRec = pkg && (pkg.receipt_image || pkg.receipt_url);

          const receiptHtml = hasRec
            ? `<button type="button" class="receipt-view-btn" id="btnViewReceiptInConfirmHome" style="padding:3px 10px;font-size:11.5px;font-weight:700;">🧾 Inspect Receipt Proof</button>`
            : '<span class="muted tiny">No receipt uploaded</span>';

          showAdminConfirm({
            title: 'Approve Trade-In Deposit',
            subtitle: 'Activate the 12-day investment cycle and disburse referral bonuses.',
            icon: '✅',
            details: [
              { label: 'Package ID', val: '#' + id },
              { label: 'Member Username', val: userMob, highlight: true },
              { label: 'Capital Deposited', val: peso(capital), highlight: true },
              { label: 'Total Return (120%)', val: peso(capital * 1.2) },
              { label: 'Sponsor Bonus (5%)', val: peso(capital * 0.05) },
              { label: 'Receipt Proof', html: receiptHtml }
            ],
            confirmText: 'Approve & Activate Cycle ➔',
            confirmClass: 'btn-mint',
            onConfirm: async () => {
              try {
                await api(`/api/admin/tradein/${id}/approve`, { method: 'POST', body: '{}' });
                flash(`✓ Trade-In package #${id} for ${userMob} approved and activated!`, true);
                refreshAll();
              } catch (err) {
                flash(err.message);
              }
            }
          });

          const btnInspectInModal = document.getElementById('btnViewReceiptInConfirmHome');
          if (btnInspectInModal && hasRec) {
            btnInspectInModal.onclick = (e) => {
              e.stopPropagation();
              openReceiptLightbox(pkg.receipt_image || pkg.receipt_url, `Trade-In Payment Receipt · #${pkg.id} · ${esc(userMob)} (${peso(capital)})`, pkg);
            };
          }
        };
      });

      container.querySelectorAll('button[data-tradein-reject]').forEach(btn => {
        btn.onclick = () => {
          const id = btn.dataset.tradeinReject;
          const userMob = btn.dataset.pkgUser;

          showAdminConfirm({
            title: 'Reject Trade-In Deposit',
            subtitle: 'Mark this trade-in deposit as rejected.',
            icon: '✕',
            summary: `Reject deposit request <strong>#${id}</strong> for member <strong>${esc(userMob)}</strong>?`,
            details: [
              { label: 'Package ID', val: '#' + id },
              { label: 'Member Mobile', val: userMob }
            ],
            confirmText: 'Reject Deposit',
            confirmClass: 'btn-danger',
            onConfirm: async () => {
              try {
                await api(`/api/admin/tradein/${id}/reject`, {
                  method: 'POST',
                  body: JSON.stringify({ reason: 'Invalid proof of payment or rejected by admin.' }),
                });
                flash(`Trade-In package #${id} marked as rejected.`, true);
                refreshAll();
              } catch (err) {
                flash(err.message);
              }
            }
          });
        };
      });

      container.querySelectorAll('button[data-copy-acc]').forEach((btn) => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const txt = btn.dataset.copyAcc;
          navigator.clipboard.writeText(txt).then(() => {
            const orig = btn.innerHTML;
            btn.innerHTML = '✓ Copied!';
            setTimeout(() => { btn.innerHTML = orig; }, 2000);
          }).catch(() => { prompt('Copy Account Number:', txt); });
        };
      });

      container.querySelectorAll('button[data-wd-id]').forEach((btn) => {
        btn.onclick = () => {
          const id = btn.dataset.wdId;
          const act = btn.dataset.wdAct;
          const req = globalWithdrawals.find(x => String(x.id) === String(id)) || {};
          const isApprove = act === 'approve';

          const releasePill = `
            <div style="background:rgba(46,213,158,0.12);border:1.5px solid rgba(46,213,158,0.35);border-radius:8px;padding:6px 12px;display:inline-block;">
              <span style="font-size:15px;font-weight:800;color:var(--jade);">${peso(req.net_amount || 0)}</span>
              <span style="font-size:11px;color:var(--muted);font-weight:700;display:block;">(Already less tax/fee of ${peso(req.fee || 0)})</span>
            </div>
          `;

          showAdminConfirm({
            title: isApprove ? 'Approve Cashout & Release Funds' : 'Reject Cashout Request',
            subtitle: isApprove ? 'Confirm release of net payout to destination account.' : 'Reject cashout and refund balance to member.',
            icon: isApprove ? '💸' : '✕',
            details: [
              { label: 'Request ID', val: '#' + id },
              { label: 'Member', val: req.mobile_number || '—' },
              { label: 'Wallet Type', val: (req.wallet_type || '—').toUpperCase() },
              { label: 'Payout Method', val: req.payout_method || '—' },
              { label: 'Account Name', val: req.account_name || '—' },
              { label: 'Account Number', val: req.account_number || '—' },
              { label: 'Gross Requested', val: peso(req.amount || 0) },
              { label: 'Processing Fee (Tax)', val: '-' + peso(req.fee || 0) },
              { label: 'AMOUNT TO RELEASE (NET)', html: releasePill, highlight: true }
            ],
            confirmText: isApprove ? 'Confirm Approval & Release ➔' : 'Confirm Rejection',
            confirmClass: isApprove ? 'btn-mint' : 'btn-danger',
            onConfirm: async () => {
              try {
                await api('/api/admin/withdrawals/' + id + '/review', {
                  method: 'POST',
                  body: JSON.stringify({ action: act }),
                });
                flash('Withdrawal #' + id + ' ' + act + 'd successfully.', true);
                refreshAll();
              } catch (e) { flash(e.message); }
            }
          });
        };
      });

      // Quick listeners for Load Wallet in Home Pending Queue
      container.querySelectorAll('button[data-lw-receipt-id]').forEach(btn => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const id = Number(btn.dataset.lwReceiptId);
          const lw = globalLoadWallets.find(x => x.id === id);
          if (lw && lw.receipt_image) {
            openReceiptLightbox(lw.receipt_image, `Load Wallet Receipt · #LW${lw.id} · ${lw.phone_number} (${peso(lw.amount)})`);
          }
        };
      });

      container.querySelectorAll('button[data-quick-approve-lw]').forEach(btn => {
        btn.onclick = () => {
          const id = Number(btn.dataset.quickApproveLw);
          const lw = globalLoadWallets.find(x => x.id === id);
          if (!lw) return;
          showAdminConfirm({
            title: `Approve Load Wallet Order #LW${lw.id}`,
            subtitle: `Confirm credit dispatch to Retailer SIM: ${lw.phone_number}`,
            icon: '📱',
            details: [
              { label: 'Amount', val: peso(lw.amount), highlight: true },
              { label: 'Target Number', val: lw.phone_number },
              { label: 'Member', val: `${lw.username || 'User #' + lw.user_id} (${lw.user_mobile || ''})` },
            ],
            confirmText: 'Approve & Confirm Sent ➔',
            confirmClass: 'btn-mint',
            onConfirm: async () => {
              try {
                await api(`/api/admin/load-wallet/${id}/approve`, {
                  method: 'POST',
                  body: JSON.stringify({ notes: 'Approved via quick queue' })
                });
                flash(`✓ Order #LW${id} approved successfully!`, true);
                refreshAll();
              } catch (err) {
                flash('Error: ' + err.message);
              }
            }
          });
        };
      });

      container.querySelectorAll('button[data-quick-reject-lw]').forEach(btn => {
        btn.onclick = () => {
          const id = Number(btn.dataset.quickRejectLw);
          const reason = prompt('Please enter rejection reason:', 'Invalid payment receipt');
          if (reason === null) return;
          api(`/api/admin/load-wallet/${id}/reject`, {
            method: 'POST',
            body: JSON.stringify({ notes: reason || 'Rejected via quick queue' })
          }).then(() => {
            flash(`Order #LW${id} rejected.`, true);
            refreshAll();
          }).catch(err => flash('Error: ' + err.message));
        };
      });
    }

    function getPayoutImg(method, size = 22) {
      const m = String(method || '').toLowerCase();
      let file = 'GCash.png';
      let alt = 'GCash';
      if (m.includes('maya')) { file = 'Maya.png'; alt = 'Maya'; }
      else if (m.includes('gotyme')) { file = 'Gotyme.png'; alt = 'GoTyme'; }
      else if (m.includes('maribank')) { file = 'Maribank.png'; alt = 'MariBank'; }
      else if (m.includes('ub') || m.includes('unionbank')) { file = 'UnionBank.png'; alt = 'UnionBank'; }

      return `<img src="/images/${file}" alt="${alt}" style="width:${size}px;height:${size}px;object-fit:contain;vertical-align:middle;display:inline-block;flex-shrink:0;" />`;
    }

    function renderWithdrawals() {
      // 1. Update Sub-Tab Counts
      const countAll = globalWithdrawals.length;
      const countBinary = globalWithdrawals.filter((w) => w.wallet_type === 'binary_ref').length;
      const countTradeRef = globalWithdrawals.filter((w) => w.wallet_type === 'tradein_ref').length;
      const countCycle = globalWithdrawals.filter((w) => w.wallet_type === 'tradein_cycle').length;
      const countPending = globalWithdrawals.filter((w) => w.status === 'pending').length;

      const elAll = document.getElementById('countWdAll');
      const elBinary = document.getElementById('countWdBinary');
      const elTradeRef = document.getElementById('countWdTradeRef');
      const elCycle = document.getElementById('countWdCycle');
      const elPending = document.getElementById('countWdPending');

      if (elAll) elAll.textContent = countAll;
      if (elBinary) elBinary.textContent = countBinary;
      if (elTradeRef) elTradeRef.textContent = countTradeRef;
      if (elCycle) elCycle.textContent = countCycle;
      if (elPending) elPending.textContent = countPending;
      setSidebarBadge('badgeNavWd', countPending, true);

      // 2. Update 3 Category Summary Cards
      const binPendingList = globalWithdrawals.filter((w) => w.wallet_type === 'binary_ref' && w.status === 'pending');
      const binPendingNet = binPendingList.reduce((s, w) => s + (Number(w.net_amount) || 0), 0);
      const sumBinNet = document.getElementById('sumWdBinaryNet');
      const sumBinPending = document.getElementById('sumWdBinaryPending');
      if (sumBinNet) sumBinNet.textContent = peso(binPendingNet);
      if (sumBinPending) sumBinPending.textContent = binPendingList.length;

      const tradeRefPendingList = globalWithdrawals.filter((w) => w.wallet_type === 'tradein_ref' && w.status === 'pending');
      const tradeRefPendingNet = tradeRefPendingList.reduce((s, w) => s + (Number(w.net_amount) || 0), 0);
      const sumTradeRefNet = document.getElementById('sumWdTradeRefNet');
      const sumTradeRefPending = document.getElementById('sumWdTradeRefPending');
      if (sumTradeRefNet) sumTradeRefNet.textContent = peso(tradeRefPendingNet);
      if (sumTradeRefPending) sumTradeRefPending.textContent = tradeRefPendingList.length;

      const cyclePendingList = globalWithdrawals.filter((w) => w.wallet_type === 'tradein_cycle' && w.status === 'pending');
      const cyclePendingNet = cyclePendingList.reduce((s, w) => s + (Number(w.net_amount) || 0), 0);
      const sumCycleNet = document.getElementById('sumWdCycleNet');
      const sumCyclePending = document.getElementById('sumWdCyclePending');
      if (sumCycleNet) sumCycleNet.textContent = peso(cyclePendingNet);
      if (sumCyclePending) sumCyclePending.textContent = cyclePendingList.length;

      // 3. Filter by Tab Category
      let list = globalWithdrawals;
      if (wdFilterMode === 'binary_ref' || wdFilterMode === 'binary') {
        list = list.filter((w) => w.wallet_type === 'binary_ref');
      } else if (wdFilterMode === 'tradein_ref') {
        list = list.filter((w) => w.wallet_type === 'tradein_ref');
      } else if (wdFilterMode === 'tradein_cycle') {
        list = list.filter((w) => w.wallet_type === 'tradein_cycle');
      } else if (wdFilterMode === 'pending') {
        list = list.filter((w) => w.status === 'pending');
      } else if (wdFilterMode === 'approved') {
        list = list.filter((w) => w.status === 'approved');
      } else if (wdFilterMode === 'rejected') {
        list = list.filter((w) => w.status === 'rejected');
      }

      // 4. Search Filter
      const searchInput = document.getElementById('wdSearch');
      const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
      if (q) {
        list = list.filter((w) => {
          return (
            String(w.id).includes(q) ||
            String(w.mobile_number || '').toLowerCase().includes(q) ||
            String(w.account_name || '').toLowerCase().includes(q) ||
            String(w.account_number || '').toLowerCase().includes(q) ||
            String(w.payout_method || '').toLowerCase().includes(q) ||
            String(w.wallet_type || '').toLowerCase().includes(q)
          );
        });
      }

      const tbody = document.getElementById('wdTableBody');
      const mobCards = document.getElementById('wdMobileCards');

      if (!list.length) {
        tbody.innerHTML = '<tr><td colspan="9" style="padding:24px;text-align:center" class="muted">No withdrawal requests found matching this filter.</td></tr>';
        if (mobCards) mobCards.innerHTML = '<div style="padding:24px;text-align:center;" class="muted">No withdrawal requests found matching this filter.</div>';
        return;
      }

      tbody.innerHTML = list.map((w) => {
        const badge = w.status === 'pending'
          ? '<span class="badge-tag tag-pending">Pending</span>'
          : w.status === 'approved'
            ? '<span class="badge-tag tag-approved">Approved</span>'
            : '<span class="badge-tag tag-rejected">Rejected</span>';

        const walletBadge = w.wallet_type === 'binary_ref'
          ? '<span class="badge-tag tag-cat-binary">⇄ Binary Referral</span>'
          : w.wallet_type === 'tradein_ref'
            ? '<span class="badge-tag tag-cat-traderef">💛 Trade-In Ref</span>'
            : '<span class="badge-tag tag-cat-cycle">📈 Trade-In Cycle</span>';

        // Payout Method Tag & SVG
        const mKey = String(w.payout_method || '').toLowerCase();
        let methodTagClass = 'badge-tag tag-gcash';
        if (mKey.includes('maya')) methodTagClass = 'badge-tag tag-maya';
        else if (mKey.includes('gotyme')) methodTagClass = 'badge-tag tag-gotyme';
        else if (mKey.includes('maribank')) methodTagClass = 'badge-tag tag-maribank';
        else if (mKey.includes('ub') || mKey.includes('unionbank')) methodTagClass = 'badge-tag tag-ub';

        const iconImg = getPayoutImg(w.payout_method, 28);
        const methodBadge = w.payout_method && w.payout_method !== '—'
          ? '<span class="' + methodTagClass + '" style="font-size:10.5px;padding:2px 8px;">' + esc(w.payout_method) + '</span>'
          : '<span class="badge-tag tag-rejected" style="font-size:10px;">Unbound</span>';

        const accName = w.account_name && w.account_name !== '—' ? esc(w.account_name) : '<span class="muted">—</span>';
        const accNum = w.account_number && w.account_number !== '—' ? esc(w.account_number) : '';
        const copyBtn = accNum
          ? '<button type="button" class="btn-admin-copy" data-copy-acc="' + esc(accNum) + '" title="Copy account number">📋 Copy</button>'
          : '';

        const payoutDetails = '<div style="display:flex;align-items:center;gap:8px;">' +
          iconImg +
          '<div>' +
          '<div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">' +
          methodBadge +
          '<strong style="font-size:12.5px;color:var(--text);">' + accName + '</strong>' +
          '</div>' +
          (accNum ? '<div style="display:flex;align-items:center;gap:6px;"><code style="font-weight:700;font-size:12px;color:var(--jade);background:rgba(46,213,158,0.12);padding:2px 6px;border-radius:4px;">' + accNum + '</code>' + copyBtn + '</div>' : '') +
          '</div>' +
          '</div>';

        const actions = w.status === 'pending'
          ? '<button data-wd-id="' + w.id + '" data-wd-act="approve" class="btn-admin-action btn-admin-approve" style="margin-right:6px">✓ Approve</button>' +
          '<button data-wd-id="' + w.id + '" data-wd-act="reject" class="btn-admin-action btn-admin-reject">✕ Reject</button>'
          : '<span class="tiny muted">' + esc(w.status) + '</span>';

        const releaseBox = `
          <div class="amount-release-box" style="margin:0;padding:6px 10px;">
            <span class="amount-release-val" style="font-size:15px;">${peso(w.net_amount)}</span>
            <span class="amount-release-less">✓ Less Tax (${peso(w.fee)} fee)</span>
          </div>
        `;

        return '<tr>' +
          '<td><strong>#' + w.id + '</strong></td>' +
          '<td><strong>' + esc(w.mobile_number) + '</strong></td>' +
          '<td>' + walletBadge + '</td>' +
          '<td>' + payoutDetails + '</td>' +
          '<td style="font-weight:600">' + peso(w.amount) + '</td>' +
          '<td>' + releaseBox + '</td>' +
          '<td>' + badge + '</td>' +
          '<td class="tiny muted">' + fmtDate(w.created_at) + '</td>' +
          '<td style="text-align:right">' + actions + '</td>' +
          '</tr>';
      }).join('');

      // Mobile Touch-Friendly Cards View (<= 768px)
      if (mobCards) {
        mobCards.innerHTML = list.map((w) => {
          const isPending = w.status === 'pending';
          const badge = isPending
            ? '<span class="badge-tag tag-pending">Pending</span>'
            : w.status === 'approved'
              ? '<span class="badge-tag tag-approved">Approved</span>'
              : '<span class="badge-tag tag-rejected">Rejected</span>';

          const walletBadge = w.wallet_type === 'binary_ref'
            ? '<span class="badge-tag tag-cat-binary">⇄ Binary</span>'
            : w.wallet_type === 'tradein_ref'
              ? '<span class="badge-tag tag-cat-traderef">💛 Trade-In Ref</span>'
              : '<span class="badge-tag tag-cat-cycle">📈 Cycle</span>';

          const mKey = String(w.payout_method || '').toLowerCase();
          let methodTagClass = 'badge-tag tag-gcash';
          if (mKey.includes('maya')) methodTagClass = 'badge-tag tag-maya';
          else if (mKey.includes('gotyme')) methodTagClass = 'badge-tag tag-gotyme';
          else if (mKey.includes('maribank')) methodTagClass = 'badge-tag tag-maribank';
          else if (mKey.includes('ub') || mKey.includes('unionbank')) methodTagClass = 'badge-tag tag-ub';

          const iconImg = getPayoutImg(w.payout_method, 24);
          const methodBadge = w.payout_method && w.payout_method !== '—'
            ? '<span class="' + methodTagClass + '" style="font-size:10px;padding:2px 7px;">' + esc(w.payout_method) + '</span>'
            : '<span class="badge-tag tag-rejected" style="font-size:9.5px;">Unbound</span>';

          const accName = w.account_name && w.account_name !== '—' ? esc(w.account_name) : '—';
          const accNum = w.account_number && w.account_number !== '—' ? esc(w.account_number) : '';
          const copyBtn = accNum
            ? '<button type="button" class="btn-admin-copy" data-copy-acc="' + esc(accNum) + '" style="padding:2px 8px;font-size:11px;">📋 Copy</button>'
            : '';

          return `
            <div class="admin-mob-card ${isPending ? 'pending' : ''}">
              <div class="admin-mob-card-head">
                <div style="display:flex;align-items:center;gap:6px;">
                  <strong style="font-size:13.5px;color:var(--jade);">#${w.id}</strong>
                  ${walletBadge}
                  ${badge}
                </div>
                <span class="tiny muted">${fmtDate(w.created_at)}</span>
              </div>
              <div class="admin-mob-card-grid">
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Member</span>
                  <span class="admin-mob-card-val"><strong>${esc(w.mobile_number)}</strong></span>
                </div>
                <div class="admin-mob-card-field">
                  <span class="admin-mob-card-label">Gross Requested</span>
                  <span class="admin-mob-card-val" style="font-weight:600;">${peso(w.amount)}</span>
                </div>
                <div class="admin-mob-card-field full">
                  <span class="admin-mob-card-label">Payout Account Destination</span>
                  <div class="admin-mob-card-val" style="display:flex;align-items:center;gap:8px;margin-top:2px;">
                    ${iconImg}
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:6px;">
                        ${methodBadge}
                        <strong style="font-size:12.5px;color:var(--text);">${accName}</strong>
                      </div>
                      ${accNum ? `<div style="display:flex;align-items:center;gap:6px;margin-top:2px;"><code style="font-weight:700;font-size:12px;color:var(--jade);background:rgba(46,213,158,0.12);padding:2px 6px;border-radius:4px;">${accNum}</code>${copyBtn}</div>` : ''}
                    </div>
                  </div>
                </div>
                <div class="admin-mob-card-field full">
                  <div class="amount-release-box">
                    <div style="display:flex;justify-content:space-between;align-items:baseline;">
                      <span style="font-size:11px;font-weight:700;color:var(--jade);text-transform:uppercase;letter-spacing:0.04em;">Amount to Release (Net)</span>
                      <span class="amount-release-val">${peso(w.net_amount)}</span>
                    </div>
                    <span class="amount-release-less">✓ Already less ${peso(w.fee)} processing fee / tax</span>
                  </div>
                </div>
              </div>
              ${isPending ? `
                <div class="admin-mob-card-actions">
                  <button type="button" data-wd-id="${w.id}" data-wd-act="approve" class="btn-admin-action btn-admin-approve">✓ Approve Cashout</button>
                  <button type="button" data-wd-id="${w.id}" data-wd-act="reject" class="btn-admin-action btn-admin-reject">✕ Reject</button>
                </div>
              ` : ''}
            </div>
          `;
        }).join('');
      }

      // Copy account number event listeners (desktop, mobile & action center)
      document.querySelectorAll('button[data-copy-acc]').forEach((btn) => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const txt = btn.dataset.copyAcc;
          navigator.clipboard.writeText(txt).then(() => {
            const orig = btn.innerHTML;
            btn.innerHTML = '✓ Copied!';
            btn.style.borderColor = 'var(--jade)';
            btn.style.color = 'var(--jade)';
            setTimeout(() => {
              btn.innerHTML = orig;
              btn.style.borderColor = '';
              btn.style.color = '';
            }, 2000);
          }).catch(() => {
            prompt('Copy Account Number:', txt);
          });
        };
      });

      // Review actions (desktop & mobile)
      document.querySelectorAll('button[data-wd-id]').forEach((btn) => {
        btn.onclick = () => {
          const id = btn.dataset.wdId;
          const act = btn.dataset.wdAct;
          const req = globalWithdrawals.find(x => String(x.id) === String(id)) || {};
          const isApprove = act === 'approve';

          const releasePill = `
            <div style="background:rgba(46,213,158,0.12);border:1.5px solid rgba(46,213,158,0.35);border-radius:8px;padding:6px 12px;display:inline-block;">
              <span style="font-size:15px;font-weight:800;color:var(--jade);">${peso(req.net_amount || 0)}</span>
              <span style="font-size:11px;color:var(--muted);font-weight:700;display:block;">(Already less tax/fee of ${peso(req.fee || 0)})</span>
            </div>
          `;

          showAdminConfirm({
            title: isApprove ? 'Approve Cashout & Release Funds' : 'Reject Cashout Request',
            subtitle: isApprove ? 'Confirm release of net payout to the destination account.' : 'Reject cashout and refund balance to member.',
            icon: isApprove ? '💸' : '✕',
            details: [
              { label: 'Request ID', val: '#' + id },
              { label: 'Member', val: req.mobile_number || '—' },
              { label: 'Wallet Type', val: (req.wallet_type || '—').toUpperCase() },
              { label: 'Payout Method', val: req.payout_method || '—' },
              { label: 'Account Name', val: req.account_name || '—' },
              { label: 'Account Number', val: req.account_number || '—' },
              { label: 'Gross Requested', val: peso(req.amount || 0) },
              { label: 'Processing Fee (Tax)', val: '-' + peso(req.fee || 0) },
              { label: 'AMOUNT TO RELEASE (NET)', html: releasePill, highlight: true }
            ],
            confirmText: isApprove ? 'Confirm Approval & Release ➔' : 'Confirm Rejection',
            confirmClass: isApprove ? 'btn-mint' : 'btn-danger',
            onConfirm: async () => {
              try {
                await api('/api/admin/withdrawals/' + id + '/review', {
                  method: 'POST',
                  body: JSON.stringify({ action: act }),
                });
                flash('Withdrawal #' + id + ' ' + act + 'd successfully.', true);
                refreshAll();
              } catch (e) { flash(e.message); }
            }
          });
        };
      });
    }

    let currentAdminUser = null;

    function updateAdminRefLinks(u) {
      if (!u) return;
      const sponsor = u.mobile_number || 'Toshi';
      const refUrl = window.location.origin + '/register.html?sponsor=' + encodeURIComponent(sponsor);
      const sideInput = document.getElementById('adminSideRefLink');
      const homeInput = document.getElementById('adminHomeRefLink');
      const sponsorBadge = document.getElementById('adminSponsorLabel');
      if (sideInput) sideInput.value = refUrl;
      if (homeInput) homeInput.value = refUrl;
      if (sponsorBadge) sponsorBadge.textContent = sponsor;
    }

    async function refreshAll() {
      try {
        const [overview, usersData, tradeinData, withdrawalsData, codesData, meData, mopData, loadWalletData] = await Promise.all([
          api('/api/admin/overview'),
          api('/api/admin/users'),
          api('/api/admin/tradein'),
          api('/api/admin/withdrawals'),
          api('/api/admin/codes'),
          api('/api/me').catch(() => null),
          api('/api/admin/mop').catch(() => ({ mop: [] })),
          api('/api/admin/load-wallet').catch(() => ({ requests: [] })),
        ]);

        globalUsers = usersData.users || [];
        globalTradein = tradeinData.packages || [];
        globalWithdrawals = withdrawalsData.withdrawals || [];
        globalCodes = codesData.codes || [];
        globalMops = mopData.mop || [];
        globalLoadWallets = loadWalletData.requests || [];

        if (meData && meData.user) {
          currentAdminUser = meData.user;
        } else if (!currentAdminUser && globalUsers.length) {
          currentAdminUser = globalUsers.find((u) => u.role === 'admin') || globalUsers[0];
        }
        updateAdminRefLinks(currentAdminUser);

        renderHomeKPIs(overview);
        renderUsers();
        renderCodes();
        renderTradein();
        renderWithdrawals();
        updateMopBadgesAndHomeSummary();
        renderAdminMops();
        renderAdminLoadWallet();
        updateLoadWalletBadges();
      } catch (err) {
        flash(err.message);
      }
    }

    const doSignOut = () => {
      localStorage.removeItem('it_token');
      location.href = '/login.html';
    };
    document.getElementById('logoutTopBtn').onclick = doSignOut;
    document.getElementById('logoutSideBtn').onclick = doSignOut;

    document.getElementById('btnRandomizeSlots').onclick = randomizeSlots;

    document.querySelectorAll('[data-mint-count]').forEach(btn => {
      btn.onclick = async () => {
        const count = Number(btn.dataset.mintCount) || 1;
        try {
          const data = await api('/api/admin/codes', {
            method: 'POST',
            body: JSON.stringify({ count }),
          });
          flash('Minted ' + data.codes.length + ' new 8-character code(s): ' + data.codes.join(', '), true);
          refreshAll();
        } catch (e) { flash(e.message); }
      };
    });

    document.getElementById('btnMintCustom').onclick = async () => {
      const s1 = document.getElementById('codeSlot1').value.trim();
      const s2 = document.getElementById('codeSlot2').value.trim();
      const s3 = document.getElementById('codeSlot3').value.trim();
      const customCodes = [s1, s2, s3].filter(Boolean);

      try {
        const payload = customCodes.length > 0 ? { codes: customCodes } : { count: 3 };
        const data = await api('/api/admin/codes', {
          method: 'POST',
          body: JSON.stringify(payload),
        });
        flash('Successfully generated ' + data.codes.length + ' code(s): ' + data.codes.join(', '), true);
        document.getElementById('codeSlot1').value = '';
        document.getElementById('codeSlot2').value = '';
        document.getElementById('codeSlot3').value = '';
        refreshAll();
      } catch (e) { flash(e.message); }
    };

    document.getElementById('btnSendCodes').onclick = async () => {
      const mobile = document.getElementById('sendTargetMobile').value.trim();
      const qty = Number(document.getElementById('sendQty').value) || 1;
      if (!mobile) return flash('Please enter a target member mobile / username.');

      try {
        const data = await api('/api/admin/codes/send', {
          method: 'POST',
          body: JSON.stringify({ mobile_number: mobile, qty }),
        });
        flash('Sent ' + data.codes.length + ' code(s) to member ' + data.mobile + '.', true);
        document.getElementById('sendTargetMobile').value = '';
        document.getElementById('sendQty').value = 1;
        refreshAll();
      } catch (e) { flash(e.message); }
    };

    const togglePayoutsAction = async () => {
      try {
        const data = await api('/api/admin/settings/payouts', {
          method: 'POST',
          body: JSON.stringify({ enabled: !payoutsEnabled }),
        });
        flash('Weekly payouts ' + (data.weekly_payout_enabled ? 'opened' : 'closed') + '.', true);
        refreshAll();
      } catch (e) { flash(e.message); }
    };
    document.getElementById('togglePayoutsTopBtn').onclick = togglePayoutsAction;

    const processYieldsHandler = async () => {
      try {
        const data = await api('/api/admin/process-yields', { method: 'POST', body: '{}' });
        flash('Yields processed: ' + data.updated + ' of ' + data.processed + ' active package(s) updated.', true);
        refreshAll();
      } catch (e) { flash(e.message); }
    };
    document.getElementById('btnProcessTradeinYields').onclick = processYieldsHandler;

    // Member Directory Filters & Search
    document.querySelectorAll('[data-userfilter]').forEach((btn) => {
      btn.onclick = () => {
        document.querySelectorAll('[data-userfilter]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        userFilterMode = btn.dataset.userfilter;
        memberCurrentPage = 1;
        renderUsers();
      };
    });

    if (document.getElementById('userSearch')) {
      document.getElementById('userSearch').oninput = () => {
        memberCurrentPage = 1;
        renderUsers();
      };
    }

    // Member Directory Toggle & Pagination Listeners
    const btnToggleMember = document.getElementById('btnToggleMemberList');
    const wrapMemberContent = document.getElementById('memberInventoryContentWrap');
    if (btnToggleMember && wrapMemberContent) {
      btnToggleMember.onclick = () => {
        isMemberListMinimized = !isMemberListMinimized;
        wrapMemberContent.style.display = isMemberListMinimized ? 'none' : 'block';
        document.getElementById('toggleMemberListIcon').textContent = isMemberListMinimized ? '▸' : '▾';
        document.getElementById('toggleMemberListText').textContent = isMemberListMinimized ? 'Show List' : 'Hide List';
        btnToggleMember.className = isMemberListMinimized ? 'btn btn-sm btn-mint' : 'btn btn-sm btn-ghost';
      };
    }

    const selMemberSize = document.getElementById('memberPageSizeSelect');
    if (selMemberSize) {
      selMemberSize.onchange = () => {
        memberPageSize = selMemberSize.value === 'all' ? 'all' : Number(selMemberSize.value);
        memberCurrentPage = 1;
        renderUsers();
      };
    }

    const btnPrevMember = document.getElementById('btnMemberPrevPage');
    if (btnPrevMember) {
      btnPrevMember.onclick = () => {
        if (memberCurrentPage > 1) {
          memberCurrentPage--;
          renderUsers();
        }
      };
    }

    const btnNextMember = document.getElementById('btnMemberNextPage');
    if (btnNextMember) {
      btnNextMember.onclick = () => {
        const totalItems = globalUsers.length;
        const effSize = memberPageSize === 'all' ? totalItems : (Number(memberPageSize) || 10);
        const totalPages = Math.max(1, Math.ceil(totalItems / effSize));
        if (memberCurrentPage < totalPages) {
          memberCurrentPage++;
          renderUsers();
        }
      };
    }

    document.querySelectorAll('[data-codefilter]').forEach((btn) => {
      btn.onclick = () => {
        document.querySelectorAll('[data-codefilter]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        codeFilterMode = btn.dataset.codefilter;
        codeCurrentPage = 1;
        renderCodes();
      };
    });

    // Code Vault Toggle & Pagination Listeners
    const btnToggleCode = document.getElementById('btnToggleCodeList');
    const wrapCodeContent = document.getElementById('codeInventoryContentWrap');
    if (btnToggleCode && wrapCodeContent) {
      btnToggleCode.onclick = () => {
        isCodeListMinimized = !isCodeListMinimized;
        wrapCodeContent.style.display = isCodeListMinimized ? 'none' : 'block';
        document.getElementById('toggleCodeListIcon').textContent = isCodeListMinimized ? '▸' : '▾';
        document.getElementById('toggleCodeListText').textContent = isCodeListMinimized ? 'Show List' : 'Hide List';
        btnToggleCode.className = isCodeListMinimized ? 'btn btn-sm btn-mint' : 'btn btn-sm btn-ghost';
      };
    }

    const selCodeSize = document.getElementById('codePageSizeSelect');
    if (selCodeSize) {
      selCodeSize.onchange = () => {
        codePageSize = selCodeSize.value === 'all' ? 'all' : Number(selCodeSize.value);
        codeCurrentPage = 1;
        renderCodes();
      };
    }

    const btnPrevCode = document.getElementById('btnCodePrevPage');
    if (btnPrevCode) {
      btnPrevCode.onclick = () => {
        if (codeCurrentPage > 1) {
          codeCurrentPage--;
          renderCodes();
        }
      };
    }

    const btnNextCode = document.getElementById('btnCodeNextPage');
    if (btnNextCode) {
      btnNextCode.onclick = () => {
        const totalItems = globalCodes.length;
        const effSize = codePageSize === 'all' ? totalItems : (Number(codePageSize) || 10);
        const totalPages = Math.max(1, Math.ceil(totalItems / effSize));
        if (codeCurrentPage < totalPages) {
          codeCurrentPage++;
          renderCodes();
        }
      };
    }

    if (document.getElementById('codeSearch')) {
      document.getElementById('codeSearch').oninput = () => {
        codeCurrentPage = 1;
        renderCodes();
      };
    }

    document.querySelectorAll('[data-wdfilter]').forEach((btn) => {
      btn.onclick = () => {
        document.querySelectorAll('[data-wdfilter]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        wdFilterMode = btn.dataset.wdfilter;
        renderWithdrawals();
      };
    });
    document.querySelectorAll('[data-tradeinfilter]').forEach((btn) => {
      btn.onclick = () => {
        document.querySelectorAll('[data-tradeinfilter]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        tradeinFilterMode = btn.dataset.tradeinfilter;
        renderTradein();
      };
    });
    if (document.getElementById('tradeinSearch')) {
      document.getElementById('tradeinSearch').oninput = renderTradein;
    }
    if (document.getElementById('wdSearch')) {
      document.getElementById('wdSearch').oninput = renderWithdrawals;
    }
    if (document.getElementById('codeSearch')) {
      document.getElementById('codeSearch').oninput = renderCodes;
    }

    const btnBatchCopy = document.getElementById('btnCopyAllAvailableCodes');
    if (btnBatchCopy) {
      btnBatchCopy.onclick = async () => {
        const avail = globalCodes.filter((c) => c.status === 'available');
        if (!avail.length) return flash('No available / unused codes to copy.');
        const today = new Date().toLocaleDateString();
        const header = `=== INFINITE TRADING ACTIVATION CODES (${avail.length} AVAILABLE) ===\nGenerated: ${today}\nEntry: ₱399.00\n\n`;
        const body = avail.map((c, idx) => `${idx + 1}. ${c.code}`).join('\n');
        const text = header + body;
        try {
          await navigator.clipboard.writeText(text);
          flash(`Copied ${avail.length} available code(s) to clipboard! Ready to send to seller.`, true);
        } catch {
          prompt('Copy Available Codes:', text);
        }
      };
    }

    function wireRefCopyBtn(btnId, inputId, label) {
      const btn = document.getElementById(btnId);
      if (!btn) return;
      btn.onclick = async () => {
        const input = document.getElementById(inputId);
        if (!input || !input.value) return;
        try {
          await navigator.clipboard.writeText(input.value);
          flash(label + ' copied to clipboard!', true);
          const orig = btn.innerHTML;
          btn.innerHTML = '✓ Copied!';
          btn.style.color = 'var(--jade)';
          setTimeout(() => {
            btn.innerHTML = orig;
            btn.style.color = '';
          }, 2000);
        } catch {
          prompt('Copy Referral Link:', input.value);
        }
      };
    }

    wireRefCopyBtn('copyAdminSideRef', 'adminSideRefLink', 'Admin referral link');
    wireRefCopyBtn('copyAdminHomeRef', 'adminHomeRefLink', 'Admin master referral link');

    const btnTemplateCopy = document.getElementById('btnCopyCodeInviteTemplate');
    if (btnTemplateCopy) {
      btnTemplateCopy.onclick = async () => {
        const avail = globalCodes.find((c) => c.status === 'available');
        const sampleCode = avail ? avail.code : 'XXXXXXXX';
        const sponsorMobile = (currentAdminUser && currentAdminUser.mobile_number) || 'Toshi';
        const regUrl = `${window.location.origin}/register.html?sponsor=${encodeURIComponent(sponsorMobile)}`;
        const msg = `🌟 INFINITE TRADING PLATFORM 🌟\nHere is your ₱399 Activation Code: ${sampleCode}\n\n1. Sign up: ${regUrl}\n2. Log in and paste your 8-character activation code.\n3. Choose your Binary Leg (LEFT or RIGHT) to unlock direct & pairing commissions!\n\nWelcome to the network!`;
        try {
          await navigator.clipboard.writeText(msg);
          flash('Promo / Invitation template copied to clipboard! (Sample Code: ' + sampleCode + ')', true);
        } catch {
          prompt('Copy Template:', msg);
        }
      };
    }

    restoreInitialAdminView();
    randomizeSlots();
    refreshAll();

    // Auto-poll every 10 seconds for real-time live data
    setInterval(() => {
      if (document.visibilityState === 'visible') {
        refreshAll();
      }
    }, 10000);
  </script>
</body>

</html>