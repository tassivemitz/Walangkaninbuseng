            <div class="ctrl-tabs" id="mopFilterTabs">
              <button class="ctrl-tab active" data-mopfilter="all">All Channels (<span id="countMopAll">0</span>)</button>
              <button class="ctrl-tab" data-mopfilter="active">Active (<span id="countMopActive">0</span>)</button>
              <button class="ctrl-tab" data-mopfilter="inactive">Disabled (<span id="countMopInactive">0</span>)</button>
            </div>
